{"entity": {"eid": 2792, "ent_code": null, "name": "龙", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:52"}, "aliases": [], "claims": [{"cid": 10464, "predicate": "is-a", "object_text": "比现在更为高大、更加高傲者", "object_id": null, "quote": "在那时，大地上还没有人类的诸部族，龙也远比现在更为高大，更加高傲。", "source": "玛阿威与幻写灵·Book938", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 10465, "predicate": "part-of", "object_text": "不同的部族（与现在的人类相似的分族结构）", "object_id": null, "quote": "就像是现在的人类那样，龙们自己也分成了不同的部族", "source": "玛阿威与幻写灵·Book938", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "从属（组织）"}, {"cid": 10469, "predicate": "opposes", "object_text": "高天的使者（蔑视其余生灵）", "object_id": null, "quote": "高傲的龙向来蔑视其余的生灵，无论是来自高天的使者，还是渺小的凡人，", "source": "玛阿威与幻写灵·Book938", "confidence": "明文", "narrator": null, "review_status": "待仲裁", "predicate_zh": "对抗"}, {"cid": 10494, "predicate": "opposes", "object_text": "天空（同天空的争战）", "object_id": null, "quote": "我本以为同天空的争战已令我的同族心肠刚硬，", "source": "玛阿威与幻写灵·Book939", "confidence": "明文", "narrator": null, "review_status": "待仲裁", "predicate_zh": "对抗"}, {"cid": 14630, "predicate": "is-a", "object_text": "生来对上位者屈从、对下位者施令者", "object_id": null, "quote": "龙生来就会对上位者屈从，对下位者施令", "source": "希泊巴计划——龙裔摄政的封闭秩序构想·Book1075", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}], "corpus_caveats": []}
{"entity": {"eid": 169, "ent_code": null, "name": "三月女神", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:43"}, "aliases": [{"alias": "具有三月权能并活着的月神", "lang": "zh", "confidence": "明文", "evidence": "若我们再次相见·quest 40244·「木偶」"}], "claims": [{"cid": 422, "predicate": "commands", "object_text": "天理到来前的世界法则之力（分管且约定不可聚集于一身）", "object_id": null, "quote": null, "source": "终北的夜行诗·talk 6026·艾莉丝/尼可", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "统辖"}, {"cid": 423, "predicate": "dies-in", "object_text": "葬火之战后天理的改造（失去存在于提瓦特的「理」，力量因排斥流失而逝）", "object_id": null, "quote": null, "source": "终北的夜行诗·talk 6026·艾莉丝", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "死于"}, {"cid": 782, "predicate": "aka", "object_text": "具有三月权能并活着的月神（现存数量：一个）", "object_id": null, "quote": null, "source": "若我们再次相见·quest 40244·「木偶」", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "别称"}, {"cid": 4446, "predicate": "is-a", "object_text": "彼此关系亲切者（偷懒央人顶替、以妆匣首饰补偿）", "object_id": null, "quote": "要是有人偷懒不想当班，就会央求另外一个人顶替，在替班之后，再买点妆匣首饰做补偿就好。", "source": "兹白（驹隙隐泉）·语音·关于「三月女神」 197070", "confidence": "明文·转述", "narrator": "兹白", "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 4447, "predicate": "causes", "object_text": "三月连珠之乱（弄错时刻，三人同时凌空）", "object_id": null, "quote": "例如有一年三月连珠，就是因为她们弄错了时刻，本应独月当班的那一天，三人却同时凌空", "source": "兹白（驹隙隐泉）·语音·关于「三月女神」 197070", "confidence": "明文·转述", "narrator": "兹白", "review_status": "已复核·通过", "predicate_zh": "引发"}, {"cid": 4448, "predicate": "entrusts", "object_text": "兹白（想办法告诉凡人三月凌空不预示灾殃与王权更替）", "object_id": null, "quote": "那件事之后，她们还托我想想办法，告诉人们三月凌空不代表天将降大灾，或者预示着王权更替", "source": "兹白（驹隙隐泉）·语音·关于「三月女神」 197070", "confidence": "明文·转述", "narrator": "兹白", "review_status": "已复核·通过", "predicate_zh": "自定义关系"}, {"cid": 7832, "predicate": "is-a", "object_text": "受命于尼伯龙根的代行者（葬火之战前曾与天空岛的法则和谐共处）", "object_id": null, "quote": "在葬火之战还未发生前，受命于尼伯龙根的三月女神曾与天空岛的法则和谐共处过一段时间。", "source": "菈乌玛·角色故事2 hash 433064256", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 7834, "predicate": "narrates", "object_text": "最终未能置身事外（上位者的争斗总是会波及一部分下属）", "object_id": null, "quote": "上位者的争斗总是会波及一部分下属，这也是没有办法的事情。", "source": "菈乌玛·角色故事2 hash 433064256", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 11548, "predicate": "part-of", "object_text": "尼伯龙根（星球意志的代行）", "object_id": null, "quote": "星球的影子，为代替龙王尼伯龙根掌握权能管理世界而出生", "source": "07_尼伯龙根·arch_1608", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "从属（组织）"}, {"cid": 11549, "predicate": "is-a", "object_text": "「尼伯龙根意志的延长，威望的具现」", "object_id": null, "quote": "尼伯龙根意志的延长，威望的具现", "source": "07_尼伯龙根·arch_1608", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 11557, "predicate": "narrates", "object_text": "葬火之战前受命于尼伯龙根并与天空岛法则和谐共处", "object_id": null, "quote": null, "source": "07_尼伯龙根·FetterStory#824", "confidence": "明文·转述", "narrator": "菈乌玛·FetterStory#824", "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 11564, "predicate": "narrates", "object_text": "始终没有等来她们的旧主", "object_id": null, "quote": "月的三姐妹始终没有等来她们的旧主", "source": "08_始源之龙·Relic15043_5", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 11581, "predicate": "is-a", "object_text": "星球的影子／星球意志的代行", "object_id": null, "quote": null, "source": "09_三月女神·FetterStory#824", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 11582, "predicate": "part-of", "object_text": "尼伯龙根（受命于其、与其意志延长）", "object_id": null, "quote": null, "source": "09_三月女神·FetterStory#824", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "从属（组织）"}, {"cid": 11583, "predicate": "witnesses", "object_text": "「三月与晨星
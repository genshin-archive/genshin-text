{"entity": {"eid": 2725, "ent_code": null, "name": "芙莉", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:52"}, "aliases": [], "claims": [{"cid": 10277, "predicate": "travels-to", "object_text": "城里（风和日丽的午后只身入城）", "object_id": null, "quote": "平民少女是在一个风和日丽的午后，来到城里的。", "source": "犬又二分之一·Book134", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "抵达"}, {"cid": 10278, "predicate": "is-a", "object_text": "穿越魔物肆虐郊外而来的独行者", "object_id": null, "quote": "很难想象这样一位少女是怎么只身一人从魔物肆虐的郊外，跋山涉水来到了城里。", "source": "犬又二分之一·Book134", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 10280, "predicate": "is-a", "object_text": "自称的游学者", "object_id": null, "quote": "于是这位自称芙莉的游学者顺利在城里安定了下来。", "source": "犬又二分之一·Book134", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 10281, "predicate": "causes", "object_text": "与她说过话者夜间的好梦", "object_id": null, "quote": "据说只要和芙莉说上几句话，晚上就能做个好梦。", "source": "犬又二分之一·Book134", "confidence": "明文·转述", "narrator": "坊间传闻，文内标「据说」", "review_status": "已复核·通过", "predicate_zh": "引发"}, {"cid": 10283, "predicate": "knows-of", "object_text": "事态已超出其预判（「已经变成这样子了」）", "object_id": null, "quote": "呀，本来以为是很简单的事情呢。没想到已经变成这样子了……", "source": "犬又二分之一·Book134", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "知晓"}, {"cid": 10284, "predicate": "wields", "object_text": "白骨森森的蛇镯臂环", "object_id": null, "quote": "露出了一条白骨森森的蛇镯臂环。", "source": "犬又二分之一·Book135", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "持用"}, {"cid": 10286, "predicate": "knows-of", "object_text": "陌生气息侵入房间（一瞬间即察觉）", "object_id": null, "quote": "几乎是在陌生气息侵入房间的那一瞬间，芙莉就察觉到了。", "source": "犬又二分之一·Book135", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "知晓"}, {"cid": 10288, "predicate": "imposes", "object_text": "使荻特里希意识模糊的催眠（令其饮下杯中水）", "object_id": null, "quote": "把这杯子里的水喝掉。", "source": "犬又二分之一·Book135", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "自定义关系"}, {"cid": 10289, "predicate": "steals", "object_text": "荻特里希腰间的佩剑", "object_id": null, "quote": "芙莉蹲下来，取走了荻特里希腰间的佩剑。", "source": "犬又二分之一·Book136", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "窃取"}, {"cid": 10291, "predicate": "wields", "object_text": "永夜之眼（投入蛇口使之活化）", "object_id": null, "quote": "专门把永夜之眼送上门来，谢啦。", "source": "犬又二分之一·Book136", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "持用"}], "corpus_caveats": []}
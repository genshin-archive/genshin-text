{"entity": {"eid": 3313, "ent_code": null, "name": "权兵卫", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:54"}, "aliases": [], "claims": [{"cid": 11440, "predicate": "is-a", "object_text": "鹮巷长居的唯一凡人（七十六岁）", "object_id": null, "quote": "权兵卫今年七十六岁，是鹮巷长居的唯一凡人。", "source": "鹮巷物语·Book211", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 11441, "predicate": "is-a", "object_text": "木匣的制作者（习自海祇岛渔民的手艺）", "object_id": null, "quote": "我手中的匣子便是他的作品，顺滑的黑漆面镶嵌着多彩的珠母，是从海祇岛的渔民那里学到的手艺。", "source": "鹮巷物语·Book211", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 11442, "predicate": "is-a", "object_text": "雨女的至交好友（据其自述）", "object_id": null, "quote": "据权兵卫所言，与坊间传说不同，他与山林中漫行的雨女曾是至交好友。", "source": "鹮巷物语·Book211", "confidence": "明文·转述", "narrator": "权兵卫", "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 11443, "predicate": "is-a", "object_text": "为家乡求雨而寻雨女帮助的少年", "object_id": null, "quote": "是为了给家乡干旱的田地带来雨水的滋润，因而听从村老的说辞，走向山林寻求雨女的帮助。", "source": "鹮巷物语·Book211", "confidence": "明文·转述", "narrator": "权兵卫", "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 11444, "predicate": "betrays", "object_text": "属于山海的生灵（以欺瞒求雨）", "object_id": null, "quote": "年轻的权兵卫犯下了难以启齿的错误，欺骗了属于山海的生灵。", "source": "鹮巷物语·Book211", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "背叛"}, {"cid": 11445, "predicate": "is-a", "object_text": "未收下木匣的谢罪者", "object_id": null, "quote": "衰老的凡人低下头，却并没有收下木匣。", "source": "鹮巷物语·Book211", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}], "corpus_caveats": []}
{"entity": {"eid": 9, "ent_code": null, "name": "杜拉夫", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:42"}, "aliases": [], "claims": [{"cid": 15, "predicate": "entrusts", "object_text": "寻回独自冲往后山看陨石的艾伦", "object_id": null, "quote": "陨石的危险性你们也看到了，我担心他出什么意外，想请各位跟我走一趟，把他接回来。", "source": "未知之星·quest 41111·杜拉夫", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "自定义关系"}, {"cid": 2041, "predicate": "narrates", "object_text": "清泉镇族谱中记有奥拉夫之名", "object_id": null, "quote": "啊？这个名字，我在族谱上见过！", "source": "蒙德食遇之旅·talk 1100501", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 2048, "predicate": "entrusts", "object_text": "借香菱厨艺推广清泉镇肉产", "object_id": null, "quote": "像香菱这样一流的大厨，用一流的肉做出一流的料理，我们清泉镇的肉就能声名远扬了。", "source": "蒙德食遇之旅·talk 1100102", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "自定义关系"}, {"cid": 2049, "predicate": "participates-in", "object_text": "担任料理对决评委", "object_id": null, "quote": "那现在开始比赛，我就来当这个评委了。", "source": "蒙德食遇之旅·talk 1100502", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "参与"}, {"cid": 2050, "predicate": "narrates", "object_text": "香菱料理更胜一筹", "object_id": null, "quote": "香菱的料理更胜一筹。", "source": "蒙德食遇之旅·talk 1100518", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 2051, "predicate": "narrates", "object_text": "古野猪价值可顶镇子数年狩猎收入", "object_id": null, "quote": "要是拿去卖的话，能顶得上镇子几年狩猎的收入了吧！", "source": "蒙德食遇之旅·talk 1100518", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 2052, "predicate": "narrates", "object_text": "古野猪价值数十万摩拉（成就口径）", "object_id": null, "quote": "一口吃掉了几十万摩拉！", "source": "蒙德食遇之旅·成就 81044", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 8374, "predicate": "kin-of", "object_text": "迪奥娜（父亲，整个清泉镇最好的猎手与所有猎人当之无愧的头领）", "object_id": null, "quote": "迪奥娜的父亲，杜拉夫，是整个清泉镇最好的猎手。", "source": "迪奥娜·角色故事2·hash 3717550112", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "血亲"}, {"cid": 8375, "predicate": "is-a", "object_text": "迪奥娜近乎完美的偶像（童年一直闪耀着光辉，也是她心中的憧憬）", "object_id": null, "quote": "对迪奥娜来说，父亲在她的童年里一直闪耀着光辉，也是她心中的憧憬，是近乎完美的偶像。", "source": "迪奥娜·角色故事2·hash 3717550112", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 8384, "predicate": "wields", "object_text": "狩猎方面卓越的天资（与迪奥娜同得益于这古老的血统）", "object_id": null, "quote": "除了外观上与猫相近之外，迪奥娜和她的父亲杜拉夫在狩猎方面卓越的天资，也是得益于这古老的血统。", "source": "迪奥娜·角色故事3·hash 518524272", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "持用"}, {"cid": 8411, "predicate": "is-a", "object_text": "无神之眼者（迪奥娜遗传说的直接反证）", "object_id": null, "quote": "唔？杜拉夫先生根本没有神之眼？", "source": "迪奥娜·语音·关于「神之眼」·遗传·hash 3822620039", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}], "corpus_caveats": []}
{"entity": {"eid": 3150, "ent_code": null, "name": "狐母", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:53"}, "aliases": [], "claims": [{"cid": 11082, "predicate": "is-a", "object_text": "白狐化形的美人（知恩图报）", "object_id": null, "quote": "我们狐狸是知恩图报的。我会教给你我们的变化戏法，帮您实现愿望。", "source": "蒲公英海的狐狸·Book157", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 11083, "predicate": "narrates", "object_text": "祈愿「让我们狐狸都变成人吧」", "object_id": null, "quote": "让我们狐狸都变成人吧，风神啊。这样，我们就再也不用害怕人的弓箭和猎刀了。", "source": "蒲公英海的狐狸·Book14", "confidence": "明文·转述", "narrator": "狐母", "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 11084, "predicate": "is-a", "object_text": "巨人（绕行施法时身形愈发高大）", "object_id": null, "quote": "当我感到不对劲时，才发现，她已经变成了一个巨人。", "source": "蒲公英海的狐狸·Book13", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 11090, "predicate": "narrates", "object_text": "「老师和学生是不同的」", "object_id": null, "quote": "妈妈说，您是老师。老师和学生是不同的——但这样说的话，又太对不起您了。", "source": "蒲公英海的狐狸·Book11", "confidence": "明文·转述", "narrator": "小狐狸", "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 11093, "predicate": "grants", "object_text": "猎人狐狸的变化戏法", "object_id": null, "quote": "届时作为报答，我会将狐狸的戏法教给您。", "source": "蒲公英海的狐狸·Book156", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "授予"}], "corpus_caveats": []}
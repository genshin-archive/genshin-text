{"entity": {"eid": 1435, "ent_code": null, "name": "丑角", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:48"}, "aliases": [{"alias": "最初的愚者", "lang": "zh", "confidence": "明文", "evidence": "17_丑角·Relic15018_2"}, {"alias": "皮耶罗、艾弗提尔维特", "lang": "zh", "confidence": "明文", "evidence": "17_丑角·src_1703"}], "claims": [{"cid": 4844, "predicate": "is-a", "object_text": "佩戴嗤笑世界的面具、自己却从不微笑者", "object_id": null, "quote": "他佩戴嗤笑世界的面具，自己却从不微笑。", "source": "哥伦比娅（空月归乡）·语音 196910", "confidence": "明文·转述", "narrator": "哥伦比娅", "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 8240, "predicate": "grants", "object_text": "邪眼予达达利亚（于冰之女皇面前亲手佩上徽章）", "object_id": null, "quote": "在冷酷庄严的神明「冰之女皇」面前，愚人众最初的执行官「丑角」亲手为他佩上这枚徽章。", "source": "达达利亚·邪眼·hash 289022056", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "授予"}, {"cid": 8241, "predicate": "leader-of", "object_text": "愚人众执行官们（最初的执行官，只会在大场面出现）", "object_id": null, "quote": "他是愚人众最初的执行官，也是今日执行官们的领袖，只会在大场面出现。", "source": "达达利亚·语音·关于「丑角」·hash 539010143", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "领袖"}, {"cid": 8706, "predicate": "narrates", "object_text": "曾侍奉地下古国的末代王朝「黑日」，在其之前的王朝名叫「赤月」", "object_id": null, "quote": "我曾经侍奉地下古国的末代王朝，它的名字叫做『黑日』，而在它之前的王朝名叫『赤月』。", "source": "阿蕾奇诺·角色故事5 hash 4241325360", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 8708, "predicate": "narrates", "object_text": "五问答之答：「『不成熟之人会为了理想去死，成熟之人为了达成某事愿意苟活。』」", "object_id": null, "quote": "『不成熟之人会为了理想去死，成熟之人为了达成某事愿意苟活。』", "source": "阿蕾奇诺·角色故事5 hash 4241325360", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 8710, "predicate": "narrates", "object_text": "临别赠言：「比起世界是何模样，你该思考它应去往何方了。」", "object_id": null, "quote": "比起世界是何模样，你该思考它应去往何方了。", "source": "阿蕾奇诺·角色故事5 hash 4241325360", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 11748, "predicate": "aka", "object_text": "皮耶罗、艾弗提尔维特（本名，待核）", "object_id": null, "quote": null, "source": "17_丑角·src_1703", "confidence": "明文·转述", "narrator": "src_1703 记忆说话人标签", "review_status": "已复核·通过", "predicate_zh": "别称"}, {"cid": 11749, "predicate": "member-of", "object_text": "愚人众（统括官）", "object_id": null, "quote": null, "source": "17_丑角·NpcFirstMet 1044", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "成员"}, {"cid": 11750, "predicate": "aka", "object_text": "最初的愚者", "object_id": null, "quote": null, "source": "17_丑角·Relic15018_2", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "别称"}, {"cid": 11751, "predicate": "is-a", "object_text": "坎瑞亚的宫廷法师", "object_id": null, "quote": null, "source": "17_丑角·TextMap 642466", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 11752, "predicate": "part-of", "object_text": "女皇安娜丝塔夏（效忠对象）", "object_id": null, "quote": "为理解我的伤痛的「陛下」效忠", "source": "17_丑角·Relic15018_3", "confidence": "明文·转述", "narrator": "丑角", "review_status": "待仲裁", "predicate_zh": "从属（组织）"}, {"cid": 11753, "predicate": "witnesses", "object_text": "与旅行者血亲（荧）同处坎瑞亚的时期", "object_id": null, "quote": "…恰恰相反，当时我一直漠视你的存在，心思全都在与「贤者」海洛塔帝的斗争上…", "source": "17_丑角·TextMap 494900", "confidence": "明文·转述", "narrator": "丑角", "review_status": "已修正", "predicate_zh": "见证"}, {"cid": 11754, "predicate": "narrates", "object_text": "此事是与海洛塔帝产生隔阂的源头（并非恨意的源头）", "object_id": null, "quote": "这件事只是我与海洛塔帝产生隔阂的源头，并非我对他的恨意的源头。", "source": "17_丑角·src_1703", "confidence": "明文·转述", "narrator": "丑角", "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 11757, "predicate": "travels-to", "object_text": "女皇麾下（以愚人众统括官身份）", "object_id": null, "quote": "彼时的我已经作为愚人众统括官，来到了女皇麾下。", "source": "17_丑角·src_1703", "confidence": "明文·转述", "narrator": "丑角", "review_status": "已复核·通过", "predicate_zh": "抵达"}, {"cid": 11758, "predicate": "seals", "object_text": "贤者笔记（率全部执行官，经女皇批准）", "object_id": null, "quote": "于是我向女皇提出了申请，带领全部的执行官一同封印了这本笔记。", "source": "17_丑角·src_1703", "confidence": "明文·转述", "narrator": "丑角", "review_status": "已复核·通过", "predicate_zh": "封印"}, {"cid": 11759, "predicate": "founds", "object_text": "愚人众执行官班底（招募多托雷、罗莎琳、散兵等）", "object_id": null, "quote": "循着「异端」的传闻，最初的愚者找到了他…", "source": "17_丑角·Relic15018_2", "confidence": "明文", "narrator": null, "review_status": "待仲裁", "predicate_zh": "创立"}, {"cid": 11760, "predicate": "narrates", "object_text": "对多托雷：「很好。那么，我们就是同伴了。」", "object_id": null, "quote": "很好。那么，我们就是同伴了。", "source": "17_丑角·Relic15018_2", "confidence": "明文·转述", "narrator": "丑角", "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 11761, "predicate": "narrates", "object_text": "说服散兵赴至冬", "object_id": null, "quote": "丑角却说服了他，令他被那疯狂的盛宴所吸引", "source": "17_丑角·FetterStory#482", "confidence": "明文·转述", "narrator": "散兵档案", "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 11762, "predicate": "participates-in", "object_text": "以星之楔技术向天穹发问，召来派蒙", "object_id": null, "quote": "我对着天穹使用这种技术，所得到的回应…正是从天空岛降临而来的派蒙。", "source": "17_丑角·src_1701", "confidence": "存疑", "narrator": "丑角", "review_status": "已修正", "predicate_zh": "参与"}, {"cid": 11763, "predicate": "grants", "object_text": "派蒙予「黑王」（被拒）", "object_id": null, "quote": "我曾将派蒙献予「黑王」，可「黑王」对这份礼物并无兴趣，也并不满意。", "source": "17_丑角·src_1701", "confidence": "明文·转述", "narrator": "丑角", "review_status": "已复核·通过", "predicate_zh": "授予"}, {"cid": 11764, "predicate": "narrates", "object_text": "世界的一切规则都由「诅咒」构成", "object_id": null, "quote": "另外…或许对你们来说还有些难以理解。你们是否知道，这个世界的一切规则，都是由「诅咒」所构成的？", "source": "17_丑角·TextMap 547842", "confidence": "明文·转述", "narrator": "丑角", "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 11765, "predicate": "narrates", "object_text": "魔神对人类的爱是天理施加给魔神的诅咒", "object_id": null, "quote": "嗯，还有…「魔神对人类的爱」，也是天理施加给魔神的诅咒。", "source": "17_丑角·TextMap 916254", "confidence": "明文·转述", "narrator": "丑角", "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 11766, "predicate": "participates-in", "object_text": "发起贤者笔记解封（发起者无需投票）", "object_id": null, "quote": "好，解封由我发起，发起者无需投票。", "source": "17_丑角·src_1703", "confidence": "明文·转述", "narrator": "丑角", "review_status": "已复核·通过", "predicate_zh": "参与"}, {"cid": 11768, "predicate": "narrates", "object_text": "假设所有地方都在被若娜瓦监视与窃听", "object_id": null, "quote": "所以…我们最好假设所有地方都在被若娜瓦监视，所有地方都在被若娜瓦窃听。", "source": "17_丑角·src_1703", "confidence": "明文·转述", "narrator": "丑角", "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 11769, "predicate": "narrates", "object_text": "唯有相信女皇的力量与智慧", "object_id": null, "quote": "唯有相信女皇陛下，相信女皇陛下的力量与智慧。", "source": "17_丑角·src_1703", "confidence": "明文·转述", "narrator": "丑角", "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 11770, "predicate": "possesses", "object_text": "不死诅咒（与戴因斯雷布相同）", "object_id": null, "quote": null, "source": "17_丑角·TextMap 867211", "confidence": "明文·转述", "narrator": "戴因斯雷布／达妮卡", "review_status": "已复核·通过", "predicate_zh": "持有权能"}, {"cid": 11791, "predicate": "narrates", "object_text": "「他佩戴嗤笑世界的面具，自己却从不微笑。」", "object_id": null, "quote": "他佩戴嗤笑世界的面具，自己却从不微笑。", "source": "18_哥伦比娅·Fetters#8230", "confidence": "明文·转述", "narrator": "哥伦比娅", "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 11918, "predicate": "grants", "object_text": "派蒙予「黑王」（被拒，黑王对此礼物无兴趣亦不满意）", "object_id": null, "quote": null, "source": "24_派蒙·arch_1701", "confidence": "明文·转述", "narrator": "丑角", "review_status": "已复核·通过", "predicate_zh": "授予"}, {"cid": 11920, "predicate": "narrates", "object_text": "派蒙的失忆或为坎瑞亚灾变所致诅咒", "object_id": null, "quote": "经历过坎瑞亚灾变，或许你也负上了什么诅咒吧。丧失记忆算是我见过最小的代价了。", "source": "24_派蒙·arch_1701", "confidence": "明文·转述", "narrator": "丑角", "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 11921, "predicate": "narrates", "object_text": "派蒙是那个疯狂时代留下的唯一不疯狂之物、值得保护", "object_id": null, "quote": "而如今的你在我眼里，像是那个疯狂的时代留下的唯一不疯狂的东西，值得受到保护。", "source": "24_派蒙·arch_1701", "confidence": "明文·转述", "narrator": "丑角", "review_status": "已复核·通过", "predicate_zh": "转述"}], "corpus_caveats": []}
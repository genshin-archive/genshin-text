{"entity": {"eid": 1230, "ent_code": null, "name": "莫妮卡", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:46"}, "aliases": [], "claims": [{"cid": 3758, "predicate": "is-a", "object_text": "爱可菲之徒、莫德斯特的后裔（持手记残篇）", "object_id": null, "quote": "萨维利，千算万算，你都没想到，莫德斯特的孩子手里，还留着手记的残篇吧！", "source": "珍上至珍·quest 14046·增量", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 3759, "predicate": "causes", "object_text": "全店烤炉低温半度、伪造秘方暗示、挑起料理对决", "object_id": null, "quote": "店里所有烤炉都一个样——我当时还没弄懂为什么，现在想想，多半是莫妮卡给你设的圈套吧。", "source": "珍上至珍·quest 14046", "confidence": "明文·转述", "narrator": "爱可菲", "review_status": "未复核", "predicate_zh": "引发"}, {"cid": 3760, "predicate": "participates-in", "object_text": "以幽光素毒茶害倒菲尔曼", "object_id": null, "quote": null, "source": "珍上至珍·quest 14045", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "参与"}, {"cid": 3761, "predicate": "imposes", "object_text": "双壶下毒的同归于尽局（被爱可菲换水化解）", "object_id": null, "quote": "两个水壶里…我都下了毒", "source": "珍上至珍·quest 14046", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "自定义关系"}, {"cid": 3762, "predicate": "is-a", "object_text": "以秘宝向盗宝团、愚人众牟利的谋财者（落网）", "object_id": null, "quote": "没错…我已经查清楚了，这是雷穆利亚为战争准备的药物！把它卖给盗宝团、愚人众，才是发财的正道！", "source": "珍上至珍·quest 14046", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 3763, "predicate": "distrusts", "object_text": "莎凡娜与爱可菲（自居操纵者、嘲其皆庸才）", "object_id": null, "quote": null, "source": "珍上至珍·quest 14046·校正", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "不信任"}], "corpus_caveats": []}
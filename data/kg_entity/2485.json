{"entity": {"eid": 2485, "ent_code": null, "name": "镜中人", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:51"}, "aliases": [], "claims": [{"cid": 9718, "predicate": "is-a", "object_text": "相貌与克里克别无二致者", "object_id": null, "quote": "一个相貌与我别无二致的人紧紧盯着我的眼睛，就如同我盯着他那般。", "source": "旅时者·Book663", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 9719, "predicate": "narrates", "object_text": "「没有人能征服时间」", "object_id": null, "quote": "你想要征服时间。没有人能征服时间。", "source": "旅时者·Book663", "confidence": "明文·转述", "narrator": "镜中人", "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 9720, "predicate": "narrates", "object_text": "时间的谜底是镜子", "object_id": null, "quote": "时间的谜底是镜子。", "source": "旅时者·Book663", "confidence": "明文·转述", "narrator": "镜中人", "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 9721, "predicate": "narrates", "object_text": "两面镜子对准彼此，光路即时间；没有过去也没有未来", "object_id": null, "quote": "两面镜子对准彼此，其中无限反射的光路就是时间。无数背离的、汇合的、平行的光构成了名为时间的错觉，没有过去，也没有未来，因为过去就是未来。", "source": "旅时者·Book663", "confidence": "明文·转述", "narrator": "镜中人", "review_status": "已复核·通过", "predicate_zh": "转述"}], "corpus_caveats": []}
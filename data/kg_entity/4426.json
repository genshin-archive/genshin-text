{"entity": {"eid": 4426, "ent_code": null, "name": "华发学者", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:57"}, "aliases": [], "claims": [{"cid": 14170, "predicate": "witnesses", "object_text": "一切（目睹后仍在废墟之中前行）", "object_id": null, "quote": "即便如此，目睹一切的学者仍然废墟之中前行，忘却危险，那姿态不如说是在绳上以冰鞋起舞。", "source": "华发学者与学徒·Relic15046_2", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "见证"}, {"cid": 14173, "predicate": "participates-in", "object_text": "用笔勾勒某项不可为的事项的宏图", "object_id": null, "quote": "那时她正用笔勾勒某项不可为的事项的宏图。", "source": "华发学者与学徒·Relic15046_2", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "参与"}, {"cid": 14174, "predicate": "knows-of", "object_text": "学徒（矮灵）的寿数比她还要稍长一些", "object_id": null, "quote": "学者想起眼前的矮灵，寿数甚至比她还要稍长一些", "source": "华发学者与学徒·Relic15046_2", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "知晓"}, {"cid": 14175, "predicate": "knows-of", "object_text": "学徒心底的犹疑（不因其恐惧而嗤笑）", "object_id": null, "quote": "可她并未因对方直视宏伟文明覆灭产生的恐惧而嗤笑，相反，她认真直视对方因恐惧而颤动的双眼，直视对方心底的犹疑。", "source": "华发学者与学徒·Relic15046_2", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "知晓"}, {"cid": 14180, "predicate": "grants", "object_text": "书写的笔管（放进学徒的手中）", "object_id": null, "quote": "华发的学者，已不再是少女的少女将书写的笔管放进学徒的手中", "source": "华发学者与学徒·Relic15046_2", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "授予"}, {"cid": 15787, "predicate": "participates-in", "object_text": "引领年轻矮灵初入影中世界探索（递笔予他）", "object_id": null, "quote": null, "source": "至冬妖精宫廷群_谧源所与阿克西妮娅·Relic15048_2", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "参与"}], "corpus_caveats": []}
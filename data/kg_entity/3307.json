{"entity": {"eid": 3307, "ent_code": null, "name": "阿千", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:54"}, "aliases": [], "claims": [{"cid": 11429, "predicate": "is-a", "object_text": "不生于本世界的化猫（来自凡人更猖狂的天地）", "object_id": null, "quote": "阿千本不生于我们的世界，她来自一个凡人更为猖狂的天地。", "source": "鹮巷物语·Book209", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 11431, "predicate": "part-of", "object_text": "将军（御化猫，后为忍者）", "object_id": null, "quote": null, "source": "鹮巷物语·Book209", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "从属（组织）"}, {"cid": 11432, "predicate": "participates-in", "object_text": "水战之夜化身华贵妇人立于小船、立金扇羞辱贼将", "object_id": null, "quote": "命阿千化成华贵妇人站在小船上，又立一金扇，以此羞辱贼将不敢近前。", "source": "鹮巷物语·Book209", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "参与"}, {"cid": 11434, "predicate": "is-a", "object_text": "摇落纸扇者（揭出与一坠海的真相）", "object_id": null, "quote": "不过，我已有几百年未见过如此有趣的活物，便给她赚个面子，憋着笑自己摇落了纸扇……", "source": "鹮巷物语·Book209", "confidence": "明文·转述", "narrator": "阿千", "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 11435, "predicate": "narrates", "object_text": "「再后来，我被她带来了这个世界，把我当做了什么战利品一样！」", "object_id": null, "quote": "再后来，我被她带来了这个世界，把我当做了什么战利品一样！", "source": "鹮巷物语·Book209", "confidence": "明文·转述", "narrator": "阿千", "review_status": "已复核·通过", "predicate_zh": "转述"}], "corpus_caveats": []}
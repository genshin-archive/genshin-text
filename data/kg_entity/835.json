{"entity": {"eid": 835, "ent_code": null, "name": "狼哥", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:45"}, "aliases": [], "claims": [{"cid": 2379, "predicate": "is-a", "object_text": "流散在人间的鬼魂（老孟要找之人）", "object_id": null, "quote": "其实，老孟要找的「狼哥」，是一个流散在人间的鬼魂。", "source": "奈何蝶飞去·quest 11110", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 2386, "predicate": "is-a", "object_text": "保持当年孩童模样的幽灵", "object_id": null, "quote": "因为是幽灵嘛，理所当然地保持着他当年的样子。", "source": "奈何蝶飞去·quest 11111", "confidence": "明文·转述", "narrator": "胡桃", "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 2387, "predicate": "participates-in", "object_text": "尾随璃月港试胆者入城（思念旧友所致）", "object_id": null, "quote": "前几天有几个人来无妄坡试胆，听说他们都是从璃月港来的，我就跟着其中一个人，一路尾随到了这里。", "source": "奈何蝶飞去·quest 11112", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "参与"}, {"cid": 2388, "predicate": "is-a", "object_text": "在璃月港迷路者（从未到过璃月港）", "object_id": null, "quote": "这个，其实是因为我没有找到他们。我从来没有来过璃月港，然后就在城里迷路了。", "source": "奈何蝶飞去·quest 11112", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 2390, "predicate": "is-a", "object_text": "不敢从山上往下看、怕高的幽灵（老孟童年见证）", "object_id": null, "quote": null, "source": "奈何蝶飞去·quest 11112", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 2391, "predicate": "narrates", "object_text": "从无作恶或恶作剧之念、绝不主动惊吓普通人的誓言", "object_id": null, "quote": "我发誓我从来没有想做坏事或者恶作剧的想法！也绝不主动惊吓普通人！", "source": "奈何蝶飞去·quest 11112", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 2414, "predicate": "survives", "object_text": "跨越边界离去（执念了结、安然上路）", "object_id": null, "quote": "嗯，我会记住大家的，各位再见！", "source": "奈何蝶飞去·quest 11113", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "幸存"}], "corpus_caveats": []}
{"entity": {"eid": 2478, "ent_code": null, "name": "克里克", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:51"}, "aliases": [], "claims": [{"cid": 9707, "predicate": "is-a", "object_text": "主张「时间也是空间的一个维度」者", "object_id": null, "quote": "和长度、宽度、高度一样，时间也是空间的一个维度。", "source": "旅时者·Book661", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 9713, "predicate": "knows-of", "object_text": "第一块石板的谜底为「帝国覆灭的数百年后」的一个日期", "object_id": null, "quote": "破译的关键在于一个已经死去了三十年的奴隶的名字，而谜底则是一个日期，指向帝国覆灭的数百年后。", "source": "旅时者·Book663", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "知晓"}, {"cid": 9716, "predicate": "travels-to", "object_text": "时间零（无风无浪的大海上空、暗红天空）", "object_id": null, "quote": "我意识到自己正悬浮于一片大海上方，没有浪潮，也没有波涛，因为就连风也不存在于这一刻。", "source": "旅时者·Book663", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "抵达"}, {"cid": 9723, "predicate": "opposes", "object_text": "镜中人（开枪射击）", "object_id": null, "quote": "我拔出了用来防身的铳枪，朝着他的脑袋扣下了扳机。", "source": "旅时者·Book663", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "对抗"}, {"cid": 9724, "predicate": "is-a", "object_text": "自称将「为未来的我留下谜题」者", "object_id": null, "quote": "我要去为未来的我留下谜题了。", "source": "旅时者·Book663", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}], "corpus_caveats": []}
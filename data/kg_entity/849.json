{"entity": {"eid": 849, "ent_code": null, "name": "舒伯特·劳伦斯", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:45"}, "aliases": [], "claims": [{"cid": 2419, "predicate": "narrates", "object_text": "「若在礼仪上怠慢了贵族，至少都是一顿鞭刑」（旧贵族规矩）", "object_id": null, "quote": "若在礼仪上怠慢了贵族，至少都是一顿鞭刑。", "source": "浪花不再归海·quest 10120", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 2435, "predicate": "participates-in", "object_text": "以蒙德城防图换取愚人众扶植劳伦斯家族的交易", "object_id": null, "quote": null, "source": "浪花不再归海·quest 10122", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "参与"}, {"cid": 2436, "predicate": "wields", "object_text": "蒙德城防图（亲手绘成，标有巡逻路线等信息）", "object_id": null, "quote": "你的叔父靠观察和绘画，把西风骑士的巡逻路线，还有其他好多信息，都标记出来了…", "source": "浪花不再归海·quest 10122", "confidence": "明文·转述", "narrator": "派蒙", "review_status": "未复核", "predicate_zh": "持用"}, {"cid": 2437, "predicate": "narrates", "object_text": "「要让劳伦斯家族的旗帜飘扬在骑士团总部的楼顶上」之约定", "object_id": null, "quote": "那当然，放心好了。你也别忘了我们的约定，要让劳伦斯家族的旗帜飘扬在骑士团总部的楼顶上。", "source": "浪花不再归海·quest 10122", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 2438, "predicate": "narrates", "object_text": "复辟幻想（「所有的市民，都要再度臣服于劳伦斯的脚下」）", "object_id": null, "quote": "到时候我站在骑士团总部的楼顶，痛骂他们对蒙德的软弱统治。所有的市民，都要再度臣服于劳伦斯的脚下！", "source": "浪花不再归海·quest 10122", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 2445, "predicate": "narrates", "object_text": "「家门不幸！家门不幸啊！」（对优菈的怒斥）", "object_id": null, "quote": "家门不幸！家门不幸啊！家里怎么出来你这么一个大逆不道的怪物！", "source": "浪花不再归海·quest 10122", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}], "corpus_caveats": []}
{"entity": {"eid": 810, "ent_code": null, "name": "夜叉", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:45"}, "aliases": [], "claims": [{"cid": 2195, "predicate": "narrates", "object_text": "与魔神怨念斗争千年、亦为「业障」所困", "object_id": null, "quote": "书中说，与魔神怨念斗争了千年的「夜叉」们，也会被「业障」所困。", "source": "槐柯胡蝶，傩佑之梦·talk 1110112", "confidence": "明文·转述", "narrator": "派蒙", "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 2196, "predicate": "narrates", "object_text": "被污染者常陷恐惧、狂怒与痛苦", "object_id": null, "quote": "被魔神怨念污染的夜叉，常常会陷入难以言喻的恐惧、狂怒和痛苦…", "source": "槐柯胡蝶，傩佑之梦·talk 1110112", "confidence": "明文·转述", "narrator": "派蒙", "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 2383, "predicate": "participates-in", "object_text": "与魔神作战（魔神败亡而怨念不散）", "object_id": null, "quote": "他们曾经和魔神作战，打得眼花缭乱、昏天黑地。虽然魔神最后被击败，但它们的怨念久久不散。", "source": "奈何蝶飞去·quest 11111", "confidence": "明文·转述", "narrator": "胡桃", "review_status": "未复核", "predicate_zh": "参与"}, {"cid": 9356, "predicate": "participates-in", "object_text": "层岩巨渊战事（出手救伯阳与戎昭）", "object_id": null, "quote": "若非夜叉出手相救，就连我与胞弟亦要当场殒命。", "source": "多鲁德的长诗·Book403", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "参与"}, {"cid": 9357, "predicate": "is-a", "object_text": "生有四手、其力为雷、神貌癫狂且失忆者", "object_id": null, "quote": "此夜叉生有四手，神貌癫狂，且记不得自身名讳。", "source": "多鲁德的长诗·Book403", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 9358, "predicate": "narrates", "object_text": "以「金鹏」「弥怒」等名号称呼身边人", "object_id": null, "quote": "疯狂时，常以「金鹏」、「弥怒」等名号称呼身边人。", "source": "多鲁德的长诗·Book403", "confidence": "明文·转述", "narrator": "伯阳", "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 9364, "predicate": "dies-in", "object_text": "地宫内（伤重加疯病）", "object_id": null, "quote": null, "source": "多鲁德的长诗·Book403", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "死于"}, {"cid": 9626, "predicate": "is-a", "object_text": "璃月之仙兽（性凶怖悍战，杀生而护法）", "object_id": null, "quote": "夜叉者，璃月之仙兽，性凶怖悍战，杀生而护法。", "source": "护法仙众夜叉录·Book88", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 9634, "predicate": "is-a", "object_text": "空游饿鬼之苦、万劫不灭者", "object_id": null, "quote": "实空游饿鬼之苦，万劫不灭。", "source": "护法仙众夜叉录·Book88", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 10440, "predicate": "participates-in", "object_text": "平魔之战的先驱（登先）", "object_id": null, "quote": null, "source": "玑衡经·Book74", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "参与"}, {"cid": 14158, "predicate": "enemy-of", "object_text": "漆黑深渊（光与暗缠斗，难以久抗）", "object_id": null, "quote": "光与暗缠斗的漆黑深渊，即使以夜叉之强亦难以久抗。", "source": "千岩时计与日御传说·Relic15023_5", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "敌对"}, {"cid": 16961, "predicate": "on-orders", "object_text": "帝君（应帝君之命与深渊的扭曲造物血战至最后一滴血）", "object_id": null, "quote": "夜叉应帝君之命，与深渊的扭曲造物血战。", "source": "勋绩之花（辰砂之女·层岩巨渊五件套）·Relic15017_3", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "自定义关系"}, {"cid": 16962, "predicate": "is-a", "object_text": "深渊退潮、阴翳消散后于层岩巨渊消失无踪者", "object_id": null, "quote": "当层岩巨渊上空的重重阴翳消散，夜叉就此消失无踪。", "source": "勋绩之花（辰砂之女·层岩巨渊五件套）·Relic15017_3", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 17658, "predicate": "is-a", "object_text": "天遒出身、四臂磊魁、紫目烁凶光者（扬刃入渊谷，为民息幽祸）", "object_id": null, "quote": null, "source": "生灵之华（辰砂往生录五件套）·Relic15023_3", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 17659, "predicate": "participates-in", "object_text": "酣斗争天曙的鏖战（空余长叹何蹉跎）", "object_id": null, "quote": "竟不见，夜叉酣斗争天曙，空余长叹何蹉跎", "source": "生灵之华（辰砂往生录五件套）·Relic15023_3", "confidence": "明文·转述", "narrator": "栖鸟的残歌", "review_status": "未复核", "predicate_zh": "参与"}], "corpus_caveats": []}
{"entity": {"eid": 317, "ent_code": null, "name": "「公子」", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:43"}, "aliases": [{"alias": "意图旁观「暗流决堤」的搅局者", "lang": "zh", "confidence": "明文", "evidence": "浮世浮生千岩间·quest 1018·「公子」"}, {"alias": "愚人众执行官", "lang": "zh", "confidence": "明文", "evidence": "浮世浮生千岩间·quest 1000·「公子」"}, {"alias": "愚人众第十一席执行官", "lang": "zh", "confidence": "明文", "evidence": "迫近的客星·quest 1023·「公子」"}], "claims": [{"cid": 882, "predicate": "aka", "object_text": "愚人众执行官（至冬国使臣；自称「我大概是坏人」）", "object_id": null, "quote": null, "source": "浮世浮生千岩间·quest 1000·「公子」", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "别称"}, {"cid": 883, "predicate": "aka", "object_text": "意图旁观「暗流决堤」的搅局者", "object_id": null, "quote": null, "source": "浮世浮生千岩间·quest 1018·「公子」", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "别称"}, {"cid": 884, "predicate": "distrusts", "object_text": "「女士」（「那个女人…我也不喜欢她」）", "object_id": null, "quote": "「女士」给你们留下了很不好的印象吧？唉，那个女人…我也不喜欢她。", "source": "浮世浮生千岩间·quest 1000·「公子」", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "不信任"}, {"cid": 885, "predicate": "narrates", "object_text": "七星应对的二分假说（掩盖真凶／掩盖别的什么东西）", "object_id": null, "quote": null, "source": "浮世浮生千岩间·quest 1000·「公子」", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 886, "predicate": "narrates", "object_text": "「骑士」即荣誉骑士旅行者（被愚人众套话的调侃；语境紧承旅行者回答寻访七神目的之后）", "object_id": null, "quote": "轻易被「愚人众」套话的骑士，可不是一位好骑士，对吧？", "source": "浮世浮生千岩间·quest 1018·「公子」", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 920, "predicate": "narrates", "object_text": "「仙祖法蜕」藏于黄金屋（由窃听情报断言）", "object_id": null, "quote": "原来如此，原来如此。呵，凝光，还有七星。你们想要隐匿在黄金屋的…除了「仙祖法蜕」，还能是什么呢？", "source": "辞行久远之躯·quest 1015·「公子」", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 921, "predicate": "narrates", "object_text": "对钟离「不能想象一个没有钱的自己」的点评", "object_id": null, "quote": null, "source": "辞行久远之躯·quest 1013·「公子」", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 922, "predicate": "narrates", "object_text": "「恰好路过」的自我修正（承认来晚一步错过消息）", "object_id": null, "quote": null, "source": "辞行久远之躯·quest 1013·「公子」", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 923, "predicate": "participates-in", "object_text": "免除风筝余款、代付永生香、建立椰奶供货渠道等收买式资助", "object_id": null, "quote": null, "source": "辞行久远之躯·quest 1013/1015·「公子」", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "参与"}, {"cid": 935, "predicate": "participates-in", "object_text": "以百无禁忌箓之力与执行官力量暂时解封岩枪镇压之力（唤醒奥赛尔）", "object_id": null, "quote": "这么多「百无禁忌箓」的力量聚集在一起，再加上女皇赐予「执行官」的力量…暂时解封岩枪镇压之力，也不是什么办不到的事。", "source": "迫近的客星·quest 1023·「公子」", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "参与"}, {"cid": 961, "predicate": "aka", "object_text": "愚人众第十一席执行官（「作为愚人众的十一执行官，必须贯彻冰之女皇的意旨」；持有「魔王武装」）", "object_id": null, "quote": null, "source": "迫近的客星·quest 1023·「公子」", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "别称"}, {"cid": 962, "predicate": "participates-in", "object_text": "事后被愚人众与璃月外交甩锅（登群玉阁阻挠仙七抗魔为不争事实）", "object_id": null, "quote": "但即使这些「不实指控」确认为假，「公子」派人登上群玉阁、试图阻挠众仙与七星对抗魔神，仍是不争的事实。", "source": "迫近的客星·quest 1025·钟离", "confidence": "明文·转述", "narrator": "钟离", "review_status": "未复核", "predicate_zh": "参与"}, {"cid": 1689, "predicate": "narrates", "object_text": "女皇率军东征讨伐唤来暴雪的魔物，斩落则能源危机可缓", "object_id": null, "quote": null, "source": "无神怜爱的雪国·talk 701314·「公子」", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 1690, "predicate": "narrates", "object_text": "严冬计划反对声抬头，模拟投票结果「非常不乐观」", "object_id": null, "quote": null, "source": "无神怜爱的雪国·talk 701314·「公子」", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}], "corpus_caveats": []}
{"entity": {"eid": 808, "ent_code": null, "name": "掇星攫辰天君", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:45"}, "aliases": [], "claims": [{"cid": 2159, "predicate": "is-a", "object_text": "自称「掇星攫辰天君」（信众称「星辰天君」）", "object_id": null, "quote": "本仙乃是「掇星攫辰天君」，也即是信众们口中的「星辰天君」。", "source": "槐柯胡蝶，傩佑之梦·talk 1110010", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 2160, "predicate": "narrates", "object_text": "游历民间、济世行善、不露真容", "object_id": null, "quote": "本仙…游历民间，济世行善。不露真容，只为少生事端而已。", "source": "槐柯胡蝶，傩佑之梦·talk 1110008", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 2161, "predicate": "narrates", "object_text": "宣称「天君」仙位高于「真君」", "object_id": null, "quote": "毕竟「天君」比「真君」在仙位上高一阶。", "source": "槐柯胡蝶，傩佑之梦·talk 1110010", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 2162, "predicate": "narrates", "object_text": "只要意思到了愿望必实现", "object_id": null, "quote": "各位也都是一样…只要意思到了，愿望定会实现，大可放心。", "source": "槐柯胡蝶，傩佑之梦·talk 1110123", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 2163, "predicate": "narrates", "object_text": "引伪仙「薛无量（人称量子）」之说自圆", "object_id": null, "quote": "哈哈哈…阁下说笑了。有位仙家高人，薛无量，人称「量子」，他曾经说过——", "source": "槐柯胡蝶，傩佑之梦·talk 1110008", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 2164, "predicate": "possesses", "object_text": "「百无禁忌箓」（后失灵）", "object_id": null, "quote": "怎么会的…「百无禁忌箓」怎么会没有效果呢…", "source": "槐柯胡蝶，傩佑之梦·talk 1110107", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "持有权能"}, {"cid": 2165, "predicate": "narrates", "object_text": "以仙力耗损为借口推脱", "object_id": null, "quote": "我…本、本仙忽然觉得身体有恙，定是方才仙力耗损太多所致，不然我必斩尽这些妖邪…", "source": "槐柯胡蝶，傩佑之梦·talk 1110107", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 2166, "predicate": "narrates", "object_text": "持有权能自爷爷遗物所得之「百无禁忌箓」", "object_id": null, "quote": "可是自打从爷爷的遗物里，找到了「百无禁忌箓」…", "source": "槐柯胡蝶，傩佑之梦·talk 1110309", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 2167, "predicate": "narrates", "object_text": "骗术始末：由模仿仙人渐入邪路", "object_id": null, "quote": "一开始我只是喜欢模仿仙人，装装样子，可后来就在邪路上越走越远了。", "source": "槐柯胡蝶，傩佑之梦·talk 1110309", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 2168, "predicate": "narrates", "object_text": "立誓弃恶扬善、不再败坏仙人声誉", "object_id": null, "quote": "从此一定弃恶扬善、安稳度日，不再败坏仙人的声誉！", "source": "槐柯胡蝶，傩佑之梦·talk 1110309", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 2169, "predicate": "is-a", "object_text": "客栈登记名「王平安」", "object_id": null, "quote": "他在我这里登记的名字是「王平安」哦。", "source": "槐柯胡蝶，傩佑之梦·talk 1110310", "confidence": "明文·转述", "narrator": "菲尔戈黛特", "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 2170, "predicate": "narrates", "object_text": "退房去独自游历山川", "object_id": null, "quote": "他已经把客房退了，说是要去独自游历山川…", "source": "槐柯胡蝶，傩佑之梦·talk 1110310", "confidence": "明文·转述", "narrator": "菲尔戈黛特", "review_status": "未复核", "predicate_zh": "转述"}], "corpus_caveats": []}
{"entity": {"eid": 881, "ent_code": null, "name": "神里华代", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:45"}, "aliases": [{"alias": "「椿」", "lang": "zh", "confidence": "明文", "evidence": "鹤与白兔的诉说·quest 12007"}], "claims": [{"cid": 2514, "predicate": "aka", "object_text": "「椿」（母亲为理想中的自己所起之名）", "object_id": null, "quote": "椿与平时的我既相同又不同，作为椿时，我不是神里华代，而是一个最最平凡的女子。", "source": "鹤与白兔的诉说·quest 12007", "confidence": "明文·转述", "narrator": "神里绫华", "review_status": "已复核·通过", "predicate_zh": "别称"}, {"cid": 2516, "predicate": "is-a", "object_text": "曾任神里家主母、掌管社奉行各项事宜之人", "object_id": null, "quote": "母亲嫁给我父亲之后，就一直作为神里家的主母掌管各项事宜。社奉行身份相对尊贵，需要打点的方面非常多。", "source": "鹤与白兔的诉说·quest 12007", "confidence": "明文·转述", "narrator": "神里绫华", "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 2517, "predicate": "is-a", "object_text": "一次都没有去过民间祭典者（不愿打扰别人）", "object_id": null, "quote": "她不愿打扰别人，也没有那么多闲暇，便一次都没有去过了。", "source": "鹤与白兔的诉说·quest 12007", "confidence": "明文·转述", "narrator": "神里绫华", "review_status": "已复核·通过", "predicate_zh": "是（类属）"}], "corpus_caveats": []}
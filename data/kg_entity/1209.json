{"entity": {"eid": 1209, "ent_code": null, "name": "阿卡特", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:46"}, "aliases": [{"alias": "预备英雄", "lang": "zh", "confidence": "明文", "evidence": "瓦雷莎·角色故事2 hash 2223613424"}], "claims": [{"cid": 3672, "predicate": "is-a", "object_text": "瓦雷莎所称的「阿卡特叔叔」、沃陆之邦部族首领", "object_id": null, "quote": null, "source": "炽热的沃陆·quest 15018", "confidence": "明文·转述", "narrator": "瓦雷莎", "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 3692, "predicate": "is-a", "object_text": "被明确为「我们的首领」、本章未出场（不在家）", "object_id": null, "quote": null, "source": "果园小憩·quest 15033", "confidence": "明文·转述", "narrator": "旁白", "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 3700, "predicate": "leader-of", "object_text": "沃陆之邦（将众人召集到一起支持调查）", "object_id": null, "quote": null, "source": "田地里的蕈息·quest 15031", "confidence": "明文·转述", "narrator": "旁白", "review_status": "未复核", "predicate_zh": "领袖"}, {"cid": 3719, "predicate": "is-a", "object_text": "自称「图兰的看守者」（派小队往山顶进发）", "object_id": null, "quote": "作为图兰的看守者，我们不可能放着不管", "source": "田地里的蕈息·quest 15031·增量", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 4096, "predicate": "narrates", "object_text": "伊安珊无资格问题、只是脱离健身者经验范畴", "object_id": null, "quote": "但这不代表你没有健身的资格，而是代表没有人能向你提供指导，因为你的身体条件已经脱离了绝大多数健身者的经验范畴。", "source": "伊安珊·角色故事2·hash 251545944", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 6747, "predicate": "narrates", "object_text": "同食不同力的体质差异（同样一份午餐，有人只能卧推十组杠铃，有人能带着同重量杠铃登山再跳战舞）", "object_id": null, "quote": "同样吃掉一份午餐，有的人或许只能卧推十组杠铃，有的人却能带着同样重量的杠铃登上山巅，再跳个战舞。", "source": "瓦雷莎·角色故事2 hash 2223613424", "confidence": "明文·转述", "narrator": "部族首领阿卡特", "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 6749, "predicate": "aka", "object_text": "预备英雄（未必是古名继承者，却如船舶龙骨、建筑地基般长期作为中坚力量，机会降临时也能书写辉煌）", "object_id": null, "quote": "这些战士未必各个都能成为古名的继承者或惊天动地的英雄，但就像船舶的龙骨，建筑的地基，一直作为中坚力量，在人们不常关注的地方发挥着光热，机会降临时，他们也能书写辉煌的故事，说是「预备英雄」也不为过。", "source": "瓦雷莎·角色故事2 hash 2223613424", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "别称"}], "corpus_caveats": []}
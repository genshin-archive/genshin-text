{"entity": {"eid": 3334, "ent_code": null, "name": "晨星长女", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:54"}, "aliases": [], "claims": [{"cid": 11591, "predicate": "is-a", "object_text": "一度被视作晨星的长女（反叛集会时高踞宝座者）", "object_id": null, "quote": "一度被视作晨星的长女，如今竟高踞于十恶不赦的宝座", "source": "10_晨星长女·Relic15045_3", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 11592, "predicate": "wields", "object_text": "曾为万民斩断镣铐的宝剑", "object_id": null, "quote": "举起曾为万民斩断镣铐的宝剑", "source": "10_晨星长女·Relic15045_3", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "持用"}, {"cid": 11593, "predicate": "narrates", "object_text": "「最后的战争就要打响，而我已然知晓我所渴求之物」", "object_id": null, "quote": "最后的战争就要打响，而我已然知晓我所渴求之物", "source": "10_晨星长女·Relic15045_3", "confidence": "明文·转述", "narrator": "晨星长女", "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 11594, "predicate": "narrates", "object_text": "「宁愿选择艰难的自由，也不愿去佩戴那舒适的枷锁」", "object_id": null, "quote": "宁愿选择艰难的自由，也不愿去佩戴那舒适的枷锁", "source": "10_晨星长女·Relic15045_3", "confidence": "明文·转述", "narrator": "晨星长女", "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 11595, "predicate": "narrates", "object_text": "要么废黜它天上的王位", "object_id": null, "quote": "要么废黜它在天上的王位，让世界之外的正义审判；", "source": "10_晨星长女·Relic15045_3", "confidence": "明文·转述", "narrator": "晨星长女", "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 11596, "predicate": "narrates", "object_text": "要么与永恒的命运一同死去", "object_id": null, "quote": "要么毁灭于它无常的怒火，与永恒的命运一同死去", "source": "10_晨星长女·Relic15045_3", "confidence": "明文·转述", "narrator": "晨星长女", "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 11597, "predicate": "narrates", "object_text": "不相信永不消逝的繁荣与可被设计的幸福", "object_id": null, "quote": "我不相信永不消逝的繁荣；我不相信幸福可被设计；", "source": "10_晨星长女·Relic15045_3", "confidence": "明文·转述", "narrator": "晨星长女", "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 11598, "predicate": "narrates", "object_text": "不相信七重辉耀的星冕普渡众生", "object_id": null, "quote": "我不相信七重辉耀的星冕，它的光芒当真普渡众生；", "source": "10_晨星长女·Relic15045_3", "confidence": "明文·转述", "narrator": "晨星长女", "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 11599, "predicate": "narrates", "object_text": "不相信奴颜婢膝的颂歌，因世界属于我们自己", "object_id": null, "quote": "我不相信奴颜婢膝的颂歌，因为世界属于我们自己。", "source": "10_晨星长女·Relic15045_3", "confidence": "明文·转述", "narrator": "晨星长女", "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 11600, "predicate": "narrates", "object_text": "从苦痛里创造安乐，伟业已超越恩典", "object_id": null, "quote": "从命中注定的苦痛里创造安乐，我们的伟业早已超越了它的恩典；", "source": "10_晨星长女·Relic15045_3", "confidence": "明文·转述", "narrator": "晨星长女", "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 11602, "predicate": "narrates", "object_text": "失败亦会带来新的转机", "object_id": null, "quote": "即便是失败亦会带来新的转机，因为未来的人们也在凝视着我们。", "source": "10_晨星长女·Relic15045_3", "confidence": "明文·转述", "narrator": "晨星长女", "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 11607, "predicate": "loves", "object_text": "无名少年（最初的觉者，其伴侣）", "object_id": null, "quote": "使我从无明之梦中醒来的伴侣啊", "source": "10_晨星长女·Relic15045_2", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "爱"}, {"cid": 11608, "predicate": "narrates", "object_text": "劝伴侣趁来得及回到属于他的世界去", "object_id": null, "quote": "趁一切还来得及，回到属于你的世界去吧", "source": "10_晨星长女·Relic15045_2", "confidence": "明文·转述", "narrator": "晨星长女", "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 11609, "predicate": "narrates", "object_text": "希望仍在碌碌凡人身上", "object_id": null, "quote": "希望仍在碌碌凡人身上，从他们之中将诞生超越的灵魂", "source": "10_晨星长女·Relic15045_2", "confidence": "明文·转述", "narrator": "晨星长女", "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 11610, "predicate": "narrates", "object_text": "争取的时间太少，不足以让奇迹在这一代发生", "object_id": null, "quote": "但我们争取的时间太少，还不足以让奇迹在这一代发生", "source": "10_晨星长女·Relic15045_2", "confidence": "明文·转述", "narrator": "晨星长女", "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 11615, "predicate": "is-a", "object_text": "身陷万载之囹圄者（天罚所致）", "object_id": null, "quote": "即便因此会使她身陷万载之囹圄，终北的雪花没入神明也不知晓的影中…", "source": "10_晨星长女·Relic15045_2", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 11724, "predicate": "narrates", "object_text": "「你点起了最初的火，但这终究不是属于你的战争，你也不该背负非违的罪愆」", "object_id": null, "quote": "你点起了最初的火，但这终究不是属于你的战争，你也不该背负非违的罪愆", "source": "15_无名少年·Relic15045_2", "confidence": "明文·转述", "narrator": "众天使之长", "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 11725, "predicate": "narrates", "object_text": "劝其趁来得及回到属于他的世界去", "object_id": null, "quote": "使我从无明之梦中醒来的伴侣啊，趁一切还来得及，回到属于你的世界去吧", "source": "15_无名少年·Relic15045_2", "confidence": "明文·转述", "narrator": "众天使之长", "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 11972, "predicate": "narrates", "object_text": "举兵檄文「我不相信七重辉耀的星冕」", "object_id": null, "quote": "我不相信七重辉耀的星冕", "source": "27_妖精·Relic15045_3", "confidence": "明文·转述", "narrator": "反叛同盟檄文", "review_status": "未复核", "predicate_zh": "转述"}], "corpus_caveats": []}
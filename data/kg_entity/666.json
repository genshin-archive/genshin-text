{"entity": {"eid": 666, "ent_code": null, "name": "「灰眸」", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:44"}, "aliases": [], "claims": [{"cid": 1658, "predicate": "is-a", "object_text": "至冬的先古造物（眼镜形态，可驾驶列车、标记目标、构造影域穿行装备）", "object_id": null, "quote": "至冬曾是妖精的国度，留存了许多先古造物，足以让您大开眼界。不过如您这般的生物…也在扩充我的资料库…", "source": "无神怜爱的雪国·talk 701124·「灰眸」", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 1659, "predicate": "part-of", "object_text": "黄金之城亥珀波瑞亚的遗余（启动密令自证）", "object_id": null, "quote": "启动密令：「我等昔日从阴影的残垣中窥得过往，此为黄金之城亥珀波瑞亚的遗余」。", "source": "无神怜爱的雪国·talk 701215·「灰眸」", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "从属（组织）"}, {"cid": 1660, "predicate": "narrates", "object_text": "使命：「寻回开启「明日」的力量，使受苦的众生抵达虚舟漂泊的彼岸」", "object_id": null, "quote": "是的…我需要…我需要找回我的身躯，寻回开启「明日」的力量，使受苦的众生抵达虚舟漂泊的彼岸…", "source": "无神怜爱的雪国·talk 701113·「灰眸」", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 1661, "predicate": "is-a", "object_text": "为人类抵达「明日」而被制造者（愿为「人类」服务为首要目的）", "object_id": null, "quote": null, "source": "无神怜爱的雪国·talk 701113·「灰眸」", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 1662, "predicate": "narrates", "object_text": "曾拥有形体的记忆与意识（现态与之相悖）", "object_id": null, "quote": "在被造出来的时候我是这样…但我也有曾经拥有形体的记忆和意识，与现在的状态相悖…", "source": "无神怜爱的雪国·talk 701113·「灰眸」", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 1663, "predicate": "knows-of", "object_text": "「愚人众」「统括官」皆为陌生词汇（数据库长期离线）", "object_id": null, "quote": "请容我打断片刻，「愚人众」，以及「统括官」，于我而言都是陌生词汇，可否询问更详细的信息？", "source": "无神怜爱的雪国·talk 701124·「灰眸」", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "知晓"}, {"cid": 1664, "predicate": "located-in", "object_text": "距离上次启动「很长的时间」之后（时间计量不可用）", "object_id": null, "quote": "距离上次启动已有…时间计量因…影响不可用，总之，应该是很长的时间了。", "source": "无神怜爱的雪国·talk 701113·「灰眸」", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "位于"}, {"cid": 1686, "predicate": "knows-of", "object_text": "丑角离开时未言述动机（其数据库中查无此人）", "object_id": null, "quote": null, "source": "无神怜爱的雪国·talk 701124·「灰眸」", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "知晓"}], "corpus_caveats": []}
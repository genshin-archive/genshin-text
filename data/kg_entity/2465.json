{"entity": {"eid": 2465, "ent_code": null, "name": "角蜥", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:51"}, "aliases": [], "claims": [{"cid": 9676, "predicate": "is-a", "object_text": "可去头去内脏剥皮后穿细枝烧烤的食材", "object_id": null, "quote": "将捉到的角蜥去头，去内脏，然后剥下外皮，穿在细枝上烧烤，两面烤熟即可。", "source": "提瓦特野外救急食谱·Book86", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 9677, "predicate": "is-a", "object_text": "无毒无害但味偏腥发苦者", "object_id": null, "quote": "角蜥味道偏腥发苦，第一次食用的话，会感受到一股浓烈的动物酸味，类似氨水泡过的老汗巾，但放心无毒无害。", "source": "提瓦特野外救急食谱·Book86", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}], "corpus_caveats": []}
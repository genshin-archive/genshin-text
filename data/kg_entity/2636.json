{"entity": {"eid": 2636, "ent_code": null, "name": "蟹沙皇", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:52"}, "aliases": [], "claims": [{"cid": 10039, "predicate": "located-in", "object_text": "霜月之子聚居地旁（那夏镇一带）", "object_id": null, "quote": "蟹沙皇老爷就住在霜月之子那群怪人的聚居地旁边", "source": "海螺笔记本·Book1124", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "位于"}, {"cid": 10040, "predicate": "is-a", "object_text": "传说已有几百岁的巨蟹", "object_id": null, "quote": "传说已经有几百岁了（否则怎么会长得这么大呢？）", "source": "海螺笔记本·Book1124", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 10041, "predicate": "wields", "object_text": "像小山丘一样大的海螺壳（比社团旗上画的海螺还大）", "object_id": null, "quote": "一个特别特别大的、像小山丘一样的海螺（比我们画在旗子上的海螺还要大！）", "source": "海螺笔记本·Book1124", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "持用"}, {"cid": 10044, "predicate": "commands", "object_text": "附近的小螃蟹（被梅蒂推为臣民）", "object_id": null, "quote": "既然如此，附近的小螃蟹自然也就都是它的臣民了。", "source": "海螺笔记本·Book1124", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "统辖"}, {"cid": 10047, "predicate": "participates-in", "object_text": "拒食进贡小鱼（把它推到一边，望远处的海）", "object_id": null, "quote": "只是用小一点的那只钳子把它推到了一边，然后就一动不动了，好像在看远处的海。", "source": "海螺笔记本·Book1124", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "参与"}], "corpus_caveats": []}
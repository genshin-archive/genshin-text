{"entity": {"eid": 6633, "ent_code": null, "name": "「契科塔」就任誓约", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:54:05"}, "aliases": [], "claims": [{"cid": 19422, "predicate": "is-a", "object_text": "凡所辖之地皆维其法度、佑其安宁；行恐怖、坏秩序者依法禁制", "object_id": null, "quote": "凡我所辖之地，皆当维其法度，佑其安宁；」「凡施行恐怖、败坏秩序者，皆当依法禁制。", "source": "霜雪誓约·Weapon15436", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 19423, "predicate": "is-a", "object_text": "克服人的软弱、舍弃无用情感，令冰雪心脏恒久跳动", "object_id": null, "quote": "克服为人的软弱，令漫长的边境平安无虞；」「舍弃无用的情感，令冰雪的心脏恒久跳动。", "source": "霜雪誓约·Weapon15436", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 19424, "predicate": "is-a", "object_text": "权柄下不失谦卑、责任中不失良知，远离怯懦与傲慢", "object_id": null, "quote": "使我权柄下不失谦卑，责任之中不失良知；」「使我远离怯懦与傲慢，永不背弃这一誓言。", "source": "霜雪誓约·Weapon15436", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}], "corpus_caveats": []}
{"entity": {"eid": 2818, "ent_code": null, "name": "大蛇远吕羽氏", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:52"}, "aliases": [], "claims": [{"cid": 10517, "predicate": "participates-in", "object_text": "折下身上的珊瑚枝、指引海渊之民重见天光", "object_id": null, "quote": "传说在那时，大蛇远吕羽氏曾折下身上的珊瑚枝、指引海渊之民重见天光", "source": "珊瑚宫民间信仰初勘·Book308", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "参与"}, {"cid": 10518, "predicate": "creates", "object_text": "贫瘠珊瑚岛上子民的生路（以慈悲与怜悯聚集子民）", "object_id": null, "quote": "又以慈悲与怜悯聚集子民，为之在贫瘠的珊瑚岛上寻求生路。", "source": "珊瑚宫民间信仰初勘·Book308", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "创造"}, {"cid": 10520, "predicate": "is-a", "object_text": "身负败者苦涩过去之神", "object_id": null, "quote": "大蛇从未忘记自己身为败者的苦涩过去，以及令子民不再遭受离弃的庄严誓言。", "source": "珊瑚宫民间信仰初勘·Book308", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 10521, "predicate": "enemy-of", "object_text": "龙嗣（已为其驱逐，海渊之民由是得见天光）", "object_id": null, "quote": "既然我已为你们驱逐龙嗣，令你们得见天光。", "source": "珊瑚宫民间信仰初勘·Book308", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "敌对"}, {"cid": 10525, "predicate": "is-a", "object_text": "海中国度的指导者（无劫夺、无欺凌、无人受压迫）", "object_id": null, "quote": "指导我们建立无劫夺、无欺凌，无人遭受压迫之苦的海中国度", "source": "珊瑚宫民间信仰初勘·Book308", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 10526, "predicate": "is-a", "object_text": "对东进之请未置可否、沉默以对者", "object_id": null, "quote": "大蛇却未置可否，只是沉默以对。", "source": "珊瑚宫民间信仰初勘·Book308", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 10530, "predicate": "participates-in", "object_text": "将贫弱海民训练成强悍战士", "object_id": null, "quote": "就这样，大蛇将贫弱的海民训练成强悍的战士", "source": "珊瑚宫民间信仰初勘·Book308", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "参与"}, {"cid": 10531, "predicate": "opposes", "object_text": "雷神之国（驱使舟船与海兽、波涛与云团发起侵攻）", "object_id": null, "quote": "在鲸歌的陪伴中向雷神之国发起侵攻…", "source": "珊瑚宫民间信仰初勘·Book308", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "对抗"}, {"cid": 10554, "predicate": "seals", "object_text": "渊下编年史（下令封存于渊下宫，不得带出）", "object_id": null, "quote": "但是这些都被大蛇下令封存于渊下宫之中，不得带出。", "source": "珊瑚宫民间信仰初勘·Book308", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "封印"}, {"cid": 10556, "predicate": "instigates", "object_text": "海祇民诸姓的学习（下令学习鸣神传统之后才出现）", "object_id": null, "quote": "如今的海祇民诸姓也是大蛇下令学习鸣神传统之后才出现的。", "source": "珊瑚宫民间信仰初勘·Book308", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "自定义关系"}], "corpus_caveats": []}
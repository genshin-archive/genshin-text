{"entity": {"eid": 42, "ent_code": null, "name": "丘丘人", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:42"}, "aliases": [], "claims": [{"cid": 101, "predicate": "active-during", "object_text": "蒙德城郊（因龙灾逼近城市）", "object_id": null, "quote": null, "source": "捕风的异乡人·quest 360·安柏", "confidence": "明文·转述", "narrator": "安柏", "review_status": "已复核·通过", "predicate_zh": "活跃于"}, {"cid": 117, "predicate": "part-of", "object_text": "深渊教团（听从指挥、成为武器）", "object_id": null, "quote": "荒野上的那些丘丘人，也会听从它们的指挥、成为它们的武器。", "source": "为了没有眼泪的明天·quest 373·温迪", "confidence": "明文·转述", "narrator": "温迪", "review_status": "已复核·通过", "predicate_zh": "从属（组织）"}, {"cid": 8944, "predicate": "participates-in", "object_text": "以小部落形式分散于荒野的聚居生活", "object_id": null, "quote": "它们往往会以小部落的形式分散在荒野中聚居", "source": "丘丘人习俗考察·Book79", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "参与"}, {"cid": 8948, "predicate": "participates-in", "object_text": "部落内各取所需的资源共享", "object_id": null, "quote": "它们似乎会在部落内各取所需地共享资源", "source": "丘丘人习俗考察·Book79", "confidence": "明文", "narrator": null, "review_status": "待仲裁", "predicate_zh": "参与"}, {"cid": 8949, "predicate": "enemy-of", "object_text": "外人（敌意与语言障碍构成研究阻碍）", "object_id": null, "quote": "由于丘丘人对于外人的敌意以及语言的障碍，我们很难确切地研究丘丘人部落内部资源分配情况。", "source": "丘丘人习俗考察·Book79", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "敌对"}, {"cid": 8950, "predicate": "knows-of", "object_text": "元素力（不借「神之眼」而掌握，原理未明）", "object_id": null, "quote": "至于丘丘人为何能够不借助「神之眼」而掌握元素力，这个问题仍需要进一步的考察与研究来解答。", "source": "丘丘人习俗考察·Book79", "confidence": "明文", "narrator": null, "review_status": "待仲裁", "predicate_zh": "知晓"}, {"cid": 8951, "predicate": "worships", "object_text": "抽象的元素力量（而非七神）", "object_id": null, "quote": "丘丘人并不会崇拜现世存在的七神，而是崇拜抽象的元素力量", "source": "丘丘人习俗考察·Book80", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "崇拜"}, {"cid": 8953, "predicate": "participates-in", "object_text": "以生肉为唯一祭礼的祭祀", "object_id": null, "quote": "假如猎物有结余的话，丘丘人也会在祭坛上贡献生肉作为祭礼。", "source": "丘丘人习俗考察·Book80", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "参与"}, {"cid": 8954, "predicate": "is-a", "object_text": "无「过去」「未来」概念、仅生存于「当下」者", "object_id": null, "quote": "丘丘人似乎没有「过去」与「未来」的概念，而是仅仅生存在「当下」。", "source": "丘丘人习俗考察·Book80", "confidence": "明文", "narrator": null, "review_status": "待仲裁", "predicate_zh": "是（类属）"}, {"cid": 8955, "predicate": "located-in", "object_text": "古老遗迹（对遗物有无法解释的亲和力）", "object_id": null, "quote": "一些丘丘人部落会在古老的遗迹中扎营，似乎它们天生对这些古老的遗物有某种无法解释的亲和力。", "source": "丘丘人习俗考察·Book80", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "位于"}, {"cid": 8965, "predicate": "participates-in", "object_text": "决斗前哼唱战歌（其一）", "object_id": null, "quote": "这可能是丘丘人在决斗之前哼唱的战歌", "source": "丘丘人诗歌选·Book15", "confidence": "明文", "narrator": null, "review_status": "待仲裁", "predicate_zh": "参与"}, {"cid": 8966, "predicate": "participates-in", "object_text": "围绕图腾舞蹈时高唱部落赞歌（其二）", "object_id": null, "quote": "丘丘人围绕图腾舞蹈时高唱的歌曲，可能是某种部落赞歌", "source": "丘丘人诗歌选·Book15", "confidence": "明文", "narrator": null, "review_status": "待仲裁", "predicate_zh": "参与"}, {"cid": 8970, "predicate": "worships", "object_text": "神（其六颂神歌仅在祭祀中演唱）", "object_id": null, "quote": "这是一首虔诚的颂神歌，丘丘人只会在祭祀中演唱。", "source": "丘丘人诗歌选·Book16", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "崇拜"}, {"cid": 8971, "predicate": "participates-in", "object_text": "月光下围着篝火交换歌谣的传统（其七为终曲）", "object_id": null, "quote": "似乎许多丘丘人部落都会有在月光下围着篝火交换歌谣的传统。", "source": "丘丘人诗歌选·Book16", "confidence": "明文", "narrator": null, "review_status": "待仲裁", "predicate_zh": "参与"}, {"cid": 8982, "predicate": "participates-in", "object_text": "储存种子的习惯（无专门种植业）", "object_id": null, "quote": "丘丘人其实没有专门的种植业，但是它们有储存种子的习惯，偶尔心情好了就随便找个地埋进去。", "source": "丘丘语速查手册·Book197", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "参与"}, {"cid": 8990, "predicate": "is-a", "object_text": "无绝对方位者（说话全用前后左右）", "object_id": null, "quote": "丘丘人没有绝对方位，因此它们说话全都是前后左右。", "source": "丘丘语速查手册·Book197", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 8991, "predicate": "participates-in", "object_text": "方位回答取决于对对方的态度", "object_id": null, "quote": "但是他们回答你前后左右取决于它们对你的态度，态度好就会从你的视角出发，关系不好的时候方位会基于丘丘人自己。", "source": "丘丘语速查手册·Book197", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "参与"}], "corpus_caveats": []}
{"entity": {"eid": 1706, "ent_code": null, "name": "仙人们", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:49"}, "aliases": [], "claims": [{"cid": 6638, "predicate": "part-of", "object_text": "与岩王帝君的契约（谨遵契约，护佑璃月数千年）", "object_id": null, "quote": "仙人们谨遵与岩王帝君的契约，护佑璃月数千年。", "source": "瑶瑶·角色详细 hash 2514890888", "confidence": "明文", "narrator": null, "review_status": "待仲裁", "predicate_zh": "从属（组织）"}, {"cid": 6639, "predicate": "participates-in", "object_text": "训诫心怀不轨之徒与挽救身陷囹圄之人（太平之世偶尔露面）", "object_id": null, "quote": "璃月一旦有难，仙人们定会现身，若逢太平之世，他们偶尔也会露面。」＋「有时是为了训诫心怀不轨之徒，有时是为了挽救身陷囹圄之人。", "source": "瑶瑶·角色详细 hash 2514890888", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "参与"}, {"cid": 6640, "predicate": "grants", "object_text": "收徒传艺的对象是命中有仙缘的璃月人", "object_id": null, "quote": "要是遇见命中有仙缘的璃月人，仙人们便会收徒传艺。", "source": "瑶瑶·角色详细 hash 2514890888", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "授予"}, {"cid": 6902, "predicate": "imposes", "object_text": "红绳缚魂之法于申鹤（缚凶煞杀气，亦禁锢属人的情绪）", "object_id": null, "quote": "为使申鹤安全长大又不殃及无辜之人，仙人们在申鹤身上施了红绳缚魂之法。」＋「缚住她身上凶煞与杀气的同时，似乎也禁锢了许多本属于人的情绪。", "source": "申鹤·角色故事5 hash 3200509384", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "自定义关系"}], "corpus_caveats": []}
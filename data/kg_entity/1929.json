{"entity": {"eid": 1929, "ent_code": null, "name": "菲米尼的母亲", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:50"}, "aliases": [], "claims": [{"cid": 7903, "predicate": "is-a", "object_text": "每天早出晚归偿还债务的人", "object_id": null, "quote": "但他知道这些数字是母亲每天早出晚归的原因。", "source": "菲米尼·角色故事3·#569", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 7907, "predicate": "is-a", "object_text": "送他去孤儿院并吻他额头道别的人（「要听话。」）", "object_id": null, "quote": "「要听话。」母亲说着，像往常一样，吻了吻菲米尼的额头。", "source": "菲米尼·角色故事4·#570", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 7912, "predicate": "is-a", "object_text": "为保护菲米尼而自己去承受一切的人（非抛弃）", "object_id": null, "quote": "最终，她只剩下了一个选择——将菲米尼托付给「那家孤儿院」，这个放债人无法触及的地方，然后自己去承受一切。", "source": "菲米尼·角色故事5·#571", "confidence": "明文·转述", "narrator": "「父亲」", "review_status": "已复核·通过", "predicate_zh": "是（类属）"}], "corpus_caveats": []}
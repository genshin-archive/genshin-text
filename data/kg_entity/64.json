ote": null, "source": "璃月仙人石龙系（无工之剑·贯虹之槊·和璞鸢）·Weapon13505", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "创造"}], "corpus_caveats": []}
{"entity": {"eid": 2278, "ent_code": null, "name": "奥特巴", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:51"}, "aliases": [], "claims": [{"cid": 9234, "predicate": "is-a", "object_text": "商人与舞女之子（不会数数、学不会教令院课程）", "object_id": null, "quote": "从前，须弥城里住着一个众人皆知的傻子，他名叫奥特巴，是商人和舞女的儿子，不会数数，也学不会教令院的课程", "source": "变成骡子的人·Book1137", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 9235, "predicate": "is-a", "object_text": "被父母与友人称为「打心眼里善良的，这是无上的智慧」者", "object_id": null, "quote": "他是打心眼里善良的，这是无上的智慧。", "source": "变成骡子的人·Book1137", "confidence": "明文·转述", "narrator": "奥特巴父母与友人", "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 9237, "predicate": "participates-in", "object_text": "拉骡子的差事", "object_id": null, "quote": "在朋友的帮助下，奥特巴有了一份拉骡子的差事", "source": "变成骡子的人·Book1137", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "参与"}, {"cid": 9247, "predicate": "narrates", "object_text": "若骗子说的是假话，世上便少一个欺骗母亲的毒蛇", "object_id": null, "quote": "若是他说的是假话，那么这世界上就少了一个连自己母亲都敢于欺骗的毒蛇", "source": "变成骡子的人·Book1137", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 9248, "predicate": "is-a", "object_text": "认出褐色皮肤金瞳男人身份者（文中不明写）", "object_id": null, "quote": "奥特巴眨眨眼，刹那就知晓了这握着绳子的人究竟是谁。", "source": "变成骡子的人·Book1137", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}], "corpus_caveats": []}
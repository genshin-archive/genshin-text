{"entity": {"eid": 3304, "ent_code": null, "name": "与一", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:54"}, "aliases": [], "claims": [{"cid": 11421, "predicate": "is-a", "object_text": "大天狗（鹮巷酒肆主人）", "object_id": null, "quote": "天狗名叫『与一』，住在花见坂一条名叫『鹮巷』的小小侧街。", "source": "鹮巷物语·Book208", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 11422, "predicate": "is-a", "object_text": "酒品极差、毫无生意头脑者", "object_id": null, "quote": "但毫不客气地讲，与一酒品极差，又毫无生意头脑。", "source": "鹮巷物语·Book208", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 11423, "predicate": "survives", "object_text": "因辈分老高、交游广泛而免于被退治", "object_id": null, "quote": "若不是在妖怪中间辈分老高，又在人间交游广泛，与一这家伙恐怕早就被哪位英雄退治在哪座山下了吧。", "source": "鹮巷物语·Book208", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "幸存"}, {"cid": 11425, "predicate": "wields", "object_text": "腰间始终插着的金色纸扇（异界战利品）", "object_id": null, "quote": "唯一可提得上『除外』的，大概是始终插在她腰间的那柄金色纸扇。", "source": "鹮巷物语·Book208", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "持用"}, {"cid": 11427, "predicate": "is-a", "object_text": "异界化身青年弓手、为将军效忠者", "object_id": null, "quote": "在那时，她曾化身一位高傲的青年弓手，为同样趾高气扬的将军效忠。", "source": "鹮巷物语·Book208", "confidence": "明文·转述", "narrator": "与一", "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 11428, "predicate": "steals", "object_text": "敌阵小船上的黄金折扇与持扇美人", "object_id": null, "quote": "与一便早已展开巨翅飞越海峡，掠过那小船时顺手取了那黄金的折扇，与手握折扇惊惶未定的美人。", "source": "鹮巷物语·Book208", "confidence": "明文·转述", "narrator": "与一", "review_status": "已复核·通过", "predicate_zh": "窃取"}, {"cid": 11433, "predicate": "is-a", "object_text": "水战之夜坠海的醉天狗", "object_id": null, "quote": "……脚下一滑，便扑通一声掉进了海里。", "source": "鹮巷物语·Book209", "confidence": "明文·转述", "narrator": "阿千", "review_status": "已复核·通过", "predicate_zh": "是（类属）"}], "corpus_caveats": []}
{"entity": {"eid": 658, "ent_code": null, "name": "蒂莱尔", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:44"}, "aliases": [], "claims": [{"cid": 1603, "predicate": "is-a", "object_text": "叠加态坎瑞亚一侧的少女（自称受奶奶托付离村寻找「救世主」）", "object_id": null, "quote": "那个…一直都还没有自我介绍过，我叫蒂莱尔，谢谢你们刚才救了我，真的非常感谢。", "source": "你存在的时空·talk 801703·蒂莱尔", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 1605, "predicate": "narrates", "object_text": "「救世主」应为一位少女（与旅行者性别不符）", "object_id": null, "quote": null, "source": "你存在的时空·talk 801703·蒂莱尔", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 1606, "predicate": "is-a", "object_text": "只身可见魔物的少女（旅行者须经身体接触才能同见）", "object_id": null, "quote": "附近没有其他敌人了吧？真是神奇，碰了你的手才能看到它们！", "source": "你存在的时空·talk 801709·蒂莱尔", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 1607, "predicate": "narrates", "object_text": "星空真伪之问与奶奶的「相对真实」之答", "object_id": null, "quote": null, "source": "你存在的时空·talk 801706·蒂莱尔", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 1608, "predicate": "narrates", "object_text": "志在「让自己的世界不断变大…直到星空之外」", "object_id": null, "quote": "我要一步一步用自己的双眼和双脚，让自己的世界不断变大…直到星空之外！", "source": "你存在的时空·talk 801706·蒂莱尔", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 1634, "predicate": "is-a", "object_text": "某个身中不死诅咒的纯血坎瑞亚人的后代（戴因斯雷布猜想）", "object_id": null, "quote": "或许是某个身中不死诅咒的纯血坎瑞亚人的后代，在偏远的村庄定居。", "source": "你存在的时空·talk 801803·戴因斯雷布", "confidence": "明文·转述", "narrator": "戴因斯雷布", "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 1649, "predicate": "narrates", "object_text": "即使没有旅行者的保护也仍会去找「救世主」", "object_id": null, "quote": null, "source": "你存在的时空·talk 801810·蒂莱尔", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 1650, "predicate": "narrates", "object_text": "询问坎瑞亚（其国家）后来的命运后自行收回问题", "object_id": null, "quote": null, "source": "你存在的时空·talk 801810·蒂莱尔", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "转述"}], "corpus_caveats": []}
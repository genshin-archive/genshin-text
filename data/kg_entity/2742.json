_text": "康波雷的奸计（由桑哈杰梦中如实相告）", "object_id": null, "quote": "桑哈杰将哥哥的奸计向十字路的主人和盘托出。", "source": "狡诈的康波雷·Book1016", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "知晓"}, {"cid": 10354, "predicate": "grants", "object_text": "桑哈杰（倾在黑曜石杯里的蘑菇酒，作为奖赏）", "object_id": null, "quote": "作为奖赏，她将神秘的蘑菇酒从坩埚中倾倒在黑曜石杯里，递给了桑哈杰。", "source": "狡诈的康波雷·Book1016", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "授予"}, {"cid": 10359, "predicate": "causes", "object_text": "震怒与悲痛（为大罪与桑哈杰之死）", "object_id": null, "quote": "十字路的主人为这等大罪所震怒，也为桑哈杰的死而悲痛。", "source": "狡诈的康波雷·Book1016", "confidence": "明文", "narrator": null, "review_status": "待仲裁", "predicate_zh": "引发"}, {"cid": 10360, "predicate": "imposes", "object_text": "不可洗脱的罪孽与诅咒（于康波雷）", "object_id": null, "quote": "于是当即向狡诈的康波雷降下诅咒", "source": "狡诈的康波雷·Book1016", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "自定义关系"}, {"cid": 18449, "predicate": "aka", "object_text": "在漆黑尽头回望三岔外第四条道路者（三不再为三的开端）", "object_id": null, "quote": "在如此相信的下一个无时的顷刻，便是三不再为三的开端。」「在漆黑的尽头，十字路的主人回望向三岔外的第四条道路，」「在垂滴如蜜的梦色轻纱间，静待与星下侣伴们约定的相见。", "source": "月亮三姐妹神话卷（贯月矢·帷间夜曲）·Weapon14522", "confidence": "明文", "narrator": null, "review_status": "待仲裁", "predicate_zh": "别称"}], "corpus_caveats": []}
{"entity": {"eid": 4432, "ent_code": null, "name": "古恩希尔德氏族", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:57"}, "aliases": [], "claims": [{"cid": 14182, "predicate": "ally-of", "object_text": "新生之神（以其族长之名宣誓忠诚）", "object_id": null, "quote": "以古恩希尔德的族长之名，如是向新生之神宣誓忠诚", "source": "古恩希尔德誓词·Relic15044_4", "confidence": "明文", "narrator": null, "review_status": "待仲裁", "predicate_zh": "同盟"}, {"cid": 14183, "predicate": "part-of", "object_text": "大阿卡狄亚（自称其遗胤）", "object_id": null, "quote": "以大阿卡狄亚的遗胤之名，如是为新生之神加冕千风", "source": "古恩希尔德誓词·Relic15044_4", "confidence": "明文", "narrator": null, "review_status": "待仲裁", "predicate_zh": "从属（组织）"}, {"cid": 14184, "predicate": "active-during", "object_text": "如刀的朔风中的流徙之路", "object_id": null, "quote": "我等曾流徙于如刀的朔风，忍耐裹尸布般苍冷的冤痛", "source": "古恩希尔德誓词·Relic15044_4", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "活跃于"}, {"cid": 14186, "predicate": "wields", "object_text": "永不弯折的脊骨（烈风磋磨而成的花朵）", "object_id": null, "quote": "但我等的脊骨永不会弯折，正如烈风磋磨而成的花朵", "source": "古恩希尔德誓词·Relic15044_4", "confidence": "明文", "narrator": null, "review_status": "待仲裁", "predicate_zh": "持用"}, {"cid": 14187, "predicate": "trusts", "object_text": "以血写就的誓约与友谊（永不背弃）", "object_id": null, "quote": "永不为苦暗之日背弃友谊，永不忘记以血写就的誓约", "source": "古恩希尔德誓词·Relic15044_4", "confidence": "明文", "narrator": null, "review_status": "待仲裁", "predicate_zh": "信任"}, {"cid": 14192, "predicate": "wields", "object_text": "繁花、赤忱与永不枯萎的真诚（捧予风之物）", "object_id": null, "quote": "我等捧予风的，唯有繁花、赤忱，与永不枯萎的真诚", "source": "古恩希尔德誓词·Relic15044_4", "confidence": "明文", "narrator": null, "review_status": "待仲裁", "predicate_zh": "持用"}, {"cid": 14193, "predicate": "participates-in", "object_text": "在高塔之巅与神并肩而战（直面酷烈的风）", "object_id": null, "quote": "我等曾经直面过酷烈的风，在高塔之巅与神并肩而战", "source": "古恩希尔德誓词·Relic15044_4", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "参与"}, {"cid": 14194, "predicate": "witnesses", "object_text": "温柔的风与阴霾后春日的重获新生", "object_id": null, "quote": "我等也曾见证过温柔的风，在阴霾后的春日重获新生", "source": "古恩希尔德誓词·Relic15044_4", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "见证"}, {"cid": 14196, "predicate": "opposes", "object_text": "神座（保留反戈之权，让血沾染明花）", "object_id": null, "quote": "我等必不吝让血沾染明花，即便是要再度与神座反戈", "source": "古恩希尔德誓词·Relic15044_4", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "对抗"}, {"cid": 14198, "predicate": "participates-in", "object_text": "永护蒙德的歌", "object_id": null, "quote": "我等必不吝永护蒙德的歌，如新风曾赐我等庇护之所", "source": "古恩希尔德誓词·Relic15044_4", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "参与"}, {"cid": 14202, "predicate": "prophesies", "object_text": "我等的旧主将如新生之神而行", "object_id": null, "quote": "愿你行如我等的旧主所行，直至我等的旧主如你而行", "source": "古恩希尔德誓词·Relic15044_4", "confidence": "明文", "narrator": null, "review_status": "待仲裁", "predicate_zh": "预言"}, {"cid": 15939, "predicate": "is-a", "object_text": "流徙者（故土葬入银白死寂、遗俗湮落失灭）", "object_id": null, "quote": "故土早已葬入银白的死寂，遗俗亦已湮落失灭的荒城", "source": "蒙德自由史诗群·Relic15044_4", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 15940, "predicate": "free:不效仿", "object_text": "戈德尼、劳伦格、布洛迪里、希托涅四族的奉礼方式（对照语境）", "object_id": null, "quote": "我等不会如戈德尼氏族般，奉出纯金所锻的精巧鸣鸟」「我等不会如劳伦格氏族般，允诺为风献上荣耀的战勋", "source": "蒙德自由史诗群·Relic15044_4", "confidence": "明文", "narrator": null, "review_status": "已修正", "predicate_zh": "自定义关系"}, {"cid": 15941, "predicate": "grants", "object_text": "新生之神（捧予风的唯有繁花、赤忱与永不枯萎的真诚）", "object_id": null, "quote": "我等捧予风的，唯有繁花、赤忱，与永不枯萎的真诚", "source": "蒙德自由史诗群·Relic15044_4", "confidence": "明文", "narrator": null, "review_status": "待仲裁", "predicate_zh": "授予"}, {"cid": 15942, "predicate": "participates-in", "object_text": "高塔之巅与神并肩而战（曾直面酷烈的风）", "object_id": null, "quote": "我等曾经直面过酷烈的风，在高塔之巅与神并肩而战", "source": "蒙德自由史诗群·Relic15044_4", "confide
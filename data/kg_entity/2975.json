{"entity": {"eid": 2975, "ent_code": null, "name": "琉璃心", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:53"}, "aliases": [], "claims": [{"cid": 10790, "predicate": "is-a", "object_text": "高贵仙兽阳寿竭尽时由未竟悲愿凝结之物", "object_id": null, "quote": "真正的琉璃是能展现梦想的美物，只会在高贵的仙兽阳寿竭尽时，由未竟的悲愿凝结而成。", "source": "碎梦奇珍·Book102", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 10791, "predicate": "is-a", "object_text": "可展现数万年岁月流转之物", "object_id": null, "quote": "数万年的岁月在他的眼前一闪而过，星辰、海洋与大地像云霭一般翻腾变换。雪原化为绿地，原野被河流切碎。城市如蚁穴般兴起，王国如积木般崩塌——", "source": "碎梦奇珍·Book102", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}], "corpus_caveats": []}
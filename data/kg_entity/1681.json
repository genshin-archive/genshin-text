{"entity": {"eid": 1681, "ent_code": null, "name": "老冒险家", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:49"}, "aliases": [], "claims": [{"cid": 6465, "predicate": "witnesses", "object_text": "绝境终点等着的竟是一个婴儿（他原以为自己才是第一个涉足这「绝境」的生命）", "object_id": null, "quote": "在地狱一般的旅途最后，等在终点的却是…一个婴儿。", "source": "班尼特·角色故事2 hash 4024899664", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "见证"}, {"cid": 6466, "predicate": "narrates", "object_text": "判定这婴儿是「被世界抛弃的孩子」（他相信那就是真相）", "object_id": null, "quote": "这个婴儿…是被世界抛弃的孩子。", "source": "班尼特·角色故事2 hash 4024899664", "confidence": "明文·转述", "narrator": "老冒险家的自我判断", "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 6467, "predicate": "opposes", "object_text": "世界的意志（明知将婴儿藏在怀中可能与世界的意志相违背，仍将其视为「宝藏」带走）", "object_id": null, "quote": "哪怕他正在做的事，与世界的意志相违背。", "source": "班尼特·角色故事2 hash 4024899664", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "对抗"}, {"cid": 6468, "predicate": "dies-in", "object_text": "伤重离世（未能亲口讲述那段冒险经历，只留下「意志」「冒险」与「终点的宝藏」等字眼）", "object_id": null, "quote": "老人还没来得及亲口讲述那段冒险经历，便伤重离世了，只留下这个从「绝境」中救下的孩子。", "source": "班尼特·角色故事3 hash 1435330752", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "死于"}, {"cid": 9479, "predicate": "narrates", "object_text": "称此山「无法征服的噩梦」，吓退年轻人", "object_id": null, "quote": "「无法征服的噩梦」，他们一个个都这么说。", "source": "山与海之书·Book166", "confidence": "明文·转述", "narrator": "老冒险家", "review_status": "未复核", "predicate_zh": "转述"}], "corpus_caveats": []}
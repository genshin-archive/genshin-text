{"entity": {"eid": 2204, "ent_code": null, "name": "盐之魔神", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:51"}, "aliases": [], "claims": [{"cid": 9118, "predicate": "is-a", "object_text": "柔弱而收拢流民的魔神（魔神战争期间初建地中之盐）", "object_id": null, "quote": "据说它是在魔神战争期间由盐之魔神初建的。", "source": "冒险家罗尔德的日志·Book55", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 9119, "predicate": "dies-in", "object_text": "凡人背叛（第一位凡人之王以长剑弑神）", "object_id": null, "quote": "温柔的魔神并非死于与神的对决，而是死于她所深爱的凡人的背叛。", "source": "冒险家罗尔德的日志·Book55", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "死于"}, {"cid": 9121, "predicate": "sealed-in", "object_text": "地中之盐遗迹深处（遗体化为盐晶，保持被刺穿姿态）", "object_id": null, "quote": "据说盐之魔神的遗体依旧留在这片遗迹深处，虽然早已化为盐晶，却依旧保持着被长剑刺穿那一瞬间的姿态。", "source": "冒险家罗尔德的日志·Book55", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "封存于"}, {"cid": 10612, "predicate": "is-a", "object_text": "并立于璃月的诸神之一", "object_id": null, "quote": "她本是并立于璃月的诸神之一，但由于其过于温柔的本性，她被自己的追随者刺杀，在残酷的魔神战争中过早地退场了。", "source": "璃月风土志·Book76", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 10613, "predicate": "dies-in", "object_text": "追随者的刺杀（魔神战争中）", "object_id": null, "quote": "但由于其过于温柔的本性，她被自己的追随者刺杀，在残酷的魔神战争中过早地退场了。", "source": "璃月风土志·Book76", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "死于"}, {"cid": 10614, "predicate": "located-in", "object_text": "「地中之盐」遗迹（葬身地很可能所在）", "object_id": null, "quote": "她的葬身之地很可能位于如今被璃月人称为『地中之盐』的遗迹之内。", "source": "璃月风土志·Book76", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "位于"}, {"cid": 10615, "predicate": "grants", "object_text": "子民花球（降下祝福）", "object_id": null, "quote": "她曾向自己的子民分发花球，以此降下祝福…或至少残酷乱世中的一点安慰。", "source": "璃月风土志·Book76", "confidence": "明文·转述", "narrator": "作者引「一则如今已面目全非的传说」", "review_status": "未复核", "predicate_zh": "授予"}], "corpus_caveats": []}
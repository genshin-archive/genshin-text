{"entity": {"eid": 1274, "ent_code": null, "name": "刻莱诺", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:47"}, "aliases": [], "claims": [{"cid": 3908, "predicate": "narrates", "object_text": "父母之法实为「推迟预言能力觉醒」", "object_id": null, "quote": "如果将谶鸟送到远离妖精的地方，让她在人类的社会中长大，就可以推迟预言能力的觉醒。", "source": "飞向归羽声·src_2089 L857", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 3909, "predicate": "kin-of", "object_text": "莉奈娅（谶鸟长女，赛前匿名观赛并怀敌意）", "object_id": null, "quote": "刻莱诺是我的姐姐？", "source": "飞向归羽声·src_2089 L387", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "血亲"}, {"cid": 3910, "predicate": "enemy-of", "object_text": "莉奈娅（赛前的莫名敌意与「不知者恒乐」之语）", "object_id": null, "quote": "真是不知者恒乐。早晚…", "source": "飞向归羽声·src_2089 L500", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "敌对"}, {"cid": 3915, "predicate": "prophesies", "object_text": "预言本质是「殊途同归」（路多条而终点唯一）", "object_id": null, "quote": "我们做的那些预言，本质是一种『殊途同归』。路有许多条，但终点就在那里。", "source": "飞向归羽声·src_2089 L913", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "预言"}, {"cid": 3923, "predicate": "participates-in", "object_text": "四强战击败莉奈娅＋露米并晋级决赛", "object_id": null, "quote": "真是精彩的对决！露米落败后，胜负也随之揭晓。晋级决赛的是——刻莱诺和赫姆斯！", "source": "飞向归羽声·src_2089 L447", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "参与"}, {"cid": 3924, "predicate": "is-a", "object_text": "蕴光刃犀赫姆斯的搭档", "object_id": null, "quote": "一边是莉奈娅和她的搭档露米，一边是刻莱诺与她的伙伴赫姆斯！", "source": "飞向归羽声·src_2089 L350", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 3926, "predicate": "narrates", "object_text": "莉奈娅的昏睡所见并非梦而是真实预见", "object_id": null, "quote": "还记得吗？那场比赛的中途，你在昏睡中看到了这一切——当时，你还以为是一场梦呢。", "source": "飞向归羽声·src_2089 L443", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 3927, "predicate": "knows-of", "object_text": "莉奈娅曾「看见你的未来」", "object_id": null, "quote": null, "source": "飞向归羽声·src_2089 L770", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "知晓"}, {"cid": 3935, "predicate": "knows-of", "object_text": "被换来的那个孩子现与亲生父母同住至冬堡", "object_id": null, "quote": "父亲和母亲救了她的命，将她抚养成人。现在她已经和亲生父母团聚，一同生活在至冬堡了。", "source": "飞向归羽声·src_2089 L864", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "知晓"}, {"cid": 3936, "predicate": "narrates", "object_text": "那个孩子出生即患人类难医的怪病（若非换生早已死亡）", "object_id": null, "quote": "出生就罹患人类难以医治的怪病，若非换生，她早就死了。", "source": "飞向归羽声·src_2089 L862", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 3937, "predicate": "distrusts", "object_text": "命运的公正（以「早出生几年」为不公）", "object_id": null, "quote": "仅仅是比你早出生几年…命运何其不公。", "source": "飞向归羽声·src_2089 L881", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "不信任"}, {"cid": 3938, "predicate": "narrates", "object_text": "曾愿妹妹「什么都不知道地活着」", "object_id": null, "quote": "莉奈娅，你还是像以前一样，什么都不知道地活着比较好。", "source": "飞向归羽声·src_2089 L564", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 3950, "predicate": "witnesses", "object_text": "阿瓜拉在决赛击败赫姆斯", "object_id": null, "quote": "没想到这小家伙真的能打赢赫姆斯。了不起。", "source": "飞向归羽声·src_2089 L685", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "见证"}, {"cid": 3961, "predicate": "knows-of", "object_text": "锤子落下瞬间「曾看到的未来变得一片空白」", "object_id": null, "quote": "（锤子落下的那一瞬间，我曾看到的未来变得一片空白…）", "source": "飞向归羽声·src_2089 L817", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "知晓"}, {"cid": 3962, "predicate": "narrates", "object_text": "最终以「仍未逃脱命运的引力」自我说服", "object_id": null, "quote": "不，已经无所谓了。就结果而言，我们仍未逃脱命运的引力。预言依旧应验，如同太阳照常升起。", "source": "飞向归羽声·src_2089 L826", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 3968, "predicate": "ally-of", "object_text": "莉奈娅（姐妹和解：命定胜利／命运之外的答案）", "object_id": null, "quote": "我赢得了命定的胜利，而你找到了命运之外的答案。", "source": "飞向归羽声·src_2089 L871", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "同盟"}, {"cid": 3970, "predicate": "participates-in", "object_text": "释放赫姆斯回归野外（放弃其作为赛兽）", "object_id": null, "quote": "…不会。它有自己该去的地方，我更希望看到它在野外自由地奔跑。", "source": "飞向归羽声·src_2089 L776", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "参与"}, {"cid": 7566, "predicate": "kin-of", "object_text": "莉奈娅（谶鸟姐姐，独自在冻原背负预言）", "object_id": null, "quote": "告知莉奈娅真相的是她的姐姐刻莱诺。", "source": "莉奈娅（博闻异旅）·角色故事5", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "血亲"}, {"cid": 7567, "predicate": "awakens", "object_text": "莉奈娅（告知其身世真相）", "object_id": null, "quote": "面对无忧无虑长大的莉奈娅，心中难免泛起酸涩，认为妹妹终需直面成长的代价。", "source": "莉奈娅（博闻异旅）·角色故事5", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "自定义关系"}], "corpus_caveats": []}
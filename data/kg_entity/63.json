{"entity": {"eid": 63, "ent_code": null, "name": "神之心", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:42"}, "aliases": [{"alias": "钟离与冰之女皇交易中「赐汝应许之物」的标的", "lang": "zh", "confidence": "明文", "evidence": "迫近的客星·quest 1025·钟离"}], "claims": [{"cid": 158, "predicate": "is-a", "object_text": "与天空岛共鸣相连的神灵魔力器官、七神之座的象征", "object_id": null, "quote": null, "source": "巨龙与自由之歌·quest 396·温迪", "confidence": "明文·转述", "narrator": "温迪", "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 941, "predicate": "aka", "object_text": "钟离与冰之女皇交易中「赐汝应许之物」的标的", "object_id": null, "quote": null, "source": "迫近的客星·quest 1025·钟离", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "别称"}, {"cid": 1767, "predicate": "is-a", "object_text": "唯一对第三降临者封印起反应之物（或为见到其封存遗产的钥匙）", "object_id": null, "quote": "唯一对它起反应的是神之心。或许…唯有让第三降临者的遗骨不再零落，才能见到他封存的遗产", "source": "白夜似梦初醒·talk 701511·安娜丝塔夏", "confidence": "明文·转述", "narrator": "安娜丝塔夏", "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 7096, "predicate": "is-a", "object_text": "聚集了大量元素力、能被纳西妲自如使用的核心", "object_id": null, "quote": "神之心——无非是聚集了大量元素力，能被她自如使用的核心。可仅是如此，又怎么会有神明狂热地想要将它们聚集在一起？", "source": "纳西妲·神之心 hash 4037414296", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 8572, "predicate": "narrates", "object_text": "镇压世界不甘的造物；确立七类念想秩序（原初碎片被驱使互相吞并）", "object_id": null, "quote": "世上应当建立起这样的秩序，人因此也只能拥有这七类念想。所有来自原初的碎片被驱使着互相吞并。", "source": "那维莱特·神之眼 hash 1406863808", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 8814, "predicate": "narrates", "object_text": "制度性情报：影的技术不知为何无法对神之心生效（连神明也不明其原理）", "object_id": null, "quote": "本想将它改造成供能装置，可她的技术不知为何无法对神之心生效。", "source": "雷电将军·神之心 hash 2605364584", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 11477, "predicate": "is-a", "object_text": "第三降临者的遗骨", "object_id": null, "quote": "神之心是第三降临者的遗骨", "source": "03_第三降临者·arch_1702", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 11489, "predicate": "causes", "object_text": "封印的唯一反应（须遗骨不再零落方可开启）", "object_id": null, "quote": "唯一对它起反应的是神之心。或许…唯有让第三降临者的遗骨不再零落，才能见到他封存的遗产。", "source": "03_第三降临者·arch_1702", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "引发"}], "corpus_caveats": []}
{"entity": {"eid": 4675, "ent_code": null, "name": "岩藏道启", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:58"}, "aliases": [], "claims": [{"cid": 14727, "predicate": "participates-in", "object_text": "十三年决斗的最终胜者（抓住了天狗少女；「你碰到了我，不得不说确实是你赢了呢」）", "object_id": null, "quote": null, "source": "御舆家与天狗光代·Relic15020_2", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "参与"}, {"cid": 17289, "predicate": "founds", "object_text": "一度门生如云的剑道流派（并凭秘剑「天狗抄」为九条家剑法指南、获「道胤」武号）", "object_id": null, "quote": "获得了「道胤」之武号，并最终创立了一度门生如云的剑道流派。", "source": "明威之镡（五件套）·Relic15020_1", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "创立"}, {"cid": 17290, "predicate": "travels-to", "object_text": "因秘剑「天狗抄」完成而彻底沦为废墟的枝社（赴九条屋敷就任前）", "object_id": null, "quote": "最后一次，踏进因秘剑「天狗抄」的完成而彻底沦为废墟的枝社。", "source": "明威之镡（五件套）·Relic15020_1", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "抵达"}, {"cid": 17291, "predicate": "participates-in", "object_text": "十三年内十次有三与影向天狗的真剑试合", "object_id": null, "quote": "在自己十三年内十次有三与影向的天狗真剑试合的废弃枝社院内，", "source": "明威之镡（五件套）·Relic15020_1", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "参与"}, {"cid": 17299, "predicate": "is-a", "object_text": "由御舆改姓「岩藏」、不再背负鬼之血者", "object_id": null, "quote": "如今的你是『岩藏』，已经不再是背负鬼之血的御舆了。", "source": "明威之镡（五件套）·Relic15020_2", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}], "corpus_caveats": []}
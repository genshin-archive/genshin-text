{"entity": {"eid": 5142, "ent_code": null, "name": "伊·卡科茨·伊齐玛瓦夏", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:54:00"}, "aliases": [], "claims": [{"cid": 15871, "predicate": "is-a", "object_text": "「花烛与风羽的司巫」（CL-08，第八席，唯一明确否决者之一）", "object_id": null, "quote": "倘若无法彻底消灭人类，采取这般极端手段，最终只会适得其反。", "source": "至高领主共识评议·Book1039", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 15872, "predicate": "narrates", "object_text": "极端手段会促使人类结束纷争、同心协力抵御外敌", "object_id": null, "quote": "反而会促使人类结束原本的纷争，同心协力抵御外敌。", "source": "至高领主共识评议·Book1039", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 15874, "predicate": "narrates", "object_text": "自己的一切行为皆获「王」许可", "object_id": null, "quote": "我之所行皆为王之所允，从未逾矩。我无需向弱者做出任何解释。", "source": "至高领主共识评议·Book1039", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}], "corpus_caveats": []}
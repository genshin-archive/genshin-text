1869, "predicate": "aka", "object_text": "卡皮塔诺（本人自陈的称呼；真名以「瑟」开头，未说完）", "object_id": null, "quote": null, "source": "22_卡皮塔诺·talk 502629", "confidence": "明文·转述", "narrator": "卡皮塔诺", "review_status": "已复核·通过", "predicate_zh": "别称"}, {"cid": 11870, "predicate": "participates-in", "object_text": "主持至冬选拔考试并指导有天分的孩童", "object_id": null, "quote": "曾经的至冬，一些有天分的小孩通过选拔考试，可以接受卡皮塔诺先生的指导。", "source": "22_卡皮塔诺·talk 701610", "confidence": "明文·转述", "narrator": "talk 701610", "review_status": "待仲裁", "predicate_zh": "参与"}, {"cid": 11871, "predicate": "participates-in", "object_text": "率愚人众精锐支援纳塔、延缓深渊魔物攻势", "object_id": null, "quote": null, "source": "22_卡皮塔诺·entry 344921", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "参与"}, {"cid": 11872, "predicate": "participates-in", "object_text": "与欧洛伦共同行动，计划「重构地脉」", "object_id": null, "quote": null, "source": "22_卡皮塔诺·entry 234484", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "参与"}, {"cid": 11874, "predicate": "narrates", "object_text": "「我久闻你在各个国家的战绩…你也绝非蛮不讲理之人」", "object_id": null, "quote": "我久闻你在各个国家的战绩，你虽数次与我的同僚交战，但你也绝非蛮不讲理之人", "source": "22_卡皮塔诺·talk 501613", "confidence": "明文·转述", "narrator": "卡皮塔诺", "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 11875, "predicate": "narrates", "object_text": "赴纳塔前留「一封内容详实的信件」予皮耶罗", "object_id": null, "quote": "一封内容详实的信件", "source": "22_卡皮塔诺·talk 701307", "confidence": "明文·转述", "narrator": "桑多涅", "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 11877, "predicate": "narrates", "object_text": "离去前已做好永远离开的准备", "object_id": null, "quote": "我想，在那个时候他就已经做好了永远离开的准备。只是直到纳塔的事件结束，皮耶罗才公开了信件。", "source": "22_卡皮塔诺·talk 701307", "confidence": "明文·转述", "narrator": "桑多涅", "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 11878, "predicate": "narrates", "object_text": "预见其武装部队将被数个执行官觊觎", "object_id": null, "quote": "他知道在他离开后，由他管理的武装部队会受到数个执行官的觊觎", "source": "22_卡皮塔诺·talk 701307", "confidence": "明文·转述", "narrator": "桑多涅", "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 11881, "predicate": "is-a", "object_text": "「刚正不阿」「正直果敢」「战功累累」的「队长」", "object_id": null, "quote": null, "source": "22_卡皮塔诺·Fetters#4736", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 11882, "predicate": "participates-in", "object_text": "将茶会上倒给自己的茶喝完（虽不喜摘下面罩）", "object_id": null, "quote": null, "source": "22_卡皮塔诺·Fetters#8833", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "参与"}, {"cid": 11883, "predicate": "narrates", "object_text": "「「队长」是绝不会告密的，这是统一共识」", "object_id": null, "quote": "「队长」是绝不会告密的，这是统一共识", "source": "22_卡皮塔诺·Relic15047_5", "confidence": "明文·转述", "narrator": "Relic15047_5", "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 11910, "predicate": "narrates", "object_text": "遗信托付：顶梁柱一批旧部划归达达利亚", "object_id": null, "quote": null, "source": "23_达达利亚·talk 701307", "confidence": "明文·转述", "narrator": "桑多涅", "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 13354, "predicate": "grants", "object_text": "达达利亚旧羽毛笔（愚人众最初对外征兵时为军士配给，数百年未褪色）", "object_id": null, "quote": "那是愚人众在最初对外征兵的那些年里，为军士们配给的羽毛笔。历经数百年仍未褪色，显然一直被精心保存。", "source": "木偶桑多涅起源与普契涅拉师承（吉约丹小姐赴至冬）·entry 1230555", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "授予"}, {"cid": 13450, "predicate": "is-a", "object_text": "被判定为阿贾克斯更合适的引导人（「队长」）", "object_id": null, "quote": "再者如果一定要为他选一位引导人，显然『队长』会更加合适。", "source": "桑多涅入仕记（米尔科篇·全文本）·Relic15047_2", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 14747, "predicate": "narrates", "object_text": "透明人自白：「有时他会觉得自己等同于一个移动会谈室，安静地记录着所有的窃窃私语」", "object_id": null, "quote": "「队长」是绝不会告密的，这是统一共识。有时他会觉得自己等同于一个移动会谈室，安静地记录着所有的窃窃私语。", "source": "愚人众侧写群·Relic15047_5", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 14748, "predicate": "narrates", "object_text": "嵌套意象：「他坐在咨询室里，就像一个小房间又套着一个，再套着一个…直到把自己的灵魂挤在正中间」", "object_id": null, "quote": "他坐在咨询室里，就像一个小房间又套着一个，再套着一个…直到把自己的灵魂挤在正中间，上下前后左右都为难。", "source": "愚人众侧写群·Relic15047_5", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 14753, "predicate": "narrates", "object_text": "对「合理」的反驳：「究竟谁的喉咙被咬断，谁的胳膊又进了谁的肚子，这是用「合理」就能解释的问题吗？」", "object_id": null, "quote": "究竟谁的喉咙被咬断，谁的胳膊又进了谁的肚子，这是用「合理」就能解释的问题吗？", "source": "愚人众侧写群·Relic15047_5", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 14755, "predicate": "narrates", "object_text": "结语：「其实，能活下去的人就已经足够坚强了」", "object_id": null, "quote": "不应该这样认为。卡皮塔诺思索着未能说出口的话。」「其实，能活下去的人就已经足够坚强了。", "source": "愚人众侧写群·Relic15047_5", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 17158, "predicate": "is-a", "object_text": "认定「能活下去的人就已经足够坚强」者（此语未能说出口）", "object_id": null, "quote": "其实，能活下去的人就已经足够坚强了。", "source": "感谢你的奉献（愚人众执行官群像五件套）·Relic15047_5", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}], "corpus_caveats": []}
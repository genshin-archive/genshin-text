{"entity": {"eid": 4674, "ent_code": null, "name": "光代", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:58"}, "aliases": [], "claims": [{"cid": 14725, "predicate": "grants", "object_text": "新名「岩藏」（取磐座之意，不受人言所害之物；影向天狗取名有神通力加持）", "object_id": null, "quote": null, "source": "御舆家与天狗光代·Relic15020_4", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "授予"}, {"cid": 14726, "predicate": "entrusts", "object_text": "十三年之约：来年绯樱飘落时决斗，胜则秘剑名「天狗胜」", "object_id": null, "quote": null, "source": "御舆家与天狗光代·Relic15020_4", "confidence": "明文", "narrator": null, "review_status": "待仲裁", "predicate_zh": "自定义关系"}, {"cid": 14728, "predicate": "narrates", "object_text": "诀别辞：身为影向天狗要承当一族不得不为之事", "object_id": null, "quote": "在这十三年里，和你决斗的每一天，我永远也不会忘记。」「但我身为影向天狗，最终还是要承当一族不得不为之事。", "source": "御舆家与天狗光代·Relic15020_2", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 14729, "predicate": "narrates", "object_text": "赐名的真意：希望岩藏摆脱鬼之血的诅咒（非人的血脉随战事越发稀薄）", "object_id": null, "quote": "如今想来最初为你改名，是希望你能摆脱鬼之血的诅咒。」「非人的血脉，随着那一场战事，现在已经越发地稀薄了。", "source": "御舆家与天狗光代·Relic15020_2", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 14730, "predicate": "narrates", "object_text": "最终告别：「为岩藏的血脉，开创仅仅属于岩藏的道路吧」", "object_id": null, "quote": "那么再见了，道启。忘了我，然后以你的剑，」「为岩藏的血脉，开创仅仅属于岩藏的道路吧。", "source": "御舆家与天狗光代·Relic15020_2", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 17295, "predicate": "is-a", "object_text": "承认道启之剑已连天狗速度也能超越者", "object_id": null, "quote": "你的剑，如今连天狗的速度也能超越了。", "source": "明威之镡（五件套）·Relic15020_2", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 17296, "predicate": "knows-of", "object_text": "与道启十三年决斗的每一天（自陈永远也不会忘记）", "object_id": null, "quote": "在这十三年里，和你决斗的每一天，我永远也不会忘记。", "
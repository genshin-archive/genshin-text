{"entity": {"eid": 125, "ent_code": null, "name": "「少女」", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:42"}, "aliases": [], "claims": [{"cid": 308, "predicate": "narrates", "object_text": "其真正的序章丢失在月球上", "object_id": null, "quote": "而我真正的序章丢失在了月球上，那个我无法触及的地方。像一段怎么也摸不到的盲文。", "source": "雪浪与苍林之舞·talk 600115", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 309, "predicate": "narrates", "object_text": "「答应『女皇』的事我已经做完了，这无关背叛」", "object_id": null, "quote": "虽然消耗了我许多力量，但曾经答应『女皇』的事我已经做完了，这无关背叛。", "source": "雪浪与苍林之舞·talk 600115", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 310, "predicate": "knows-of", "object_text": "真实重要的东西不可见（虚假之天谜语）", "object_id": null, "quote": "…不要相信你能看见的东西，真正重要的东西是看不见的。", "source": "雪浪与苍林之舞·quest 6001·「少女」", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "知晓"}], "corpus_caveats": []}
{"entity": {"eid": 1758, "ent_code": null, "name": "麒麟", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:49"}, "aliases": [], "claims": [{"cid": 6867, "predicate": "is-a", "object_text": "仙兽中的仁兽（饮必甘露食必嘉禾，不履生虫不折生草，温柔而优雅的一族）", "object_id": null, "quote": "麒麟是仙兽中的仁兽，饮必甘露，食必嘉禾。", "source": "甘雨·神之眼 hash 978741384", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 10972, "predicate": "is-a", "object_text": "高贵仁慈、不伤活物的仙兽", "object_id": null, "quote": "在璃月山野之间的传说中，麒麟是一种高贵而仁慈的仙兽。", "source": "绝云记闻·Book184", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 10973, "predicate": "is-a", "object_text": "不伤害活物者（不踏伤小虫、不折草叶）", "object_id": null, "quote": "据说麒麟从来不会伤害活物，哪怕只是踏伤一只小虫，折下一缕草叶。", "source": "绝云记闻·Book184", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}], "corpus_caveats": []}
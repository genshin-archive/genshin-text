{"entity": {"eid": 5657, "ent_code": null, "name": "「他」（神造的超越者）", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:54:02"}, "aliases": [], "claims": [{"cid": 17249, "predicate": "is-a", "object_text": "诞生之初即拥有无比美丽面貌、注定拥有长久「年限」与空洞「意志」者", "object_id": null, "quote": "在诞生之初就拥有无比美丽的面貌的「他」，」「注定拥有长久的「年限」与空洞的「意志」。", "source": "无垢之花（五件套）·Relic15018_1", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 17250, "predicate": "is-a", "object_text": "作为神造的超越者却被当成无用之物弃置者", "object_id": null, "quote": "作为神造的超越者，却当成无用之物被弃置。", "source": "无垢之花（五件套）·Relic15018_1", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 17251, "predicate": "resurrects", "object_text": "因未可知的错误从「休眠」中自行苏醒、行走于天地与凡人之间", "object_id": null, "quote": "因为未可知的错误，从「休眠」中自行苏醒，」「开始行走在天地与凡人之间。", "source": "无垢之花（五件套）·Relic15018_1", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "复活"}, {"cid": 17252, "predicate": "is-a", "object_text": "自称连神也惮于干涉其命运、人与神与命运皆无裁决资格者", "object_id": null, "quote": "我是超越一切人的「人」，」「连神也惮于干涉我的命运。", "source": "无垢之花（五件套）·Relic15018_1", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 17253, "predicate": "member-of", "object_text": "以面具示人的人们的「一丘之貉」（因觉同行有趣而自愿加入）", "object_id": null, "quote": "既然与这些以面具示人的人同行似乎很有趣，」「那就成为「一丘之貉」吧。", "source": "无垢之花（五件套）·Relic15018_1", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "成员"}], "corpus_caveats": []}
{"entity": {"eid": 2417, "ent_code": null, "name": "玉匠", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:51"}, "aliases": [], "claims": [{"cid": 9535, "predicate": "is-a", "object_text": "明蕴镇玩世不恭的怪人（以出人意料的成品交付）", "object_id": null, "quote": "在明蕴镇曾有一位玉匠，性格戏谑、玩世不恭。", "source": "帝君尘游记·Book148", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 9536, "predicate": "narrates", "object_text": "「位高权重之人秉权不过百年，其人未必比权座本身来得长寿」", "object_id": null, "quote": "位高权重之人秉权不过百年，其人未必比权座本身来得长寿。", "source": "帝君尘游记·Book148", "confidence": "明文·转述", "narrator": "玉匠", "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 9538, "predicate": "creates", "object_text": "以女人形象为岩王肖像的神牌（蒙眼随心所刻）", "object_id": null, "quote": "一枚美玉雕成的神牌，其上正是女人的形象。", "source": "帝君尘游记·Book148", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "创造"}, {"cid": 9539, "predicate": "narrates", "object_text": "三日雕刻之法（理为骨架、山岩为血肉、随心为灵魂）", "object_id": null, "quote": "第三日，我蒙上双眼，随心所欲地在璞玉上雕刻切削，随心而起，随心而止。这才是灵魂。", "source": "帝君尘游记·Book148", "confidence": "明文·转述", "narrator": "玉匠", "review_status": "未复核", "predicate_zh": "转述"}], "corpus_caveats": []}
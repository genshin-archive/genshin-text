{"entity": {"eid": 860, "ent_code": null, "name": "镇龙石", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:45"}, "aliases": [], "claims": [{"cid": 2459, "predicate": "is-a", "object_text": "元素反应引发的结晶成品（锻造用罕见矿石）", "object_id": null, "quote": "镇龙石是一种罕见的锻造用矿石。常见的水晶多数是在高温环境下自然形成，镇龙石却是元素反应引发的结晶成品。", "source": "匪石·quest 11121", "confidence": "明文·转述", "narrator": "钟离", "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 2460, "predicate": "creates", "object_text": "诞生于千百年前的一场大战（强烈元素力碰撞致结晶）", "object_id": null, "quote": "镇龙石诞生于千百年前的一场大战。强烈的元素力碰撞导致元素结晶，战斗结束后，这些石头奇迹般留存了下来。", "source": "匪石·quest 11121", "confidence": "明文·转述", "narrator": "钟离", "review_status": "未复核", "predicate_zh": "创造"}, {"cid": 2461, "predicate": "is-a", "object_text": "几百年前已被开采殆尽之物", "object_id": null, "quote": "但它毕竟是结晶造物，数量很少，知名度也不高。再者，早在几百年前它就被开采殆尽了。", "source": "匪石·quest 11121", "confidence": "明文·转述", "narrator": "钟离", "review_status": "未复核", "predicate_zh": "是（类属）"}], "corpus_caveats": []}
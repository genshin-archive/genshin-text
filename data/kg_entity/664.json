{"entity": {"eid": 664, "ent_code": null, "name": "苏尔特洛奇", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:44"}, "aliases": [{"alias": "提瓦特为「结出腐败果实的母树」的故乡", "lang": "zh", "confidence": "明文", "evidence": "丝柯克·角色故事5·hash 927936760"}], "claims": [{"cid": 1646, "predicate": "participates-in", "object_text": "因践行骑士精神遭受迫害、肢体变得残缺（与戴因同级）", "object_id": null, "quote": "还有，虽然我不想提及这个名字…但当时同级的苏尔特洛奇，也曾因为对骑士精神的践行而遭受迫害，肢体变得残缺。", "source": "你存在的时空·talk 801806·戴因斯雷布", "confidence": "明文·转述", "narrator": "戴因斯雷布", "review_status": "已复核·通过", "predicate_zh": "参与"}, {"cid": 3774, "predicate": "is-a", "object_text": "「极恶骑」、丝柯克之师", "object_id": null, "quote": "你认识我的师父，『极恶骑』苏尔特洛奇是吗？", "source": "星与夜的低语·quest 15036", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 3775, "predicate": "member-of", "object_text": "坎瑞亚五大罪人之一（罪名涉窃取深渊力量）", "object_id": null, "quote": "坎瑞亚人把他列为五大罪人之一，正是因为他们窃取了支撑万象的深渊力量", "source": "星与夜的低语·quest 15035", "confidence": "明文·转述", "narrator": "丝柯克", "review_status": "已复核·通过", "predicate_zh": "成员"}, {"cid": 3789, "predicate": "kin-of", "object_text": "死囚之子（在牢狱内出生、混迹街头）", "object_id": null, "quote": "他是死囚的孩子，在牢狱内出生", "source": "星与夜的低语·quest 15038", "confidence": "明文·转述", "narrator": "斯克弗努格", "review_status": "待仲裁", "predicate_zh": "血亲"}, {"cid": 3790, "predicate": "creates", "object_text": "以禁忌研究资料治好斯克弗努格的病（十岁所为）", "object_id": null, "quote": "十岁那年，他偷来了禁忌的研究资料，治好了我的病", "source": "星与夜的低语·quest 15038", "confidence": "明文·转述", "narrator": "斯克弗努格", "review_status": "待仲裁", "predicate_zh": "创造"}, {"cid": 3791, "predicate": "narrates", "object_text": "人要为自己挣命、当如火一般烧起来", "object_id": null, "quote": "人要为自己挣命。哪怕挣不到，也应该像一团火一样烧起来，哪能就这样麻木地死去呢？", "source": "星与夜的低语·quest 15038", "confidence": "明文·转述", "narrator": "斯克弗努格转述苏尔特洛奇", "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 3792, "predicate": "participates-in", "object_text": "「事变」（坎瑞亚时代的节点，事后找到斯克弗努格）", "object_id": null, "quote": "『事变』成功后，苏尔特洛奇找到我", "source": "星与夜的低语·quest 15038", "confidence": "明文·转述", "narrator": "斯克弗努格", "review_status": "已复核·通过", "predicate_zh": "参与"}, {"cid": 3793, "predicate": "grants", "object_text": "原始胎海留予斯克弗努格的「礼物」（实为被打倒的吞星之鲸本体）", "object_id": null, "quote": "如果你真的执意变强，原始胎海有我留给你的礼物。还是那句话，想走什么路随你喜欢，恶人有恶人的自由", "source": "星与夜的低语·quest 15038·增量", "confidence": "明文", "narrator": null, "review_status": "已修正", "predicate_zh": "授予"}, {"cid": 3795, "predicate": "prophesies", "object_text": "会将丝柯克辛苦重建的一切化为灰烬（逼其超越自己）", "object_id": null, "quote": "未来某一天，我会将你辛苦重建的一切化为灰烬", "source": "星与夜的低语·quest 15037", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "预言"}, {"cid": 3814, "predicate": "active-during", "object_text": "不在提瓦特、有时通过深渊「传达」声音", "object_id": null, "quote": null, "source": "星与夜的低语·quest 15037", "confidence": "明文·转述", "narrator": "丝柯克", "review_status": "已复核·通过", "predicate_zh": "活跃于"}, {"cid": 3988, "predicate": "is-a", "object_text": "丝柯克的师父（自称「极恶」的男人）", "object_id": null, "quote": "肌腱断裂、骨头折断的四肢被自称「极恶」的男人复原。", "source": "丝柯克·角色故事3·hash 612880632", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 3989, "predicate": "eats", "object_text": "丝柯克的父母（作为变强的资粮）", "object_id": null, "quote": "吃掉了。作为微不足道的营养、作为变强的资粮——吃掉了。", "source": "丝柯克·角色故事2·hash 220119448", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "自定义关系"}, {"cid": 3990, "predicate": "narrates", "object_text": "捏合几万人死前遗念学习丝柯克族的语言", "object_id": null, "quote": "我捏合了几万人的死前遗念，向他们学了半天时间吧。", "source": "丝柯克·角色故事2·hash 220119448", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 3992, "predicate": "free:自定义", "object_text": "—", "object_id": null, "quote": "你相信吗，现在的我可能是整个宇宙的最大的灾劫。", "source": "丝柯克·角色故事4·hash 1772333368", "confidence": "明文", "narrator": null, "review_status": "待仲裁", "predicate_zh": 
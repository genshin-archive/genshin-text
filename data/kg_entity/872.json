{"entity": {"eid": 872, "ent_code": null, "name": "朔次郎", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:45"}, "aliases": [], "claims": [{"cid": 2485, "predicate": "is-a", "object_text": "长野原家旧顾客（偷渡归国被天领奉行通缉者）", "object_id": null, "quote": "他是我们家以前的顾客，前段时间刚刚从外面逃回稻妻，结果在偷渡的时候被发现了，现在正在被天领奉行通缉…", "source": "如梦如电的隽永·quest 12010", "confidence": "明文·转述", "narrator": "宵宫", "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 2486, "predicate": "narrates", "object_text": "离开稻妻是逃避责任（旧日自省）", "object_id": null, "quote": "以前我很不喜欢稻妻，就离开了这里。但现在想想，离开不过只是在逃避责任。", "source": "如梦如电的隽永·quest 12010", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 2487, "predicate": "participates-in", "object_text": "二十年前的长野原烟花定制（其父母为顾客）", "object_id": null, "quote": "嗯，那时候还是我的爸妈找龙之介先生做的烟花，现在想来，也有二十年了吧。", "source": "如梦如电的隽永·quest 12010", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "参与"}, {"cid": 2502, "predicate": "narrates", "object_text": "逃走是不对的、应把外面的东西带回来（归国真因）", "object_id": null, "quote": null, "source": "如梦如电的隽永·quest 12013", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 2510, "predicate": "travels-to", "object_text": "携纸条出海离境（佳祐放行并承诺协助）", "object_id": null, "quote": null, "source": "如梦如电的隽永·quest 12013", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "抵达"}], "corpus_caveats": []}
{"entity": {"eid": 1161, "ent_code": null, "name": "昆图尔", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:46"}, "aliases": [], "claims": [{"cid": 3521, "predicate": "is-a", "object_text": "涂鸦所记英雄（与维奇琳/七彩之战关系待核）", "object_id": null, "quote": null, "source": "传说中的「色彩」·quest 15025", "confidence": "明文·转述", "narrator": "托尔特克", "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 9410, "predicate": "part-of", "object_text": "奎伊露与乌库库（之子）", "object_id": null, "quote": "就连他们的孩子，当时年纪尚幼的昆图尔也受到了波及", "source": "奎伊露和乌库库的故事·Book944", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "从属（组织）"}, {"cid": 9411, "predicate": "is-a", "object_text": "因父受诅而少年无龙友者", "object_id": null, "quote": "并且因此直到他长到少年的岁数，也没能与任何一只龙建立友谊", "source": "奎伊露和乌库库的故事·Book944", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 9781, "predicate": "is-a", "object_text": "不受太阳喜爱者（所到之处太阳退入云层）", "object_id": null, "quote": "凡他们出现的地方，太阳一定会退到厚厚的云层背后，把阳光全收起来。", "source": "昆图尔的故事·Book965", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 9782, "predicate": "is-a", "object_text": "眼睛如星星般明亮者（肖似其母奎伊露）", "object_id": null, "quote": "不过他的眼睛和星星一样明亮，就像他的母亲一样。", "source": "昆图尔的故事·Book965", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 9787, "predicate": "is-a", "object_text": "拒绝款待假扮老者的茹米、唯一通过试探者", "object_id": null, "quote": "从没有人说过我也是善良的人。", "source": "昆图尔的故事·Book965", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 9788, "predicate": "opposes", "object_text": "茹米派出的三只帕帕卡（以拳头开路）", "object_id": null, "quote": "他的父亲就是因为欺瞒和背叛才受了惩罚，所以他恨透了谎话，也总能一眼将谎话识破。", "source": "昆图尔的故事·Book965", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "对抗"}, {"cid": 9789, "predicate": "is-a", "object_text": "凭盲父所授听声辨息穿越迷雾者", "object_id": null, "quote": "就算眼睛看不见，他也能凭着声音和气息找到正确的道路，法术召来的迷雾没能把他困住。", "source": "昆图尔的故事·Book965", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 9790, "predicate": "is-a", "object_text": "松手放暝视龙自由者（不愿如茹米般以强力驯服）", "object_id": null, "quote": "飞吧！去你想去的地方。", "source": "昆图尔的故事·Book965", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 9792, "predicate": "travels-to", "object_text": "所有云层之上（第一次见到太阳的模样）", "object_id": null, "quote": "他们越飞越高，甚至到了所有云层之上，在那里，昆图尔第一次见到了太阳的模样。", "source": "昆图尔的故事·Book965", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "抵达"}], "corpus_caveats": []}
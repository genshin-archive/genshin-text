{"entity": {"eid": 3147, "ent_code": null, "name": "奥克塔维", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:53"}, "aliases": [], "claims": [{"cid": 11075, "predicate": "part-of", "object_text": "大主教（养子，近乎无条件信赖）", "object_id": null, "quote": "因此他近乎无条件地信赖着大主教。", "source": "蒙德高塔·Book27", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "从属（组织）"}, {"cid": 11076, "predicate": "is-a", "object_text": "被迷信父母遗弃、遭市民殴打的弃婴", "object_id": null, "quote": "刚出生时便被迷信的父母遗弃，却被大主教抚养成人。", "source": "蒙德高塔·Book27", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 11077, "predicate": "participates-in", "object_text": "潜入宫廷劫走伊娜丝", "object_id": null, "quote": "大主教便设计让养子奥克塔维潜入宫廷，劫走伊娜丝。", "source": "蒙德高塔·Book27", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "参与"}, {"cid": 11079, "predicate": "witnesses", "object_text": "月光下哭泣的伊娜丝（因而忘却任务）", "object_id": null, "quote": "但看到月光下哭泣的少女，这从未见过的景象在他的心中激起了一阵波动。", "source": "蒙德高塔·Book27", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "见证"}], "corpus_caveats": []}
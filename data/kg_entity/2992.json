{"entity": {"eid": 2992, "ent_code": null, "name": "小祓", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:53"}, "aliases": [], "claims": [{"cid": 10810, "predicate": "is-a", "object_text": "罪天罪国、以物胜之、鸣神五处次第施行的祓式", "object_id": null, "quote": "小祓之期，罪天罪国，结连注为界，念『畏伎』之句。垣瘴晦于界内，藏根瘤以避乡里。复以物胜之。鸣神五处，次第施行。", "source": "神樱大祓要略·Book252", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 10811, "predicate": "is-a", "object_text": "旨在离秽、可保数载太平者", "object_id": null, "quote": "小祓之用意，旨在离秽。依此可得数载太平。", "source": "神樱大祓要略·Book252", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}], "corpus_caveats": []}
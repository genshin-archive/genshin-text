nce": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "持用"}, {"cid": 10323, "predicate": "entrusts", "object_text": "荻特里希以剑柄自卫（等下用这把剑保护好你自己）", "object_id": null, "quote": "听好了，等下用这把剑保护好你自己。", "source": "犬又二分之一·Book194", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "自定义关系"}, {"cid": 10324, "predicate": "imposes", "object_text": "项圈骤然收紧（迫其咬紧牙关、无法呼吸）", "object_id": null, "quote": "荻特里希只感觉到脖子上的项圈紧得快要无法呼吸，无力抵抗只能咬紧了牙关。", "source": "犬又二分之一·Book194", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "自定义关系"}], "corpus_caveats": []}
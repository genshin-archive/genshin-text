{"entity": {"eid": 3129, "ent_code": null, "name": "荒山", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:53"}, "aliases": [], "claims": [{"cid": 11048, "predicate": "is-a", "object_text": "天帝以刀剑削斫而成者", "object_id": null, "quote": "世上早有传说，这「荒山」乃是天帝以刀剑削斫而成，因而绝峭难攀。", "source": "荒山孤剑录·Book154", "confidence": "明文·转述", "narrator": "传说", "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 11049, "predicate": "is-a", "object_text": "浸透地母泪水、苦碱遍地者", "object_id": null, "quote": "也有民话，称荒山因为浸透了地母的泪水，因而苦碱遍地，寸草不生。", "source": "荒山孤剑录·Book154", "confidence": "明文·转述", "narrator": "民话", "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 11050, "predicate": "is-a", "object_text": "曾以金玉矿藏著称、地震毁矿后成贼巢之地", "object_id": null, "quote": "荒山曾以金玉矿藏著称，但在一次地震后，矿井尽毁，工人也尽皆葬身其中。", "source": "荒山孤剑录·Book154", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}], "corpus_caveats": []}
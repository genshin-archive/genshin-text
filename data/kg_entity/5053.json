{"entity": {"eid": 5053, "ent_code": null, "name": "如太阳般的英雄", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:59"}, "aliases": [], "claims": [{"cid": 15638, "predicate": "is-a", "object_text": "黑潮时代崛起、如初阳般耀眼又如晨曦般温暖的王", "object_id": null, "quote": "那时从黑色大地上崛起的，乃是如初阳般耀眼，又如晨曦般温暖的王，", "source": "纳塔夜神之国·Relic15038_3", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 15639, "predicate": "is-a", "object_text": "不曾为任何先知所预言的勇士、不曾被写入任何计划的英雄", "object_id": null, "quote": "那是不曾为任何先知所预言的勇士，那是不曾被写入任何计划的英雄。", "source": "纳塔夜神之国·Relic15038_3", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 15640, "predicate": "participates-in", "object_text": "令各部族战酋订下休战盟约、夜域诸圣献上礼冠", "object_id": null, "quote": "在日轮的辉光下，各部族的战酋订下休战的盟约，夜域的诸圣也放下争执为他献上礼冠。", "source": "纳塔夜神之国·Relic15038_3", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "参与"}], "corpus_caveats": []}
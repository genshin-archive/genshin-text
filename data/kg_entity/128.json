{"entity": {"eid": 128, "ent_code": null, "name": "「木偶」", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:42"}, "aliases": [{"alias": "以「博西柯二号」讥「好同事」", "lang": "zh", "confidence": "明文", "evidence": "回望湮灭的月光·quest 6020·「木偶」"}], "claims": [{"cid": 315, "predicate": "narrates", "object_text": "月髓系「长角的『叛徒』」（薇尔米娜）送来", "object_id": null, "quote": "嗯？你们是说那个长角的『叛徒』送来的东西吗？", "source": "雪浪与苍林之舞·quest 6002·「木偶」", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 350, "predicate": "commands", "object_text": "以「推演」为业的愚人众特别部队", "object_id": null, "quote": "而组建这些部队的执行官…就是现在身处挪德卡莱的…『木偶』。", "source": "归途·quest 6005·卓新", "confidence": "明文·转述", "narrator": "卓新", "review_status": "未复核", "predicate_zh": "统辖"}, {"cid": 408, "predicate": "narrates", "object_text": "「童年会结束，预言会实现，末日会到来，而未来反而再也不来」", "object_id": null, "quote": "只不过童年会结束，预言会实现，末日会到来，而未来反而再也不来。", "source": "回望湮灭的月光·quest 6020·「木偶」", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 414, "predicate": "aka", "object_text": "以「博西柯二号」讥「好同事」（博西柯二号名号首现）", "object_id": null, "quote": "谁在意他？博西柯二号都比他像个正常人。", "source": "回望湮灭的月光·quest 6020·「木偶」", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "别称"}, {"cid": 448, "predicate": "narrates", "object_text": "与多托雷曾短暂研究合作（「两类人」）；其被召回的筹码为「公鸡」资源与「富人」摩拉", "object_id": null, "quote": null, "source": "终北的夜行诗·talk 6026·「木偶」（前句 v1 增量误归阿帽，已修正）", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}], "corpus_caveats": []}
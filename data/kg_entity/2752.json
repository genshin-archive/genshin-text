{"entity": {"eid": 2752, "ent_code": null, "name": "佩洛", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:52"}, "aliases": [], "claims": [{"cid": 10371, "predicate": "is-a", "object_text": "小小的门童（为拜访老爷的先生太太们开门）", "object_id": null, "quote": "他只是个小小的门童，为前来拜访老爷的「先生」、「太太」们开门", "source": "猫咪事务所·Book913", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 10372, "predicate": "wields", "object_text": "金色请柬（花坛中所拾，封皮写着「佩洛先生敬启」）", "object_id": null, "quote": "忽然瞥见花坛里，静静地躺着一封金色的请柬。", "source": "猫咪事务所·Book913", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "持用"}, {"cid": 10375, "predicate": "knows-of", "object_text": "事务所位置与聚散时刻的秘密（破译者为唯一）", "object_id": null, "quote": "这是只有他一个人知道的秘密。", "source": "猫咪事务所·Book913", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "知晓"}, {"cid": 10376, "predicate": "participates-in", "object_text": "以剩饭喂街角流浪猫的日常", "object_id": null, "quote": "佩洛倒是常常用剩饭喂街角的流浪猫。", "source": "猫咪事务所·Book913", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "参与"}, {"cid": 10377, "predicate": "travels-to", "object_text": "猫咪事务所（窖井下的螺旋楼梯深处）", "object_id": null, "quote": "里面传来隐约的灯光和声音，还有向下的螺旋楼梯。", "source": "猫咪事务所·Book914", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "抵达"}, {"cid": 10401, "predicate": "distrusts", "object_text": "猫之计划（惧以偷猫罪名被送上法庭）", "object_id": null, "quote": "偷猫的事情，如果被老爷发现了，我不但工作不保，还会被送上法庭啊…", "source": "猫咪事务所·Book916", "confidence": "明文", "narrator": null, "review_status": "待仲裁", "predicate_zh": "不信任"}, {"cid": 10403, "predicate": "wields", "object_text": "猫的魔法靴子与猫的神奇面具", "object_id": null, "quote": "无可奈何地，佩洛接过了这两样宝贝。", "source": "猫咪事务所·Book916", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "持用"}, {"cid": 10407, "predicate": "influences", "object_text": "求婚信的写法（纠正后三色猫改掉错别字）", "object_id": null, "quote": "在佩洛的纠正下，三色猫特意改掉了错别字的写法。", "source": "猫咪事务所·Book917", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "自定义关系"}, {"cid": 10409, "predicate": "is-a", "object_text": "「冯·弗丽嘉夫人家的车夫」的扮演者", "object_id": null, "quote": "扮演着「冯·弗丽嘉夫人家的车夫」的佩洛，低着头，恭敬地对老爷说着。", "source": "猫咪事务所·Book917", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 10420, "predicate": "free:自定义", "object_text": "黑白猫（自定义关系：魔法道具使人化为猫形，词表无「变形／化兽」项）", "object_id": null, "quote": "靴子和面具都成了佩洛的一部分，或者说，佩洛变成一只猫了！", "source": "猫咪事务所·Book919", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "自定义关系"}, {"cid": 10421, "predicate": "participates-in", "object_text": "驾马车送新婚二猫至港口", "object_id": null, "quote": "佩洛先生，还请您驾驶上那辆马车，把我们送到港口呀！", "source": "猫咪事务所·Book919", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "参与"}, {"cid": 10424, "predicate": "survives", "object_text": "变猫之后的身份危机（翌晨手脚回人形，重新变回门童）", "object_id": null, "quote": "重新穿戴上服装，变回了门童佩洛。", "source": "猫咪事务所·Book920", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "幸存"}, {"cid": 10425, "predicate": "knows-of", "object_text": "魔法的一次性（窖井、靴子与面具此后皆不复存在）", "object_id": null, "quote": "仿佛魔法从来没有发生过，佩洛也从来没有遇见过会说话的猫一样。", "source": "猫咪事务所·Book920", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "知晓"}], "corpus_caveats": []}
{"entity": {"eid": 160, "ent_code": null, "name": "哥伦比娅（时称「少女」）", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:42"}, "aliases": [], "claims": [{"cid": 400, "predicate": "narrates", "object_text": "己力流失源于未被提瓦特接纳、恢复是持续过程", "object_id": null, "quote": null, "source": "回望湮灭的月光·quest 6018·「少女」", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 432, "predicate": "part-of", "object_text": "「哥伦比娅」「库塔尔」二名（皆非真名、未获其认可）", "object_id": null, "quote": "无论是『哥伦比娅』，还是『库塔尔』，都不是她的真名，也没有得到她的认可。", "source": "终北的夜行诗·talk 6026·艾莉丝", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "从属（组织）"}, {"cid": 433, "predicate": "survives", "object_text": "瓦解进行时（月髓杯水车薪、猎月人之战推进瓦解，仅靠祈月前夕高浓度月矩力维持）", "object_id": null, "quote": null, "source": "终北的夜行诗·talk 6026·艾莉丝", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "幸存"}, {"cid": 434, "predicate": "narrates", "object_text": "自己的下落为「消失」而非失踪", "object_id": null, "quote": "她的下落不明，并非失踪，而是『消失』了。", "source": "终北的夜行诗·talk 6026·艾莉丝", "confidence": "明文·转述", "narrator": "艾莉丝", "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 435, "predicate": "narrates", "object_text": "留在提瓦特的结局为「瓦解……不复存在」", "object_id": null, "quote": "留在提瓦特的话，终有一日我将会瓦解——不是变成灰尘，或是花朵的养料，而是不复存在。", "source": "终北的夜行诗·talk 6025·「少女」", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 436, "predicate": "narrates", "object_text": "回月计划为借祈月之夜月矩力高峰（但恐撞上虚假之天）", "object_id": null, "quote": null, "source": "终北的夜行诗·talk 6025·「少女」", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 437, "predicate": "narrates", "object_text": "拒绝霜月之子的引荐（答复「不需要」）", "object_id": null, "quote": null, "source": "终北的夜行诗·talk 6025·「少女」", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 438, "predicate": "narrates", "object_text": "与星球的斥力始终存在（自认不被提瓦特挽留）", "object_id": null, "quote": null, "source": "终北的夜行诗·talk 6025·「少女」", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 447, "predicate": "part-of", "object_text": "女皇治下「声称被需要，实际却不被需要」的第三席（流言称因歌喉获席）", "object_id": null, "quote": null, "source": "终北的夜行诗·talk 6026·「木偶」", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "从属（组织）"}], "corpus_caveats": []}
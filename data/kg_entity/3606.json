{"entity": {"eid": 3606, "ent_code": null, "name": "讯使", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:55"}, "aliases": [], "claims": [{"cid": 12434, "predicate": "is-a", "object_text": "因倒卖灵通消息行骗、事发后失职位并重病的人", "object_id": null, "quote": "我为了积累财富，靠着讯使这一职责所获的灵通消息，欺骗了许多人。", "source": "纳塔杂俎三种·Book932", "confidence": "明文", "narrator": null, "review_status": "待仲裁", "predicate_zh": "是（类属）"}, {"cid": 12435, "predicate": "is-a", "object_text": "自称「卑劣的混蛋、阴沟里的老鼠、不容于部族的渣滓」者", "object_id": null, "quote": "我确实是个卑劣的混蛋，阴沟里的老鼠，不容于部族的渣滓", "source": "纳塔杂俎三种·Book932", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 12436, "predicate": "loves", "object_text": "匿叶龙（仍愿跟随他的伙伴）", "object_id": null, "quote": "那就是仍愿意跟着我的匿叶龙，我的伙伴。", "source": "纳塔杂俎三种·Book932", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "爱"}, {"cid": 12437, "predicate": "entrusts", "object_text": "过路的好人（喂匿叶龙食物使其活下去）", "object_id": null, "quote": "万一有过路的好人被宝箱吸引，喂它点吃的，让它活下去，也就够了。", "source": "纳塔杂俎三种·Book932", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "自定义关系"}, {"cid": 12438, "predicate": "participates-in", "object_text": "偷来空宝箱让匿叶龙看守的安排", "object_id": null, "quote": "这个宝箱是我偷来的，唉，实在没有办法，只好让它守着这个空宝箱。", "source": "纳塔杂俎三种·Book932", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "参与"}, {"cid": 12439, "predicate": "entrusts", "object_text": "开箱者（往宝箱里放东西、不撕纸条不搬宝箱）", "object_id": null, "quote": null, "source": "纳塔杂俎三种·Book932", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "自定义关系"}], "corpus_caveats": []}
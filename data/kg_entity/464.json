{"entity": {"eid": 464, "ent_code": null, "name": "铜雀", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:44"}, "aliases": [{"alias": "死于千年前魔神战争的年轻仙人", "lang": "zh", "confidence": "明文", "evidence": "危途疑踪·quest 1031·魈"}], "claims": [{"cid": 1200, "predicate": "aka", "object_text": "死于千年前魔神战争的年轻仙人（魈取石欲置于纪念铜雀的庙宇）", "object_id": null, "quote": null, "source": "危途疑踪·quest 1031·魈", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "别称"}, {"cid": 2188, "predicate": "is-a", "object_text": "夜叉中的小仙，仙名由岩王帝君所赐，数千年前战死", "object_id": null, "quote": "我本是夜叉中的小仙，岩王帝君赐我仙名「铜雀」，数千年前实力不济，战死沙场。", "source": "槐柯胡蝶，傩佑之梦·talk 1110303", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 2189, "predicate": "narrates", "object_text": "忌日借「浮世留形法」现身、看今日璃月为遗愿", "object_id": null, "quote": "今天是我的忌日，看看今日的璃月是我的遗愿，因而冒昧在此施术。", "source": "槐柯胡蝶，傩佑之梦·talk 1110303", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 2190, "predicate": "narrates", "object_text": "魂魄在庙中滞留极久、悟得仙法一二", "object_id": null, "quote": "我在此庙的时间，绝对远比你们想象得长。", "source": "槐柯胡蝶，傩佑之梦·talk 1110301", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 2191, "predicate": "narrates", "object_text": "视死亡为苟且偷安（相较降魔大圣所承受）", "object_id": null, "quote": "性命虽然珍贵…但比起「降魔大圣」所承受的，死亡不过是一种苟且偷安而已。", "source": "槐柯胡蝶，傩佑之梦·talk 1110303", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 2192, "predicate": "narrates", "object_text": "临终托付问候「降魔大圣」", "object_id": null, "quote": "「浮世留形法」的效力也快散尽了，请二位珍重，替我问候「降魔大圣」…", "source": "槐柯胡蝶，傩佑之梦·talk 1110303", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 2193, "predicate": "narrates", "object_text": "「仙」与「鬼」原本就是一线之隔", "object_id": null, "quote": "哈哈哈…这么说也没错。「仙」与「鬼」原本就是一线之隔。", "source": "槐柯胡蝶，傩佑之梦·talk 1110303", "confidence": "明文", "narrator": "铜雀（借雕像传声）", "review_status": "已修正", "predicate_zh": "转述"}], "corpus_caveats": []}
{"entity": {"eid": 2403, "ent_code": null, "name": "魔物", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:51"}, "aliases": [], "claims": [{"cid": 9501, "predicate": "participates-in", "object_text": "出没于烬寂海（几乎成族群）", "object_id": null, "quote": "今天我见到了更多的魔物，它们几乎是一个族群", "source": "巴窟纳瓦·Book1069", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "参与"}, {"cid": 9502, "predicate": "is-a", "object_text": "与「差点吃掉我们的魔物」同类而体型悬殊", "object_id": null, "quote": "长得和那只差点吃掉我们的魔物类似，但体型有大有小", "source": "巴窟纳瓦·Book1069", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 9503, "predicate": "is-a", "object_text": "最大个体身躯接近一座小山丘", "object_id": null, "quote": "其中最大的个体，身躯接近一座小山丘。", "source": "巴窟纳瓦·Book1069", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 9504, "predicate": "is-a", "object_text": "气息似曾感受于龙脊雪山者", "object_id": null, "quote": "但它们身上散发的气息，我总觉得曾经也感受过…似乎是在龙脊雪山。", "source": "巴窟纳瓦·Book1069", "confidence": "明文·转述", "narrator": "探险者", "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 12107, "predicate": "eats", "object_text": "记录者的左手与后腰（致其重伤）", "object_id": null, "quote": "我的左手和后腰被那只魔物啃掉", "source": "大冒险家斯坦利绝笔·Book1068", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "自定义关系"}, {"cid": 15295, "predicate": "part-of", "object_text": "已殒落的另一位主人（凶烈的咆哮为其最后的哀哭）", "object_id": null, "quote": "它们崇敬的另一位主人已经殒落，凶烈的咆哮便是它们最后的哀哭。", "source": "璃月仙话与契约群——留云借风、层岩夜叉、黑岩绯玉与沉玉谷茶约·Weapon14515·1230978", "confidence": "明文", "narrator": null, "review_status": "待仲裁", "predicate_zh": "从属（组织）"}], "corpus_caveats": []}
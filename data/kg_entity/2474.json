{"entity": {"eid": 2474, "ent_code": null, "name": "黑狐阿达", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:51"}, "aliases": [], "claims": [{"cid": 9692, "predicate": "member-of", "object_text": "六狐之首（女儿身，虎背熊腰）", "object_id": null, "quote": "六狐之首名曰黑狐阿达，虽是女儿身，却生得虎背熊腰，魁伟壮大。", "source": "新六狐传·Book239", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "成员"}, {"cid": 9693, "predicate": "is-a", "object_text": "因正殿醉酒摔坏将军神体被白辰放逐者", "object_id": null, "quote": "因在神社正殿醉酒大闹，摔坏了将军神体，而惹得白辰大怒，将她放逐山下，好生反省。", "source": "新六狐传·Book239", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 9694, "predicate": "member-of", "object_text": "「户隐的双鬼」（收作同伴）", "object_id": null, "quote": "不如你二人陪我行侠仗义，也不至太无聊！", "source": "新六狐传·Book240", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "成员"}, {"cid": 9697, "predicate": "opposes", "object_text": "土左卫门（以摩拉袋砸脸、拳打现出狸妖原形）", "object_id": null, "quote": "打得土左卫门头顶一对狸猫耳朵「噗」地蹦出来，口中止不住地求饶。", "source": "新六狐传·Book242", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "对抗"}, {"cid": 9698, "predicate": "is-a", "object_text": "将恶霸财产分与全村、钱财交予落难母女者", "object_id": null, "quote": "收了狸猫偷来的胁差，将这恶霸的财产分与全村", "source": "新六狐传·Book242", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}], "corpus_caveats": []}
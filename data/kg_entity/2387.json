{"entity": {"eid": 2387, "ent_code": null, "name": "艾克", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:51"}, "aliases": [], "claims": [{"cid": 9453, "predicate": "is-a", "object_text": "自称一千多岁的黑发少年（家通往宇宙任何地方）", "object_id": null, "quote": "我其实今年一千多岁了。这个门通往宇宙任何一个地方。", "source": "少女薇拉的忧郁·Book2", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 9455, "predicate": "narrates", "object_text": "「远方的尺度是随着心变化的」／「我的心则略大于整个宇宙」", "object_id": null, "quote": "远方的尺度是随着心变化的。", "source": "少女薇拉的忧郁·Book2", "confidence": "明文·转述", "narrator": "艾克", "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 9459, "predicate": "is-a", "object_text": "见证过繁星的宇宙贤者（星星不属于任何人）", "object_id": null, "quote": "但是宇宙间那些熠熠生辉的星星，是不属于任何人的。", "source": "少女薇拉的忧郁·Book160", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 9465, "predicate": "narrates", "object_text": "德尔斐是大王都城在本星球的对称点", "object_id": null, "quote": "那也只能说明，这个地方是那位大王的都城在这个星球的对称点吧。", "source": "少女薇拉的忧郁·Book161", "confidence": "明文·转述", "narrator": "艾克", "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 9468, "predicate": "narrates", "object_text": "只有未来拯救过去（修改过去无法拯救没有薇拉的未来）", "object_id": null, "quote": "只有未来拯救过去，修改过去是没办法拯救没有薇拉的未来的。", "source": "少女薇拉的忧郁·Book18", "confidence": "明文·转述", "narrator": "艾克", "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 9470, "predicate": "is-a", "object_text": "「时间的回音」（预定调和法则略强于他）", "object_id": null, "quote": "我只是时间的回音。", "source": "少女薇拉的忧郁·Book19", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 9473, "predicate": "narrates", "object_text": "宇宙将毁灭（需萨奇再冒险，缺他「差了三成」）", "object_id": null, "quote": "你是最厉害的星际战士。大概，差了三成。", "source": "少女薇拉的忧郁·Book1211", "confidence": "明文·转述", "narrator": "艾克", "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 9475, "predicate": "narrates", "object_text": "「我爱你们所有人！」（德尔斐夜空下的宣言）", "object_id": null, "quote": "我爱你们。我爱你们所有人！", "source": "少女薇拉的忧郁·Book1212", "confidence": "明文·转述", "narrator": "艾克", "review_status": "已复核·通过", "predicate_zh": "转述"}], "corpus_caveats": []}
{"entity": {"eid": 5227, "ent_code": null, "name": "失忆技师", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:54:00"}, "aliases": [], "claims": [{"cid": 16104, "predicate": "grants", "object_text": "几本与其他游商交换而来的技术手册（予无名女孩）", "object_id": null, "quote": "我给她留了几本先前与其他游商交换的技术手册", "source": "那夏镇失忆技师手记·Book1085", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "授予"}, {"cid": 16109, "predicate": "knows-of", "object_text": "自己的技术来自至冬堡／新基捷城、被忘掉的身份或可在那里寻回", "object_id": null, "quote": "我的技术来自那里，被我忘掉的身份和过去或许也能在那里找到", "source": "那夏镇失忆技师手记·Book1085", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "知晓"}, {"cid": 16110, "predicate": "is-a", "object_text": "被隐隐不安绊住腿脚、不知在害怕什么者（疑与失去的记忆／遭遇的事故有关）", "object_id": null, "quote": null, "source": "那夏镇失忆技师手记·Book1085", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 16115, "predicate": "grants", "object_text": "分辨齿轮材质、校准压力表、调节安全阀的技艺（予爱诺）", "object_id": null, "quote": "我教她如何分辨齿轮的材质，如何校准压力表、调节安全阀，她比谁都学得快，而且能举一反三。", "source": "那夏镇失忆技师手记·Book1085", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "授予"}, {"cid": 16117, "predicate": "wields", "object_text": "口袋里总会装上的糖果，以备「不时之需」（从达尼奥尔学来）", "object_id": null, "quote": "我的口袋里总是会装上一些糖果，以备「不时之需」。", "source": "那夏镇失忆技师手记·Book1085", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "持用"}], "corpus_caveats": []}
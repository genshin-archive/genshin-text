{"entity": {"eid": 817, "ent_code": null, "name": "假斯坦利", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:45"}, "aliases": [], "claims": [{"cid": 2247, "predicate": "is-a", "object_text": "冒用亡友「大冒险家斯坦利」之名者", "object_id": null, "quote": "只不过，那个和他一起探险的同伴，才是真正的「大冒险家斯坦利」。", "source": "若你困于无风之地·talk 1011303", "confidence": "明文·转述", "narrator": "温迪", "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 2248, "predicate": "narrates", "object_text": "因怕蒙德人忘却亡友而四处讲述其冒险故事", "object_id": null, "quote": "斯坦利…我害怕了这么多年，我怕蒙德城里的人把你忘得一干二净，所以到处说你的冒险故事…", "source": "若你困于无风之地·talk 1011303", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 2249, "predicate": "narrates", "object_text": "亡友死于无风的烬寂海、风带不走其灵魂", "object_id": null, "quote": "我唯一不能忘记的，是他死在了无风的烬寂海，风带不走他的灵魂！", "source": "若你困于无风之地·talk 1011304", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 2250, "predicate": "narrates", "object_text": "已记不清亡友的性格与生活", "object_id": null, "quote": "这些年，我为他的故事而活。但他的性格、他的生活，我都已经记不清了。哈哈哈…", "source": "若你困于无风之地·talk 1011304", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 2251, "predicate": "narrates", "object_text": "自认疲惫没用的骗子、但不愿毁灭杰克的梦想", "object_id": null, "quote": "我是个疲惫没用的骗子，但那孩子还是个闪闪发亮的新人，可不能毁灭了他的梦想啊。", "source": "若你困于无风之地·talk 1011304", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 2252, "predicate": "narrates", "object_text": "布置剑与盾以护杰克", "object_id": null, "quote": "所以斯坦利是为了不伤害杰克的感情，才故意提前一步，到这里布置剑和盾吗？", "source": "若你困于无风之地·talk 1011210", "confidence": "明文·转述", "narrator": "派蒙", "review_status": "已复核·通过", "predicate_zh": "转述"}], "corpus_caveats": []}
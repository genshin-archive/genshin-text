{"entity": {"eid": 812, "ent_code": null, "name": "托克", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:45"}, "aliases": [], "claims": [{"cid": 2216, "predicate": "is-a", "object_text": "达达利亚的幼弟，自至冬国偷渡来璃月寻兄", "object_id": null, "quote": "啊，我是托克！托克是从遥远的至冬国来璃月找哥哥的，可是托克一个人，不知道哥哥在哪里…", "source": "独眼小宝总动员·talk 1101002", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 2217, "predicate": "narrates", "object_text": "称遗迹守卫为「独眼小宝」", "object_id": null, "quote": null, "source": "独眼小宝总动员·talk 1101002", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 2218, "predicate": "narrates", "object_text": "相信哥哥是「最厉害的玩具销售员」", "object_id": null, "quote": "嗯！是我哥哥告诉我的，我哥哥是最厉害的玩具销售员，专门卖这种玩具的！", "source": "独眼小宝总动员·talk 1101002", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 2219, "predicate": "narrates", "object_text": "至冬家中另有冬妮娅、安东", "object_id": null, "quote": "他们都可想你了，冬妮娅姐姐每天晚饭前都在祷告，祈求哥哥的平安…", "source": "独眼小宝总动员·talk 1101003", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 2220, "predicate": "narrates", "object_text": "答「为何而战」：保护冬妮娅姐姐", "object_id": null, "quote": "我想、我想保护冬妮娅姐姐…", "source": "独眼小宝总动员·talk 1101106", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 2221, "predicate": "narrates", "object_text": "愿望为参观「玩具研究所」", "object_id": null, "quote": "我想要参观这里的「玩具研究所」！", "source": "独眼小宝总动员·talk 1101106", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 2222, "predicate": "narrates", "object_text": "自曝早由家书认出旅行者", "object_id": null, "quote": "我哥哥寄回来的家书里，提到了有关你的事情，冬妮娅姐姐读给我听过！", "source": "独眼小宝总动员·talk 1101204", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 2223, "predicate": "narrates", "object_text": "与旅行者立拉勾童谣之约", "object_id": null, "quote": "「拉勾拉勾不许变，变了丢他去冰川。冰川冷，雪原寒，撒谎的舌头全冻烂！」", "source": "独眼小宝总动员·talk 1101002", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 2224, "predicate": "narrates", "object_text": "邀旅行者日后赴至冬旅行", "object_id": null, "quote": "托克会在家等着你们，以后一定~一定~一定也要来至冬旅行哦！", "source": "独眼小宝总动员·talk 1101204", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 8293, "predicate": "is-a", "object_text": "达达利亚家中的弟辈（与冬妮娅一同回信，常提到「公鸡」送去家里的馅饼和礼物）", "object_id": null, "quote": "哦，说到这个，冬妮娅和托克给我回信的时候，时常提到他送去家里的馅饼和礼物。", "source": "达达利亚·语音·关于「公鸡」·hash 1229375647", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}], "corpus_caveats": []}
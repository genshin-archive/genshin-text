t": "愿将永远明亮的记忆归还给热爱的土地", "object_id": null, "quote": null, "source": "白辰狐绝笔书·Weapon14414", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 12377, "predicate": "narrates", "object_text": "愿漆黑意志饶恕其所珍重的生灵", "object_id": null, "quote": "那么就请您饶恕那些生灵吧。", "source": "白辰狐绝笔书·Weapon14414", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 12378, "predicate": "narrates", "object_text": "曾以人的形姿与短寿的生灵同行，成为许多人的挚友", "object_id": null, "quote": null, "source": "白辰狐绝笔书·Weapon14414", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 12381, "predicate": "narrates", "object_text": "祈愿守护挚友的结界不被任何黑暗侵蚀", "object_id": null, "quote": "守护他们的结界，但愿不会被任何黑暗侵蚀…", "source": "白辰狐绝笔书·Weapon14414", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "转述"}], "corpus_caveats": []}
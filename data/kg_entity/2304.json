{"entity": {"eid": 2304, "ent_code": null, "name": "火磷石", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:51"}, "aliases": [], "claims": [{"cid": 9293, "predicate": "is-a", "object_text": "大火山深处源火炼就的晶石（火山大王修库特尔的宝物）", "object_id": null, "quote": "那是大火山深处的源火炼就的晶石，它有着如彩虹般变幻莫测的颜色，无时无刻不散发着耀眼夺目的光芒。", "source": "哈南帕查记事·Book941", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 9728, "predicate": "located-in", "object_text": "天蛇船（冒险家手中火磷石皆出自此处）", "object_id": null, "quote": "不过到处都是火磷石，难道说冒险家们手中的火磷石都是从这里来的吗？但又是谁从这里取走交给他们的呢…", "source": "无名冒险家的笔记·Book955", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "位于"}, {"cid": 9735, "predicate": "is-a", "object_text": "最后一块遗留在大地上者（被笔记作者带入天蛇船）", "object_id": null, "quote": "这是最后一块遗留在大地上的火磷石了，让我把它带到这里也是你的计划吗？不过这样也好，这样就不会再有人受你的欺骗了…", "source": "无名冒险家的笔记·Book955", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}], "corpus_caveats": []}
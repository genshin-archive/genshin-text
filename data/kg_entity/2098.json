{"entity": {"eid": 2098, "ent_code": null, "name": "东山王", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:50"}, "aliases": [{"alias": "「月光与潮汐的遗子」「被月光遗忘的孩子」", "lang": "zh", "confidence": "明文", "evidence": "「东王」史辩·Book310"}, {"alias": "恶王", "lang": "zh", "confidence": "明文", "evidence": "「东王」史辩·Book310"}], "claims": [{"cid": 8900, "predicate": "aka", "object_text": "「月光与潮汐的遗子」「被月光遗忘的孩子」", "object_id": null, "quote": "一些岛歌将他称作「月光与潮汐的遗子」，或「被月光遗忘的孩子」。", "source": "「东王」史辩·Book310", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "别称"}, {"cid": 8901, "predicate": "part-of", "object_text": "海祇大御神（被其收养的孤子）", "object_id": null, "quote": "但海祇大御神还是接纳了这个孩子，就像他曾接纳深困海渊的遗民那般。", "source": "「东王」史辩·Book310", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "从属（组织）"}, {"cid": 8902, "predicate": "is-a", "object_text": "大蛇远吕羽氏册立的第一位藩王（亦最后一位）", "object_id": null, "quote": "他是大蛇远吕羽氏册立的第一位藩王，也是最后一位。", "source": "「东王」史辩·Material 101598", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 8903, "predicate": "knows-of", "object_text": "海祇人的鲸歌与祭仪（师从曚云姐妹）", "object_id": null, "quote": "后来，男孩师从曚云姐妹，学会了海祇人的鲸歌与祭仪", "source": "「东王」史辩·Book310", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "知晓"}, {"cid": 8905, "predicate": "knows-of", "object_text": "「月曚云」与「夕潮」二剑式", "object_id": null, "quote": "据说此次夜游之后，少年参悟了名为「月曚云」与「夕潮」的剑式。", "source": "「东王」史辩·Book310", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "知晓"}, {"cid": 8907, "predicate": "participates-in", "object_text": "海祇大御神东征（先登破竹，攻下「东山」岛）", "object_id": null, "quote": "当海祇大御神踏上无归的东征之途，少年为之先登破竹，率先攻下了当时被海民称为「东山」的岛屿。", "source": "「东王」史辩·Book310", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "参与"}, {"cid": 8909, "predicate": "aka", "object_text": "恶王（八酝岛居民传说中的凶残之名）", "object_id": null, "quote": "但在如今八酝岛居民的传说中，这位勇猛可怖的「东山王」，却有着凶残暴戾的「恶王」之名。", "source": "「东王」史辩·Book310", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "别称"}, {"cid": 8911, "predicate": "dies-in", "object_text": "「无想的一刀」制裁（与其主同殁）", "object_id": null, "quote": null, "source": "「东王」史辩·Book310", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "死于"}, {"cid": 18844, "predicate": "is-a", "object_text": "少年因勇猛受海祇恩宠获封之王号", "object_id": null, "quote": "因其勇猛无畏受到海祇的恩宠，获『东山王』之封号。", "source": "稻妻刀剑外传_大剑卷·Weapon12416", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}], "corpus_caveats": []}
{"entity": {"eid": 3192, "ent_code": null, "name": "鬣兽", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:53"}, "aliases": [], "claims": [{"cid": 11185, "predicate": "is-a", "object_text": "拥有两颗心脏、可化人形与妖精双形态的妖精", "object_id": null, "quote": "它们拥有两颗心脏，可以化身成人类和妖精两种完全不同的形态。", "source": "边乡夜语·Book1198", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 11186, "predicate": "is-a", "object_text": "化形后毛发颜色不变的妖精", "object_id": null, "quote": null, "source": "边乡夜语·Book1198", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 11192, "predicate": "narrates", "object_text": "「感谢你替我刺死了多余的心脏」", "object_id": null, "quote": "感谢你，替我刺死了那颗多余的心脏。如今，我终于是完整的了！", "source": "边乡夜语·Book1198", "confidence": "明文·转述", "narrator": "鬣兽", "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 11193, "predicate": "is-a", "object_text": "至冬国已近乎绝迹的妖精", "object_id": null, "quote": "名为「鬣兽」的妖精如今已经近乎绝迹，不少人已经将他们当成荒诞不经的传说了。", "source": "边乡夜语·Book1198", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}], "corpus_caveats": []}
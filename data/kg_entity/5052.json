{"entity": {"eid": 5052, "ent_code": null, "name": "焚火少女", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:59"}, "aliases": [], "claims": [{"cid": 15634, "predicate": "is-a", "object_text": "以人类躯体承受焚火之力、自称流尽眼泪与血者", "object_id": null, "quote": "你真是不可思议呢。竟然以人类的躯体，承受着这样的力量。", "source": "纳塔夜神之国·Relic15018_4", "confidence": "明文·转述", "narrator": "最初的愚者", "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 15635, "predicate": "exchanges", "object_text": "以「成为实现我等目的的道具」换取熄灭常燃之火", "object_id": null, "quote": "很好。无论要做什么都好，就让我成为实现我等目的的道具吧。", "source": "纳塔夜神之国·Relic15018_4", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "自定义关系"}, {"cid": 15636, "predicate": "enemy-of", "object_text": "短视愚昧的诸神与污秽漆黑的深渊（自称与女皇目的相同：洗净世界的歪曲之源）", "object_id": null, "quote": "洗净这个世界的歪曲之源：短视愚昧的诸神、污秽漆黑的深渊。", "source": "纳塔夜神之国·Relic15018_4", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "敌对"}, {"cid": 15637, "predicate": "narrates", "object_text": "自罪：「即使穿上了白衣，我全身上下早就沾满了不可能洗净的，死骸的油与灰啊」", "object_id": null, "quote": "因为我啊，即使穿上了白衣，我全身上下早就沾满了不可能洗净的，死骸的油与灰啊。", "source": "纳塔夜神之国·Relic15018_4", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "转述"}], "corpus_caveats": []}
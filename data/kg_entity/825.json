{"entity": {"eid": 825, "ent_code": null, "name": "天叔", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:45"}, "aliases": [], "claims": [{"cid": 2326, "predicate": "is-a", "object_text": "「璃月七星」之一「天枢星」", "object_id": null, "quote": "…天叔的身份是「璃月七星」之一，「天枢星」。", "source": "云之海，人之海·talk 1103102", "confidence": "明文·转述", "narrator": "甘雨", "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 2327, "predicate": "narrates", "object_text": "隐姓埋名以垂钓散步为乐", "object_id": null, "quote": "毕竟在这港口钓钓鱼，散散步，是我最大的乐趣。我可不想时刻有那些拿枪的兵士跟着。", "source": "云之海，人之海·talk 1103102", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 2328, "predicate": "narrates", "object_text": "曾受甘雨照顾", "object_id": null, "quote": "当初我刚登上「七星」位置的时候，真是感谢您对我的照顾。", "source": "云之海，人之海·talk 1103102", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 2329, "predicate": "narrates", "object_text": "托甘雨指点女儿慧心", "object_id": null, "quote": "有劳您去月海亭见她一面，稍微指点指点她了。", "source": "云之海，人之海·talk 1103102", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 2670, "predicate": "is-a", "object_text": "现任天枢星（璃月七星之一，曾遭门生投毒）", "object_id": null, "quote": null, "source": "棋生断处·quest 11018", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 2673, "predicate": "knows-of", "object_text": "知易诸般思路与自己相似（期望最深）", "object_id": null, "quote": "难免与我有些相似", "source": "棋生断处·quest 11018", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "知晓"}, {"cid": 2687, "predicate": "narrates", "object_text": "夜兰「脸上常带笑容，眼神却毫无笑意，是个很危险的人」（老友语）", "object_id": null, "quote": "脸上常带笑容，眼神却毫无笑意，是个很危险的人", "source": "棋生断处·quest 11026", "confidence": "明文·转述", "narrator": "天叔", "review_status": "已复核·通过", "predicate_zh": "转述"}], "corpus_caveats": []}
{"entity": {"eid": 675, "ent_code": null, "name": "罗莎琳", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:44"}, "aliases": [], "claims": [{"cid": 1680, "predicate": "participates-in", "object_text": "经阿蕾奇诺支招，在临行前与奥黛塔达成和解", "object_id": null, "quote": "阿蕾奇诺给罗莎琳支了招，罗莎琳在临行前和奥黛塔达成了和解，这才算没有留下永远的遗憾。", "source": "无神怜爱的雪国·talk 701433·「木偶」", "confidence": "明文·转述", "narrator": "「木偶」", "review_status": "已复核·通过", "predicate_zh": "参与"}, {"cid": 4845, "predicate": "is-a", "object_text": "未曾考虑「维持茧的形态」者（哥伦比娅的惋惜）", "object_id": null, "quote": "如果羽化意味着催动翅膀扑向火焰，那么维持茧的形态是否才是留存生命的更好选择？罗莎琳仿佛从没考虑过可以那么选", "source": "哥伦比娅（空月归乡）·语音 196928", "confidence": "明文·转述", "narrator": "哥伦比娅", "review_status": "待仲裁", "predicate_zh": "是（类属）"}, {"cid": 5202, "predicate": "grants", "object_text": "奥黛塔愚人众训练（严苛）", "object_id": null, "quote": "罗莎琳有恩于我，但我也一度憎恨着她。她的要求非常严苛，在她手下训练的那段时间，挨冻、累倒、受伤与生病都是常有的事情。", "source": "奥黛塔（翾风回雪）·语音·关于罗莎琳", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "授予"}, {"cid": 6016, "predicate": "is-a", "object_text": "「直到最后一刻，那簇火焰也依旧是属于她独一无二的颜色」者", "object_id": null, "quote": null, "source": "桑多涅（镜水析谬·第七席「木偶」）·语音 198130", "confidence": "明文·转述", "narrator": "桑多涅", "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 8926, "predicate": "dies-in", "object_text": "（死讯由木偶记下，仅四字）", "object_id": null, "quote": "罗莎琳死了。", "source": "「木偶」的笔记本·Book1154", "confidence": "明文", "narrator": null, "review_status": "待仲裁", "predicate_zh": "死于"}], "corpus_caveats": []}
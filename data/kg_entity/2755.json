{"entity": {"eid": 2755, "ent_code": null, "name": "虎斑猫", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:52"}, "aliases": [], "claims": [{"cid": 10379, "predicate": "leader-of", "object_text": "猫咪事务所（「猫老大」）", "object_id": null, "quote": "猫老大，正是虎斑猫本尊。", "source": "猫咪事务所·Book914", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "领袖"}, {"cid": 10397, "predicate": "free:自定义", "object_text": "长毛猫（自定义关系：猫之婚约，词表无「结婚／婚约」项，仅能以最接近的「爱」表达）", "object_id": null, "quote": "我呢，打算和长毛猫结婚，已经商量好啦！", "source": "猫咪事务所·Book916", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "自定义关系"}, {"cid": 10398, "predicate": "travels-to", "object_text": "遥远国度的神社（婚后迁居之地）", "object_id": null, "quote": "婚后我们会搬去遥远国度的神社。", "source": "猫咪事务所·Book916", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "抵达"}, {"cid": 10402, "predicate": "revokes", "object_text": "偷窃的指控（称猫有魔法，另有办法）", "object_id": null, "quote": "绝对不是让佩洛先生去偷窃。猫是有魔法的动物，我们…有另外的办法呐…", "source": "猫咪事务所·Book916", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "自定义关系"}, {"cid": 10405, "predicate": "entrusts", "object_text": "佩洛（三日后将老爷与长毛猫一同接到事务所）", "object_id": null, "quote": "待到三日后，您按照我们的嘱咐，把老爷和长毛猫一同接到猫咪事务所来，三日后哟！", "source": "猫咪事务所·Book916", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "自定义关系"}, {"cid": 10423, "predicate": "grants", "object_text": "佩洛一躬（难得恭敬地道谢）", "object_id": null, "quote": "多亏了您唷！佩洛先生…", "source": "猫咪事务所·Book919", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "授予"}], "corpus_caveats": []}
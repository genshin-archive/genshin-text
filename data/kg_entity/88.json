{"entity": {"eid": 88, "ent_code": null, "name": "魈", "official_category": "自机角色", "obc_entry_id": "1498", "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:42"}, "aliases": [{"alias": "「逾矩」概念的申明者", "lang": "zh", "confidence": "明文", "evidence": "浮世浮生千岩间·quest 1003·魈"}, {"alias": "五夜叉唯一存世的记忆者", "lang": "zh", "confidence": "明文", "evidence": "危途疑踪·quest 1030·魈"}, {"alias": "从未想象过失去帝君的璃月之地的护法夜叉", "lang": "zh", "confidence": "明文", "evidence": "浮世浮生千岩间·quest 1003·魈"}, {"alias": "在异空间中失联、借空间裂隙归队的仙人", "lang": "zh", "confidence": "明文", "evidence": "危途疑踪·quest 1028/1030"}, {"alias": "天命观的陈述者", "lang": "zh", "confidence": "明文", "evidence": "危途疑踪·quest 1031·魈"}, {"alias": "守仙人约定暂不插手孤云阁危机的暗线观察者", "lang": "zh", "confidence": "明文", "evidence": "风起鹤归·quest 11014·魈"}, {"alias": "无法在璃月久留的「仙人」", "lang": "zh", "confidence": "明文", "evidence": "迫近的客星·quest 1025·魈"}, {"alias": "降魔大圣、护法夜叉", "lang": "zh", "confidence": "明文", "evidence": "浮世浮生千岩间·quest 1002·削月筑阳真君"}], "claims": [{"cid": 208, "predicate": "narrates", "object_text": "「望舒」即「为明月驾高车之神」（月御）", "object_id": null, "quote": "为明月驾高车之神。", "source": "白马闲游记·quest 71162·魈", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 209, "predicate": "narrates", "object_text": "三尸神即恶欲、须弥称同类法门为「断我执」", "object_id": null, "quote": "斩去三尸，便是除去恶欲，修出真我的手段。就我所知，其他国度也有类似的法门，比如须弥就将其称为断我执。", "source": "白马闲游记·quest 71162·魈", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 210, "predicate": "narrates", "object_text": "对帝君过去探询的自我收回", "object_id": null, "quote": "嗯…帝君不提过去，自然有他的深意。白马仙人或许也有相同的顾虑。是我多问了。", "source": "白马闲游记·quest 71162·魈", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 736, "predicate": "trusts", "object_text": "帝君与旅行者", "object_id": null, "quote": "我信任帝君，也信任你。", "source": "在岩间·quest 40223·魈", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "信任"}, {"cid": 863, "predicate": "aka", "object_text": "降魔大圣、护法夜叉（望舒客栈可觅踪迹）", "object_id": null, "quote": "还有一位降魔大圣、护法夜叉。去往「望舒客栈」，或可觅其踪迹。", "source": "浮世浮生千岩间·quest 1002·削月筑阳真君", "confidence": "明文·转述", "narrator": "削月筑阳真君", "review_status": "未复核", "predicate_zh": "别称"}, {"cid": 864, "predicate": "aka", "object_text": "「逾矩」概念的申明者（过分接近仙与魔的世界即为逾矩）", "object_id": null, "quote": null, "source": "浮世浮生千岩间·quest 1003·魈", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "别称"}, {"cid": 865, "predicate": "narrates", "object_text": "小冥寄养客栈的由来（从未害过人的恶灵难超度，拜托老板与掌柜收留）", "object_id": null, "quote": null, "source": "浮世浮生千岩间·quest 1003·魈", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 866, "predicate": "aka", "object_text": "从未想象过失去帝君的璃月之地的护法夜叉", "object_id": null, "quote": "我…无法想象。不论时代如何变易，我都从未想象过失去帝君的璃月之地。", "source": "浮世浮生千岩间·quest 1003·魈", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "别称"}, {"cid": 867, "predicate": "participates-in", "object_text": "主动串联削月、理水、留云三位真君作出决断", "object_id": null, "quote": "我会去找削月、理水、留云三位真君。他们也是时候作出决断了。", "source": "浮世浮生千岩间·quest 1003·魈", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "参与"}, {"cid": 965, "predicate": "aka", "object_text": "无法在璃月久留的「仙人」（「没有办法。因为我毕竟是「仙人」。」）", "object_id": null, "quote": null, "source": "迫近的客星·quest 1025·魈", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "别称"}, {"cid": 1142, "predicate": "aka", "object_text": "守仙人约定暂不插手孤云阁危机的暗线观察者", "object_id": null, "quote": null, "source": "风起鹤归·quest 11014·魈", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "别称"}, {"cid": 1193, "predicate": "aka", "object_text": "五夜叉唯一存世的记忆者（「我是活下来的那个，有义务查清所有人的下落」）", "object_id": null, "quote": null, "source": "危途疑踪·quest 1030·魈", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "别称"}, {"cid": 1194, "predicate": "aka", "object_text": "天命观的陈述者（「天命是夜叉最能感知到的劫难。注定悲戚…但我们无惧」）", "object_id": null, "quote": null, "source": "危途疑踪·quest 1031·魈", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "别称"}, {"cid": 1206, "predicate": "aka", "object_text": "在异空间中失联、借空间裂隙归队的仙人（呼唤其名无回应）", "object_id": null, "quote": null, "source": "危途疑踪·quest 1028/1030", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "别称"}, {"cid": 2171, "predicate": "is-a", "object_text": "最后一位夜叉（「降魔大圣」）", "object_id": null, "quote": "嗯，据说一共有五位「夜叉」，如今仅剩一位存活。", "source": "槐柯胡蝶，傩佑之梦·talk 1110113", "confidence": "明文·转述", "narrator": "派蒙", "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 2172, "predicate": "narrates", "object_text": "正清理沾染「妖邪」的生物", "object_id": null, "quote": "我正在这一带清理沾染了「妖邪」的生物，看来，是妨碍到你们了。", "source": "槐柯胡蝶，傩佑之梦·talk 1110202", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 2173, "predicate": "narrates", "object_text": "业障为代价、是累世杀业的报偿", "object_id": null, "quote": "痛苦是代价，是累世杀业的报偿…我早有觉悟。", "source": "槐柯胡蝶，傩佑之梦·talk 1110202", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 2174, "predicate": "narrates", "object_text": "业障满溢而出、沾染生灵，自当反省", "object_id": null, "quote": "只是不料这些年，「业障」竟会满溢而出，沾染生灵…我自当反省。", "source": "槐柯胡蝶，傩佑之梦·talk 1110202", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 2175, "predicate": "narrates", "object_text": "异变以己为源头", "object_id": null, "quote": "不必，我习惯独来独往，更何况这些异变也是以我为源头…", "source": "槐柯胡蝶，傩佑之梦·talk 1110202", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 2176, "predicate": "narrates", "object_text": "以「靖妖傩舞」断除业障", "object_id": null, "quote": "我会用「靖妖傩舞」之仪，断除此地的「业障」。", "source": "槐柯胡蝶，傩佑之梦·talk 1110204", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 2177, "predicate": "narrates", "object_text": "尊奉帝君最初的意旨", "object_id": null, "quote": "但，不论这个时代有多软弱，都与我无关。我只会尊奉帝君最初的意旨。", "source": "槐柯胡蝶，傩佑之梦·talk 1110206", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 2178, "predicate": "narrates", "object_text": "判定假天君驱魔而不除魔、致妖异聚集", "object_id": null, "quote": "有这种事？哼…蠢材。驱魔而不除魔，怪不得妖异都来此聚集。", "source": "槐柯胡蝶，傩佑之梦·talk 1110206", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 2179, "predicate": "narrates", "object_text": "须回收「百无禁忌箓」", "object_id": null, "quote": "如此下去，恐怕会超出我掌控的范畴…必须从他手中回收「百无禁忌箓」。", "source": "槐柯胡蝶，傩佑之梦·talk 1110206", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 2180, "predicate": "narrates", "object_text": "「梦游诸境法」本为使魂魄离体修行、亦可招来他人魂魄", "object_id": null, "quote": "但也可动用此法，招来他人魂魄。", "source": "槐柯胡蝶，傩佑之梦·talk 1110206", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 2181, "predicate": "narrates", "object_text": "仪式四环节：献香、冥思、施咒、放矢", "object_id": null, "quote": "施术的过程共有四个环节：献香，冥思，施咒，放矢。", "source": "槐柯胡蝶，傩佑之梦·talk 1110305", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 2182, "predicate": "narrates", "object_text": "咒文为「帝婆夜叉，三尸押来」", "object_id": null, "quote": "「施咒」，厉声将咒文念出——「帝婆夜叉，三尸押来」。", "source": "槐柯胡蝶，傩佑之梦·talk 1110305", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 2183, "predicate": "narrates", "object_text": "放矢以夜叉雕像为使役契约", "object_id": null, "quote": "「放矢」，对两尊夜叉雕像各射出一箭，作为使役的契约。", "source": "槐柯胡蝶，傩佑之梦·talk 1110305", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 2184, "predicate": "narrates", "object_text": "仙法为绝云仙人千年所悟、不可轻慢", "object_id": null, "quote": "仙法乃是绝云仙人千年所悟，其中玄奥颇深，切不可轻慢。", "source": "槐柯胡蝶，傩佑之梦·talk 1110305", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 2185, "predicate": "narrates", "object_text": "记得王平安誓言、放其离去", "object_id": null, "quote": "我会记得你的誓言…去吧。", "source": "槐柯胡蝶，傩佑之梦·talk 1110309", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 2186, "predicate": "narrates", "object_text": "在亡友忌日品尝铜雀生前所爱食物", "object_id": null, "quote": null, "source": "槐柯胡蝶，傩佑之梦·talk 1110311", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 2187, "predicate": "narrates", "object_text": "愿铜雀放心安息", "object_id": null, "quote": "果然「铜雀」也放不下璃月吧…但愿璃月今日的光景可以让他放心安息。", "source": "槐柯胡蝶，傩佑之梦·talk 1110305", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 2316, "predicate": "on-orders", "object_text": "为甘雨安排修行（第一环为找回仙人的感觉）", "object_id": null, "quote": "她回绝云间以后，一直想要找回身为仙人的感觉，所以提出要我给她安排仙人的修行…", "source": "云之海，人之海·talk 1103002", "confidence": "明文·转述", "narrator": "留云借风真君", "review_status": "未复核", "predicate_zh": "自定义关系"}, {"cid": 2317, "predicate": "narrates", "object_text": "甘雨非仙非人、漫步尘世边缘必有困惑", "object_id": null, "quote": "你既非仙人，亦非人类，以此身份漫步尘世边缘，难免产生许多困惑。", "source": "云之海，人之海·talk 1103005", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 2318, "predicate": "narrates", "object_text": "修行理念：躯壳与神魂统一、从躯壳寻求突破", "object_id": null, "quote": "躯壳与神魂是统一的，神魂如果遇上困境，从躯壳寻求突破也是一种选择。", "source": "云之海，人之海·talk 1103005", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 2319, "predicate": "narrates", "object_text": "他人评价无益于修炼本身", "object_id": null, "quote": "无需向我报告，你所想要的他人评价，无益于修炼本身。", "source": "云之海，人之海·talk 1103006", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 2866, "predicate": "participates-in", "object_text": "指点轻策庄下魔神残躯", "object_id": null, "quote": "昔年此地曾有恶螭作乱", "source": "「医心」·quest 11028", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "参与"}, {"cid": 2867, "predicate": "narrates", "object_text": "「长生不死，或许没有你们想象的那么美好」", "object_id": null, "quote": "长生不死，或许没有你们想象的那么美好", "source": "「医心」·quest 11028", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 3062, "predicate": "witnesses", "object_text": "留云化形出手（三十多年前）", "object_id": null, "quote": "三十多年前，我曾见她化作人形出手", "source": "千里月明·quest 11034", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "见证"}, {"cid": 3063, "predicate": "witnesses", "object_text": "魔神战争时期留云的沉默与善战", "object_id": null, "quote": "那时她沉默寡言，只有驱使符箓时才会开口说话", "source": "千里月明·quest 11034", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "见证"}, {"cid": 3064, "predicate": "narrates", "object_text": "感应非人之物气息而现身", "object_id": null, "quote": "方才感应到了非人之物的气息，便过来看看", "source": "千里月明·quest 11034", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 4672, "predicate": "is-a", "object_text": "传闻中的少年仙人（刻晴认为人治之世可卸重担）", "object_id": null, "quote": "传闻中的少年仙人，现如今在这人治之世，也应该放下身上的重担了吧。人类已经不需要这样的守护了。", "source": "刻晴（霆霓快雨）·语音 185180", "confidence": "明文·转述", "narrator": "刻晴", "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 8850, "predicate": "is-a", "object_text": "护法夜叉（美号「降魔大圣」；真实年纪超过两千岁）", "object_id": null, "quote": "外表虽是少年人，魈的真实年纪却已超过两千岁。", "source": "魈·角色详细 hash 2787333788", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 8851, "predicate": "participates-in", "object_text": "与魔神残渣的战斗（「靖妖傩舞」）", "object_id": null, "quote": "「靖妖傩舞」——知晓真相的璃月掌权者们，将魈所经历的万千日夜归纳为这四个字。」＋「这些战斗没有胜利者，也没有尽头。", "source": "魈·角色故事1 hash 2455340032", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "参与"}, {"cid": 8853, "predicate": "part-of", "object_text": "曾为魔神座下大魔（被抓住弱点拘为座下，做下大量残忍血腥之事）", "object_id": null, "quote": "曾经的魈年少无知，被魔神抓住弱点拘为座下大魔，听凭指示做下大量残忍血腥之事。", "source": "魈·角色故事2 hash 2370840600", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "从属（组织）"}, {"cid": 8854, "predicate": "narrates", "object_text": "曾被要求吞下败者的美梦", "object_id": null, "quote": "他造了诸多杀业，踩碎诸多理想，还被要求吞下败者的美梦，痛苦万分却又身不由己。", "source": "魈·角色故事2 hash 2370840600", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 8857, "predicate": "entrusts", "object_text": "守护璃月的千年苦役（为报答岩之神的恩情）", "object_id": null, "quote": "为报答岩之神的恩情，魈接下了守护璃月的千年苦役。", "source": "魈·角色故事3 hash 4156107016", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "自定义关系"}, {"cid": 8861, "predicate": "narrates", "object_text": "「他一直都在和自己战斗」", "object_id": null, "quote": "岁月茫茫，唯有自己陪伴着自己。」＋「他一直都在和自己战斗。", "source": "魈·角色故事4 hash 1232681376", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 8862, "predicate": "narrates", "object_text": "魔神之怨发作时被一股笛声所救（笛声掠过碧水重山被风送至此地）", "object_id": null, "quote": "并非魈自己压制住了邪念，而是一股笛声救了他。」＋「清丽的笛声，掠过碧水重山，被风送至此地。", "source": "魈·角色故事5 hash 3579903360", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 8863, "predicate": "narrates", "object_text": "对吹笛人的推断：「上一位有能力帮助他的，是君临尘世的七神之一。那么这一位，恐怕也是——」", "object_id": null, "quote": "上一位有能力帮助他的，是君临尘世的七神之一。那么这一位，恐怕也是——", "source": "魈·角色故事5 hash 3579903360", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 8867, "predicate": "narrates", "object_text": "获眼与世人被垂青是否同理的存疑：「那么仙人获眼与世人被天空岛垂青，究竟是否遵循着同种道理？」", "object_id": null, "quote": "那么仙人获眼与世人被天空岛垂青，究竟是否遵循着同种道理？", "source": "魈·神之眼 hash 3851335112", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 8869, "predicate": "narrates", "object_text": "尤为厌恶海灯节（受命于海灯节当晚彻夜厮杀；该夜魔神怨憎爆发最巨）", "object_id": null, "quote": "璃月各地遭摩拉克斯镇压的魔神，在半梦半醒之间，偶尔会爆发出规模异常的怨憎与残渣。其中，以海灯节之夜的爆发最为巨大。」＋「因此，他尤为厌恶海灯节。", "source": "魈·神之眼 hash 3851335112", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 8870, "predicate": "possesses", "object_text": "神之眼·风（三眼之一；已记不清得眼时刻）", "object_id": null, "quote": "魈已记不清得到神之眼的时刻了。」＋「「三眼五显仙人」——「魈」，听召前来守护。", "source": "魈·神之眼 hash 3851335112＋语音「初次见面…」 h=3885047927", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "持有权能"}, {"cid": 8871, "predicate": "narrates", "object_text": "护法之誓：七难之中呼我名即来守护", "object_id": null, "quote": "如遇失道旷野之难，路遭贼人之难，水火刀兵之难，鬼神药毒之难，恶兽毒虫之难，冤家恶人之难，便呼我名。", "source": "魈·语音「初次见面…」 h=3885047927", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 8872, "predicate": "narrates", "object_text": "对摩拉克斯的绝对维护：「胆敢对他不敬的话。即使是你，我也不会原谅」", "object_id": null, "quote": null, "source": "魈·语音「想要了解魈·其四」 h=3987003527", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 8873, "predicate": "narrates", "object_text": "业障之声：「这是我自己的选择和自己的报应。与你无关」", "object_id": null, "quote": null, "source": "魈·语音「想要了解魈·其三」 h=234311119", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 8874, "predicate": "narrates", "object_text": "（关于北斗）击败冥海巨兽「海山」（作为人类实力值得肯定）", "object_id": null, "quote": "不过，冥海巨兽确有其事。能够将「海山」击败，作为人类，她的实力值得肯定。", "source": "魈·语音「关于北斗…」 h=3183964391", "confidence": "明文", "narrator": "魈", "review_status": "已修正", "predicate_zh": "转述"}, {"cid": 8875, "predicate": "narrates", "object_text": "（关于甘雨）游走于仙人两界、靠职责支撑自我（魈自知难开导瑞兽）", "object_id": null, "quote": "甘雨既非仙兽，又非凡人，游走于仙人两界，靠着职责支撑自我，困惑是免不了的。", "source": "魈·语音「关于甘雨…」 h=4207687983", "confidence": "明文", "narrator": "魈", "review_status": "已修正", "predicate_zh": "转述"}, {"cid": 8876, "predicate": "narrates", "object_text": "温迪曲调的欲言又止：「他演奏的曲调…不，没什么」", "object_id": null, "quote": "温迪…？原来如此，名字叫作温迪啊。他演奏的曲调…不，没什么。", "source": "魈·语音「关于温迪…」 h=3711886599", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}], "corpus_caveats": []}
{"entity": {"eid": 3224, "ent_code": null, "name": "小狼", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:53"}, "aliases": [], "claims": [{"cid": 11245, "predicate": "is-a", "object_text": "北方冰原唯一的居民", "object_id": null, "quote": "但那里只有一匹小狼，是唯一的居民。", "source": "野猪公主·Book22", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 11246, "predicate": "is-a", "object_text": "蓝眼灰毛、曾无忧无虑的孩子", "object_id": null, "quote": "小狼从前也是一个无忧无虑的孩子，生着明亮的蓝色眼睛，全身灰色皮毛光洁漂亮；", "source": "野猪公主·Book23", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 11248, "predicate": "eats", "object_text": "松鼠魔巫乌巴瓜（误吞致诅咒生效）", "object_id": null, "quote": "可喉咙一紧又一松，只听咕嘟一声，便把乌巴瓜咽下了肚子。", "source": "野猪公主·Book23", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "自定义关系"}, {"cid": 11249, "predicate": "is-a", "object_text": "被冰凌冻结心脏、失去所有朋友的孤狼", "object_id": null, "quote": "松鼠的诅咒中，极冷的冰凌刺入小狼的心脏，将它冻结起来。", "source": "野猪公主·Book24", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 11254, "predicate": "is-a", "object_text": "重获分享与友情之乐者", "object_id": null, "quote": "就这样，小狼第一次了解了分享与友情的乐趣，心中的冰晶渐渐融化，化作欣喜的泪水流了出来。", "source": "野猪公主·Book26", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}], "corpus_caveats": []}
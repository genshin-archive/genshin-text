{"entity": {"eid": 3210, "ent_code": null, "name": "「她」（女神）", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:53"}, "aliases": [], "claims": [{"cid": 11223, "predicate": "is-a", "object_text": "造物者（赐净善、安宁与智识）", "object_id": null, "quote": "那些由她所赐的净善、安宁与智识、在纯粹的恶意前尽数倾殒。", "source": "遐叶论经·Book430", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 11225, "predicate": "participates-in", "object_text": "与灵使踏上最后的远征", "object_id": null, "quote": "与那些追随她的灵使一并，踏上了最后的远征。", "source": "遐叶论经·Book430", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "参与"}, {"cid": 11226, "predicate": "destroys", "object_text": "万千魔军（吹响歌梨尼）", "object_id": null, "quote": "吹响无瑕的歌梨尼，顷刻间，万千魔军便化作尘埃，消散殆尽，再无他处可寻。", "source": "遐叶论经·Book431", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "自定义关系"}, {"cid": 11228, "predicate": "is-a", "object_text": "不朽的伽乌迦那／尘世本身（化身）", "object_id": null, "quote": "她独自一人步入已成空洞的凡世之心，轻触它永恒的面容。于是，她便化作了不朽的伽乌迦那，也化作了尘世本身。", "source": "遐叶论经·Book431", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 11231, "predicate": "narrates", "object_text": "「猎手总能找到归途」（最初与最终的许诺）", "object_id": null, "quote": "无论经过多少苦厄，猎手总能找到归途", "source": "遐叶论经·Book432", "confidence": "明文·转述", "narrator": "经文", "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 11232, "predicate": "is-a", "object_text": "意志遍及一切、不可毁灭", "object_id": null, "quote": "她的意志遍及一切，正如智识一般不可毁灭。", "source": "遐叶论经·Book432", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}], "corpus_caveats": []}
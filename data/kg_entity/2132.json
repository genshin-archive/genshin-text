{"entity": {"eid": 2132, "ent_code": null, "name": "老人", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:50"}, "aliases": [], "claims": [{"cid": 8992, "predicate": "is-a", "object_text": "兄妹的授业者（十五年前收留门前的孤儿）", "object_id": null, "quote": "他履行了承诺，将这辈子所学教给了这对十五年前倒在自己门前的孤儿。", "source": "两个铳枪手·Book658", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 8993, "predicate": "grants", "object_text": "兄妹剑术、枪术、骗术与暗杀之术", "object_id": null, "quote": "如何潜入一处宅邸而不被猎狗发现、如何让人在睡梦中死去而不留痕迹，以及，如何在扣下扳机时没有丝毫犹豫…", "source": "两个铳枪手·Book658", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "授予"}, {"cid": 8994, "predicate": "is-a", "object_text": "失明者（自认「神明对复仇者降下的惩罚」）", "object_id": null, "quote": "这双眼睛，就是神明对复仇者降下的惩罚。", "source": "两个铳枪手·Book658", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}], "corpus_caveats": []}
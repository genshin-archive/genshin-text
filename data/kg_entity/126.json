{"entity": {"eid": 126, "ent_code": null, "name": "荧", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:42"}, "aliases": [{"alias": "坎瑞亚公主", "lang": "zh", "confidence": "明文", "evidence": "你存在的时空·talk 801803·戴因斯雷布"}], "claims": [{"cid": 313, "predicate": "possesses", "object_text": "深渊力量（借以瓦解月矩力封印）", "object_id": null, "quote": "#（{M#荧}{F#哥哥}使用的是深渊的力量，并非月矩力，但封印却被解除了…）", "source": "雪浪与苍林之舞·quest 6001·旅行者（内心）", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "持有权能"}, {"cid": 1615, "predicate": "participates-in", "object_text": "率深渊教团佯攻纳塔、借机进入夜神之国与夜神沟通谈判", "object_id": null, "quote": "于是我带领深渊教团佯攻纳塔，借机进入了夜神之国与夜神进行沟通和谈判。", "source": "你存在的时空·talk 801818·荧", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "参与"}, {"cid": 1621, "predicate": "narrates", "object_text": "时空叠加致旅行者与蒂莱尔得以相见", "object_id": null, "quote": "当然，也是因为这种时空叠加的情况，才致使你与蒂莱尔有了见面的机会。", "source": "你存在的时空·talk 801818·荧", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 1623, "predicate": "narrates", "object_text": "五百年前初到坎瑞亚时记忆一片空白，其后才逐渐想起一切（含旅行者）", "object_id": null, "quote": "五百年前，刚刚来到坎瑞亚的时候…我的记忆一片空白。", "source": "你存在的时空·talk 801818·荧", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 1624, "predicate": "aka", "object_text": "坎瑞亚公主（获封后于王庭生活很久，即旅行者的血亲）", "object_id": null, "quote": null, "source": "你存在的时空·talk 801803·戴因斯雷布", "confidence": "明文·转述", "narrator": "戴因斯雷布", "review_status": "未复核", "predicate_zh": "别称"}, {"cid": 1627, "predicate": "narrates", "object_text": "为取得与天理对等对话的资格而需要「一整个世界」与之对抗", "object_id": null, "quote": "为了得到与天理对等进行对话的资格，我需要「一整个世界」与之对抗。", "source": "你存在的时空·talk 801818·荧", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 1628, "predicate": "participates-in", "object_text": "灾变初起时携旅行者逃离（二人回忆的交汇点）", "object_id": null, "quote": "尽管我当时一头雾水，但我没有时间思考，立刻带着你逃离…我们的回忆就在此处交汇。", "source": "你存在的时空·talk 801818·荧", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "参与"}, {"cid": 1629, "predicate": "knows-of", "object_text": "提瓦特地脉被天理「固定」，而纳塔夜神之国是例外", "object_id": null, "quote": null, "source": "你存在的时空·talk 801818·荧", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "知晓"}, {"cid": 1630, "predicate": "possesses", "object_text": "「新世界的经纬图」（新坎瑞亚地脉已由其织成）", "object_id": null, "quote": null, "source": "你存在的时空·talk 801818·荧", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "持有权能"}, {"cid": 1631, "predicate": "narrates", "object_text": "「总有一天…我会找到能够承载它的空间」", "object_id": null, "quote": "总有一天…我会找到能够承载它的空间。", "source": "你存在的时空·talk 801818·荧", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 1633, "predicate": "narrates", "object_text": "「居然会是五百年后的我所做的事促成了这一切」", "object_id": null, "quote": "居然会是五百年后的我所做的事促成了这一切…是在讽刺我吗，伊斯塔露。", "source": "你存在的时空·talk 801818·荧", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 1653, "predicate": "narrates", "object_text": "蒂莱尔找到荧并带来旅行者正在寻她的消息", "object_id": null, "quote": null, "source": "你存在的时空·talk 801818·荧", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 1654, "predicate": "narrates", "object_text": "蒂莱尔请求荧「拯救世界」", "object_id": null, "quote": "讽刺的是，她迫切地请求我「拯救世界」，但同时也带来了关于你的消息。", "source": "你存在的时空·talk 801818·荧", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}], "corpus_caveats": []}
ote": "好不容易抓到这样的好机会，可以解决掉不在状态的骑士团长，没想到中途蹦出两个碍事的人。", "source": "骑士团长的一日假期·库内条目 hash 56096798", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "从属（组织）"}, {"cid": 2014, "predicate": "participates-in", "object_text": "以紧急订单设局针对琴", "object_id": null, "quote": "那些紧急订单…是你们下的啊…", "source": "骑士团长的一日假期·库内条目 hash 283709590", "confidence": "明文·转述", "narrator": "琴", "review_status": "未复核", "predicate_zh": "参与"}, {"cid": 2111, "predicate": "narrates", "object_text": "从人类传言收集战力情报", "object_id": null, "quote": "我们可是在人类的传言里，收集到了详细的战力情报。", "source": "真正的宝物·talk 1020104", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 2112, "predicate": "steals", "object_text": "可莉埋在低语森林的「宝物」", "object_id": null, "quote": "现在宝物在我手上，你们再着急也没用了。", "source": "真正的宝物·talk 1020104", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "窃取"}, {"cid": 2113, "predicate": "narrates", "object_text": "若小女孩独自在场则计划可成", "object_id": null, "quote": "呼…呼…如果你们不在，只有那小女孩一个人的话…", "source": "真正的宝物·talk 1020107", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 8785, "predicate": "participates-in", "object_text": "雷雨天偷袭掳走雷泽、击倒前来营救的狼群", "object_id": null, "quote": "那个雷雨天，一个深渊法师从背后偷袭并带走了雷泽。前来营救他的狼群朝深渊法师发起了无畏的攻击，然而，却被法术尽数击倒在地。", "source": "雷泽·神之眼 hash 4199778552", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "参与"}, {"cid": 9033, "predicate": "participates-in", "object_text": "与行商作者寻求认同的交涉（据作者断言）", "object_id": null, "quote": "即使是以固执和麻烦著称的深渊法师，在我抛出这句话时都会愿意重新思考并与我寻求认同。", "source": "交涉的艺术·Book664", "confidence": "明文·转述", "narrator": "行商作者", "review_status": "未复核", "predicate_zh": "参与"}], "corpus_caveats": []}
{"entity": {"eid": 2148, "ent_code": null, "name": "行商作者", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:50"}, "aliases": [], "claims": [{"cid": 9022, "predicate": "narrates", "object_text": "「机会是创造出来的」", "object_id": null, "quote": "我认为机会是创造出来的。", "source": "交涉的艺术·Book664", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 9023, "predicate": "is-a", "object_text": "白手起家的行商（起点不高、无本钱）", "object_id": null, "quote": "我起点不高，也没有本钱。", "source": "交涉的艺术·Book664", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 9025, "predicate": "participates-in", "object_text": "以音量制造底气的交涉（先声夺人）", "object_id": null, "quote": "讲话的声音要响亮，给人一种底气十足的感觉。", "source": "交涉的艺术·Book664", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "参与"}, {"cid": 9026, "predicate": "narrates", "object_text": "「交涉最有力的武器是事实。而事实是可以人为操作的。」", "object_id": null, "quote": "交涉最有力的武器是事实。而事实是可以人为操作的。", "source": "交涉的艺术·Book664", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 9027, "predicate": "is-a", "object_text": "在璃月推销蒙德商品的行商", "object_id": null, "quote": "我曾想在璃月推销来自蒙德的商品。", "source": "交涉的艺术·Book664", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 9030, "predicate": "narrates", "object_text": "「我贩卖的不是货物，而是一种生活方式」", "object_id": null, "quote": "我贩卖的不是货物，而是一种生活方式，一种名为快乐的生活方式。", "source": "交涉的艺术·Book664", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 9031, "predicate": "participates-in", "object_text": "以摩拉为饵的问卷调研（话题引导）", "object_id": null, "quote": "这是一次问卷，在问卷中我宣传参与问卷的人将有机会获得摩拉。一听到有摩拉，人们就趋之若鹜。", "source": "交涉的艺术·Book664", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "参与"}, {"cid": 9032, "predicate": "narrates", "object_text": "「我同意你的观点，但…」为万能公式", "object_id": null, "quote": "我同意你的观点，但…」我把这句话称为是万能公式。", "source": "交涉的艺术·Book664", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 9035, "predicate": "narrates", "object_text": "劝读者「不要按照我的说法去做」", "object_id": null, "quote": "以此我期望你们不要按照我的说法去做，否则，我将面对一个对我而言更为寸步难行的世界。", "source": "交涉的艺术·Book664", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "转述"}], "corpus_caveats": []}
te_zh": "别称"}, {"cid": 756, "predicate": "aka", "object_text": "琅玕的社稷神（教导农耕、保佑五谷的神女）", "object_id": null, "quote": null, "source": "在人间·quest 40224·兹蹻", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "别称"}, {"cid": 4560, "predicate": "is-a", "object_text": "如今璃月港新添的一位仙人（喜爱云游、不常居住）", "object_id": null, "quote": "没想到，如今的璃月港里竟然又添了一位新仙人。", "source": "凝光（掩月天权）·语音·关于白马仙人 183298", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 8640, "predicate": "narrates", "object_text": "帝君许久未见的一位故人（「春夜短，秋日速，隙过驹，风过烛」）", "object_id": null, "quote": "白马，白马…这位仙人，其实也是我许久未见的一位故人。只可叹，春夜短，秋日速，隙过驹，风过烛。", "source": "钟离·语音「关于白马仙人…」 h=2905152943", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}], "corpus_caveats": []}
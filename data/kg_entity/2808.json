{"entity": {"eid": 2808, "ent_code": null, "name": "贤龙", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:52"}, "aliases": [], "claims": [{"cid": 10492, "predicate": "is-a", "object_text": "高踞王座上的长者", "object_id": null, "quote": "玛阿威与伙伴一同来到了高踞王座上的贤龙面前。", "source": "玛阿威与幻写灵·Book939", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 10493, "predicate": "knows-of", "object_text": "玛阿威其来（并因年轻同族到访而惊奇）", "object_id": null, "quote": "温和的贤龙这样询问玛阿威，它的心中无比惊奇。", "source": "玛阿威与幻写灵·Book939", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "知晓"}, {"cid": 10497, "predicate": "is-a", "object_text": "亦无怒火可给者（其所求为己所不能得）", "object_id": null, "quote": "你来到我的面前，却想要索取我也无法得到的东西。", "source": "玛阿威与幻写灵·Book939", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 10498, "predicate": "revokes", "object_text": "破例满足的许诺（闭门不答）", "object_id": null, "quote": "贤龙关上了它的黑曜石大门，不再回答玛阿威的话。", "source": "玛阿威与幻写灵·Book939", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "自定义关系"}, {"cid": 10499, "predicate": "wields", "object_text": "黑曜石大门", "object_id": null, "quote": "于是，贤龙的黑曜石大门为玛阿威关闭了。", "source": "玛阿威与幻写灵·Book940", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "持用"}], "corpus_caveats": []}
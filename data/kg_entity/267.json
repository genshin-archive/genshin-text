{"entity": {"eid": 267, "ent_code": null, "name": "嘉明", "official_category": "自机角色", "obc_entry_id": "500672", "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:43"}, "aliases": [{"alias": "「有几分眼熟」者", "lang": "zh", "confidence": "明文", "evidence": "在岩间·quest 40223·侯章"}], "claims": [{"cid": 740, "predicate": "survives", "object_text": "附身解除（脱力；不记得附身期间所为）", "object_id": null, "quote": null, "source": "在岩间·quest 40223·嘉明", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "幸存"}, {"cid": 742, "predicate": "aka", "object_text": "「有几分眼熟」者（侯章观感；附身转移之因）", "object_id": null, "quote": null, "source": "在岩间·quest 40223·侯章", "confidence": "明文·转述", "narrator": "侯章", "review_status": "未复核", "predicate_zh": "别称"}, {"cid": 4848, "predicate": "member-of", "object_text": "剑匣镖局（镖师）兼和记厅", "object_id": null, "quote": "老板你好呀，我是和记厅的镖师，叫我嘉明就行", "source": "嘉明（骏猊頕首）·语音 192590", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "成员"}, {"cid": 4849, "predicate": "founds", "object_text": "「威水舞兽队」（自任话事人）", "object_id": null, "quote": "如果是找我舞兽的话即刻可以出发！「威水舞兽队」我就是话事人", "source": "嘉明（骏猊頕首）·语音 192590", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "创立"}, {"cid": 4850, "predicate": "possesses", "object_text": "火元素「神之眼」（劫镖战后由商人发现并连同牌匾送还）", "object_id": null, "quote": null, "source": "嘉明（骏猊頕首）·神之眼 #637", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "持有权能"}, {"cid": 4851, "predicate": "part-of", "object_text": "翘英庄叶家（茶农世家，父亲叶德转做茶叶买卖）", "object_id": null, "quote": "嘉明生在以茶闻名的翘英庄，祖上几代都是茶农，轮到父亲叶德这辈开始，便转为做茶叶买卖为主。", "source": "嘉明（骏猊頕首）·角色故事1 #631", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "从属（组织）"}, {"cid": 4852, "predicate": "participates-in", "object_text": "离家出走后以舞兽戏创业失败、入剑匣镖局", "object_id": null, "quote": "功夫不负有心人，经过嘉明的勤奋打拼，没过多久就把从离家前就开始攒的那点梦想创业基金全部花光了。", "source": "嘉明（骏猊頕首）·角色故事1 #631", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "参与"}, {"cid": 4853, "predicate": "witnesses", "object_text": "幼年舞兽戏与猊兽对视的一瞬（人生转折）", "object_id": null, "quote": "仅此一瞬，嘉明立即停住了哭闹，全程瞪大双眼张大嘴巴盯着台上的舞兽戏看，散场回家途中还一路回望舞台的方向。", "source": "嘉明（骏猊頕首）·角色故事4 #634", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "见证"}, {"cid": 4861, "predicate": "participates-in", "object_text": "劫镖一战（以一敌十、货物无损、千岩军接应）", "object_id": null, "quote": "嘉明就这样以一敌十，最后虽然自己都七损八伤，但还是坚持将强盗们绑起来，撑到千岩军和镖局兄弟赶来接应才放心倒下。", "source": "嘉明（骏猊頕首）·神之眼 #637", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "参与"}, {"cid": 4862, "predicate": "wields", "object_text": "母亲家书「给嘉明仔」（枕下夹于母亲垫茶杯的书中）", "object_id": null, "quote": "嘉明不爱看书，但他的枕头下却常年放着一本书，里面夹着老妈写给他的唯一一封信。", "source": "嘉明（骏猊頕首）·「给嘉明仔」#636", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "持用"}, {"cid": 4864, "predicate": "narrates", "object_text": "「不管以前还是现在，没消息就是最好的消息」（父子关系的现状）", "object_id": null, "quote": "不管以前还是现在，没消息就是最好的消息。", "source": "嘉明（骏猊頕首）·角色故事5 #635", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 4865, "predicate": "narrates", "object_text": "「多得玉衡星大人」（刻晴整治运输路段致盗贼收敛）", "object_id": null, "quote": "多得玉衡星大人，她带头整治完遗珑埠跟璃月港之间的运输路段之后，盗贼都不敢那么猖獗了。", "source": "嘉明（骏猊頕首）·语音 192636", "confidence": "明文·转述", "narrator": "嘉明", "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 4866, "predicate": "trusts", "object_text": "旅行者（约以「得闲饮茶」、生日祝寿舞兽）", "object_id": null, "quote": null, "source": "嘉明（骏猊頕首）·语音 192622/192678", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "信任"}, {"cid": 4867, "predicate": "narrates", "object_text": "「生块叉烧好过生你」——母亲骂语与吃叉烧的思念", "object_id": null, "quote": "我老妈都会气得骂一句「生块叉烧好过生你」，现在每次吃叉烧，还挺想老妈的…", "source": "嘉明（骏猊頕首）·语音 192668", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}, {"cid": 4868, "predicate": "narrates", "object_t
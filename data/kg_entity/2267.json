{"entity": {"eid": 2267, "ent_code": null, "name": "佣兵（留言者）", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:51"}, "aliases": [], "claims": [{"cid": 9206, "predicate": "part-of", "object_text": "某佣兵组织（后脱离，习惯单打独斗）", "object_id": null, "quote": "我本是一名普通的佣兵，脱离了组织，习惯单打独斗。", "source": "千奇澴回的见证物·Book588", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "从属（组织）"}, {"cid": 9207, "predicate": "enemy-of", "object_text": "贼匪（以复仇为从业动机）", "object_id": null, "quote": "我会从事这门刀尖舔血的职业，动机非常单纯：向贼匪们复仇。", "source": "千奇澴回的见证物·Book588", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "敌对"}, {"cid": 9208, "predicate": "survives", "object_text": "（未死——被伊迪娅搭救）", "object_id": null, "quote": "如果不是伊迪娅小姐搭救我，恐怕沙漠之中早已多出一具枯骨…", "source": "千奇澴回的见证物·Book588", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "幸存"}, {"cid": 9214, "predicate": "narrates", "object_text": "「盖子不行，不如试试看底吧…」", "object_id": null, "quote": "「盖子不行，不如试试看底吧…」伊迪娅小姐在无法打开罐头时说的话令我醒悟。", "source": "千奇澴回的见证物·Book588", "confidence": "明文·转述", "narrator": "伊迪娅", "review_status": "已复核·通过", "predicate_zh": "转述"}, {"cid": 9215, "predicate": "knows-of", "object_text": "贼匪亦为受害者（暴力再生产循环）", "object_id": null, "quote": "我所做的一切真的有意义吗，为什么明明为贼匪所害的人，也会成为贼匪？", "source": "千奇澴回的见证物·Book588", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "知晓"}, {"cid": 9216, "predicate": "founds", "object_text": "（决意从事「与战斗有别的另一种战斗」——从源头防人沦为贼匪）", "object_id": null, "quote": "我想，那是与战斗有别的另一种战斗，那种战斗更不直接，更困难，更需要头脑，但是我相信会有更多的人从中受益。", "source": "千奇澴回的见证物·Book588", "confidence": "明文", "narrator": null, "review_status": "待仲裁", "predicate_zh": "创立"}], "corpus_caveats": []}
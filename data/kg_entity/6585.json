{"entity": {"eid": 6585, "ent_code": null, "name": "异国的学者", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:54:05"}, "aliases": [], "claims": [{"cid": 19287, "predicate": "creates", "object_text": "钢轮弓（在复合弓底子上增加滑轮的改造者）", "object_id": null, "quote": "这张弓经过了异国学者的改造，在复合弓的底子上增加了滑轮。", "source": "铁蜂刺与钢轮弓·Weapon15407", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "创造"}, {"cid": 19288, "predicate": "is-a", "object_text": "无心兵者武道、不愿见血光横飞之人", "object_id": null, "quote": "学者原本无心于兵者武道，不愿见血光横飞。", "source": "铁蜂刺与钢轮弓·Weapon15407", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 19289, "predicate": "is-a", "object_text": "为兵器着迷而逃避现实的增强者（明知作品终将用于战争杀戮）", "object_id": null, "quote": "他为这种『兵器』着迷，驱使着他将复合弓加以改造，使其更加有力。」「即使他早就已经明白这点：自己的作品终将用于战争，终将用以杀戮，」「但学者沉浸在构造的优化与良材的质感中，」「逃避着这个现实，无止境地增强着这柄弓。", "source": "铁蜂刺与钢轮弓·Weapon15407", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 19292, "predicate": "witnesses", "object_text": "禽鸟垂死嘶鸣击碎其心（造物落入战事的现场）", "object_id": null, "quote": "但禽鸟垂死时的嘶鸣，也如利箭一般击碎了他的心。", "source": "铁蜂刺与钢轮弓·Weapon15407", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "见证"}], "corpus_caveats": []}
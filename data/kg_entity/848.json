{"entity": {"eid": 848, "ent_code": null, "name": "劳伦斯家族", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:45"}, "aliases": [], "claims": [{"cid": 2416, "predicate": "is-a", "object_text": "当年为蒙德带来苦难的旧贵族（温妮莎革命的对象）", "object_id": null, "quote": "而当年为蒙德带来苦难的旧贵族，就是劳伦斯家族了。", "source": "浪花不再归海·quest 10120", "confidence": "明文·转述", "narrator": "琴", "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 2430, "predicate": "wields", "object_text": "「挚友」固定搭配（只用于关系不远不近的朋友）", "object_id": null, "quote": "「挚友」这个词在劳伦斯家，只能用在关系不远不近的朋友身上，这是固定搭配。", "source": "浪花不再归海·quest 10121", "confidence": "明文·转述", "narrator": "优菈", "review_status": "已复核·通过", "predicate_zh": "持用"}, {"cid": 2431, "predicate": "wields", "object_text": "家训「产生争执时，应将捍卫家族的威名与尊严放在首位」", "object_id": null, "quote": "产生争执时，应将捍卫家族的威名与尊严放在首位。", "source": "浪花不再归海·quest 10121", "confidence": "明文·转述", "narrator": "优菈", "review_status": "已复核·通过", "predicate_zh": "持用"}, {"cid": 4149, "predicate": "is-a", "object_text": "旧蒙德愚昧与暴政的象征", "object_id": null, "quote": "劳伦斯家族象征着旧蒙德的愚昧与暴政，等同于人们心底永恒的痛苦。", "source": "优菈（浪沫的旋舞）·角色详细 #264", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}, {"cid": 9260, "predicate": "is-a", "object_text": "作恶多端的贵族家族（与古恩希尔德对照）", "object_id": null, "quote": "但与作恶多端的劳伦斯家族不同", "source": "古恩希尔德小传·Book83", "confidence": "明文", "narrator": null, "review_status": "已复核·通过", "predicate_zh": "是（类属）"}], "corpus_caveats": []}
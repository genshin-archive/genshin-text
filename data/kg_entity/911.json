{"entity": {"eid": 911, "ent_code": null, "name": "鬼婆婆", "official_category": "无官方分类", "obc_entry_id": null, "type": null, "status": "active", "merged_into": null, "review_status": "机验通过", "created_at": "2026-10-03 00:53:45"}, "aliases": [], "claims": [{"cid": 2614, "predicate": "is-a", "object_text": "因收养一斗得名的照护者（两族余脉收容）", "object_id": null, "quote": "青鬼一族的事情，就交给我吧", "source": "赤金魂·quest 12026", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "是（类属）"}, {"cid": 2615, "predicate": "loves", "object_text": "一斗（称其为「我的『骄傲』」）", "object_id": null, "quote": "因为一斗啊，可是我的『骄傲』呢", "source": "赤金魂·quest 12026·增量", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "爱"}, {"cid": 7505, "predicate": "witnesses", "object_text": "荒泷派（从未成立，只是「一斗和他的朋友们」）", "object_id": null, "quote": "这群孩子，只不过是一斗和他的朋友们罢了。", "source": "荒泷一斗（花坂豪快）·角色故事2", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "见证"}, {"cid": 7531, "predicate": "free:自定义", "object_text": "荒泷一斗（因收养他而被称为鬼婆婆）", "object_id": null, "quote": "她可是世界上对我最好的人类，只是因为收养了我才会被叫鬼婆婆的。", "source": "荒泷一斗（花坂豪快）·语音·荒泷一斗的烦恼", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "自定义关系"}, {"cid": 7532, "predicate": "narrates", "object_text": "「我熬了米粥，你饿了吧」", "object_id": null, "quote": "我熬了米粥，你饿了吧。", "source": "荒泷一斗（花坂豪快）·角色故事5", "confidence": "明文", "narrator": null, "review_status": "未复核", "predicate_zh": "转述"}], "corpus_caveats": []}